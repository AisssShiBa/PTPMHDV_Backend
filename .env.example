# ==============================================================================
# FINVAULT E-WALLET - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Dự án: Ví điện tử FinVault - Kiến trúc Microservices Zero-Trust
# Phụ trách: Đạt (Lead Security & Docker Infrastructure)
# Phân phối cho: Hữu (User/Merchant), Khoa (Wallet/Payment), Nguyên (Notification), Đạt (Gateway/Auth/Admin)
# ==============================================================================
# HƯỚNG DẪN:
# 1. Sao chép file này thành .env: `cp .env.example .env` (hoặc `copy .env.example .env`)
# 2. Thay đổi các bí mật bảo mật trước khi triển khai môi trường Staging/Production.
# 3. Môi trường Production bắt buộc sử dụng cơ chế Docker Secrets đọc qua file (_FILE).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CƠ SỞ DỮ LIỆU POSTGRESQL (INFRASTRUCTURE & SERVICE DATABASES)
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Đường dẫn secret file khi chạy Docker Secrets (Production)
POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password

# Tên các database dịch vụ độc lập (Database-per-service pattern)
AUTH_DB_NAME=auth_service
USER_DB_NAME=user_service
MERCHANT_DB_NAME=merchant_service
WALLET_DB_NAME=wallet_service
PAYMENT_DB_NAME=payment_service
NOTIFICATION_DB_NAME=notification_service
ADMIN_DB_NAME=admin_service

# ------------------------------------------------------------------------------
# 2. MESSAGE BROKER RABBITMQ (EVENT-DRIVEN ARCHITECTURE)
# ------------------------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=admin
RABBITMQ_PASS=admin

# Đường dẫn secret file cho RabbitMQ (Production)
RABBITMQ_DEFAULT_PASS_FILE=/run/secrets/rabbitmq_pass

# Chuỗi kết nối AMQP chuẩn cho các Microservice
RABBITMQ_URL=amqp://admin:admin@rabbitmq:5672

# ------------------------------------------------------------------------------
# 3. BẢO MẬT ZERO-TRUST, TOKEN & KHÓA MẬT MÃ (SECURITY & AUTHENTICATION)
# ------------------------------------------------------------------------------
# Khóa đối xứng ký Access Token cho người dùng cuối (HMAC-SHA256, tối thiểu 32 bytes)
ACCESS_TOKEN_SECRET=b7761dba2e068daf4f88c80a5d76f3ba1ee53e492a3fa1ade3d09ddbc2d30a69e86de163a65a3573aed370c9d5141827

# Khóa bí mật giao tiếp nội bộ giữa các service (Internal Header x-internal-key)
INTERNAL_KEY=f6f2f278e1bddbc7d16c19851cc828ce455015504709b35d232383543d6c1e68

# Cặp khóa bất đối xứng ES256 (NIST P-256 ECDSA) dùng cho Gateway Token nội bộ
# - Gateway nắm Private Key để KÝ x-gateway-token (TTL 60s)
# - Các dịch vụ nội bộ (Wallet, Payment...) chỉ nắm Public Key để XÁC MINH (Chống giả mạo)
GATEWAY_PRIVATE_KEY_FILE=./secrets/gateway_private.pem
GATEWAY_PUBLIC_KEY_FILE=./secrets/gateway_public.pem

# ------------------------------------------------------------------------------
# 4. TÍCH HỢP CỔNG THANH TOÁN VNPAY SANDBOX (PAYMENT INTEGRATION)
# ------------------------------------------------------------------------------
VNP_TMN_CODE=9OJY037K
VNP_HASH_SECRET=AIWWJEDQTSPYEMVZYUXJKMOZDNWFTGRQ
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:3000/api/payments/topups/vnpay/return
VNP_IPN_URL=http://localhost:3000/api/payments/topups/vnpay/ipn

# Đường dẫn secret file cho VNPAY Hash Secret (Production)
VNP_HASH_SECRET_FILE=/run/secrets/vnp_hash_secret

# ------------------------------------------------------------------------------
# 5. MẠNG, CORS & CỔNG KẾT NỐI DỊCH VỤ (NETWORKING & PORTS)
# ------------------------------------------------------------------------------
# Cổng API Gateway công khai duy nhất tiếp nhận request từ Client
GATEWAY_PORT=3000

# Địa chỉ Frontend Web Client cho phép CORS
CLIENT_URL=http://localhost:5173

# Cổng nội bộ các Microservices (Chỉ mở trong internal_net)
AUTH_SERVICE_PORT=3001
USER_SERVICE_PORT=3002
MERCHANT_SERVICE_PORT=3003
WALLET_SERVICE_PORT=3004
PAYMENT_SERVICE_PORT=3005
NOTIFICATION_SERVICE_PORT=3006
ADMIN_SERVICE_PORT=3007
