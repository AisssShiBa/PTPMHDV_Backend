<file path="services/payment-service/src/jobs/outbox.job.ts">
import cron from 'node-cron'
import { createSingleFlight } from 'finvault-events'
import { OutboxEventStatus } from '../utils/enums'
import { prisma } from '../utils/prisma'
import { NotificationClient } from '../clients/notification.client'
import { publish } from '../utils/rabbitmq.publisher'
import { createPaymentFinvaultPublisher } from '../events/finvault.publisher'
import { claimPaymentOutboxEvents } from './payment-outbox-claim'
import { paymentRetryDelayMs, processPaymentOutboxEvent } from './payment-outbox-event'

const legacyRoutingKey = 'payment.notification'
const notificationClient = new NotificationClient()
const MAX_LEGACY_RETRIES = 10
let finvaultPublisher: ReturnType<typeof createPaymentFinvaultPublisher> | undefined

const getFinvaultPublisher = () => {
  if (!finvaultPublisher) finvaultPublisher = createPaymentFinvaultPublisher()
  return finvaultPublisher
}

function legacyMessage(eventType: string, payload: Record<string, unknown>): string | undefined {
  if (eventType === 'PAYMENT_REFUNDED') {
    return `Thanh toán đã được hoàn tiền ${String(payload.amount ?? '')} VND.`
  }
  if (eventType === 'PAYMENT_CANCELLED') return 'Thanh toán đã bị hủy.'
  return undefined
}

async function updateClaimed(
  id: string,
  lockToken: string,
  data: Parameters<typeof prisma.outboxEvent.updateMany>[0]['data']
): Promise<void> {
  await prisma.outboxEvent.updateMany({
    where: { id, status: OutboxEventStatus.PROCESSING, lockToken },
    data: { ...data, lockedUntil: null, lockToken: null }
  })
}

async function processClaimedEvent(id: string, lockToken: string): Promise<void> {
  const event = await prisma.outboxEvent.findFirst({
    where: { id, status: OutboxEventStatus.PROCESSING, lockToken }
  })
  if (!event) return

  const payload = event.payload as Record<string, unknown>
  const finvaultResult = await processPaymentOutboxEvent(event, {
    publish: finvaultEvent => getFinvaultPublisher().publish(finvaultEvent),
    markSent: () => updateClaimed(id, lockToken, {
      status: OutboxEventStatus.SENT,
      sentAt: new Date()
    }),
    markFailed: () => updateClaimed(id, lockToken, {
      status: OutboxEventStatus.FAILED
    }),
    scheduleRetry: delayMs => updateClaimed(id, lockToken, {
      status: OutboxEventStatus.PENDING,
      retryCount: { increment: 1 },
      nextRetryAt: new Date(Date.now() + delayMs)
    })
  })
  if (finvaultResult !== 'unhandled') return

  const message = legacyMessage(event.eventType, payload)
  if (!message) {
    await updateClaimed(id, lockToken, {
      status: OutboxEventStatus.SENT,
      sentAt: new Date()
    })
    return
  }

  const userId = typeof payload.userId === 'string' ? payload.userId : ''
  if (!userId.trim()) {
    console.error('[Payment Outbox] Invalid legacy event data; marking row FAILED', {
      eventId: event.id,
      eventType: event.eventType
    })
    await updateClaimed(id, lockToken, { status: OutboxEventStatus.FAILED })
    return
  }

  const legacyPayload = { eventId: event.id, userId, type: event.eventType, message }
  let sent = false
  try {
    sent = await publish(
      'payment.events',
      event.eventType === 'PAYMENT_EXPIRED' ? 'payment.expired' : legacyRoutingKey,
      legacyPayload,
      { messageId: event.id }
    )
  } catch {
    sent = false
  }

  try {
    if (!sent) await notificationClient.send(userId, event.eventType, message, event.id)
    await updateClaimed(id, lockToken, {
      status: OutboxEventStatus.SENT,
      sentAt: new Date()
    })
  } catch (error) {
    const status = (error as { response?: { status?: number } }).response?.status
    const nextRetryCount = event.retryCount + 1
    console.error('[Payment Outbox] Legacy notification delivery failed', {
      eventId: event.id,
      eventType: event.eventType,
      status
    })
    if ((status !== undefined && status >= 400 && status < 500) ||
        nextRetryCount >= MAX_LEGACY_RETRIES) {
      await updateClaimed(id, lockToken, {
        status: OutboxEventStatus.FAILED,
        retryCount: nextRetryCount
      })
      return
    }

    await updateClaimed(id, lockToken, {
      status: OutboxEventStatus.PENDING,
      retryCount: nextRetryCount,
      nextRetryAt: new Date(Date.now() + paymentRetryDelayMs(event.retryCount))
    })
  }
}

async function drainPendingOutbox(): Promise<void> {
  const claimed = await claimPaymentOutboxEvents(prisma)
  for (const event of claimed) {
    try {
      // Publishing happens after the short claim transaction. If a worker dies,
      // the lease expires and the stable eventId permits safe at-least-once retry.
      await processClaimedEvent(event.id, event.lockToken)
    } catch (error) {
      console.error('[Payment Outbox] Claimed event processing failed', {
        eventId: event.id,
        error: error instanceof Error ? error.message : 'unknown error'
      })
      await updateClaimed(event.id, event.lockToken, {
        status: OutboxEventStatus.PENDING,
        retryCount: { increment: 1 },
        nextRetryAt: new Date(Date.now() + 1000)
      }).catch(updateError => {
        console.error('[Payment Outbox] Could not release failed event lease', {
          eventId: event.id,
          error: updateError instanceof Error ? updateError.message : 'unknown error'
        })
      })
    }
  }
}

const runDrain = createSingleFlight(drainPendingOutbox)

export function drainOutbox(): Promise<void> {
  return runDrain()
}

export async function closeFinvaultOutboxPublisher(): Promise<void> {
  const publisher = finvaultPublisher
  finvaultPublisher = undefined
  await publisher?.close()
}

export const startOutboxJob = () => {
  cron.schedule('*/1 * * * * *', () => {
    void drainOutbox().catch(error => {
      console.error('[Payment Outbox] Drain failed', error instanceof Error ? error.message : 'unknown error')
    })
  })
  void drainOutbox().catch(error => {
    console.error('[Payment Outbox] Initial drain failed', error instanceof Error ? error.message : 'unknown error')
  })
  console.log('Outbox Job started (runs every second)')
}
</file>

<file path="services/wallet-service/src/jobs/outbox.scheduler.ts">
import cron from 'node-cron';
import { PrismaClient } from '@prisma/client';
import { publish } from '../utils/rabbitmq.publisher';
import { env } from '../config/env';
import {
  InvalidWalletOutboxDataError,
  createWalletOutboxDrain,
  shouldPublishLegacyWalletEvent,
  validateWalletOutboxPayload
} from './wallet-event-routing';

const ROUTING_KEY = 'wallet.notification';
const NOTIFICATION_SERVICE_URL = process.env.NOTIFICATION_SERVICE_URL ?? 'http://notification-service:3006';
const INTERNAL_KEY = env.internalApiKey;
const MAX_BATCH_SIZE = 10;
const prisma = new PrismaClient();

async function claimPendingRows(): Promise<string[]> {
  // Wallet has no lease column by ownership constraint: this short lock prevents
  // overlapping claims only while selecting; stable eventId makes cross-process
  // duplicate publication safe for the receiving inbox.
  return prisma.$transaction(async tx => {
    const claimed = await tx.$queryRaw<Array<{ id: string }>>`
      SELECT id
      FROM "WalletOutboxEvent"
      WHERE "publishedAt" IS NULL
      ORDER BY "createdAt" ASC
      LIMIT ${MAX_BATCH_SIZE}
      FOR UPDATE SKIP LOCKED
    `;
    return claimed.map(row => row.id);
  }, { maxWait: 5000, timeout: 15_000 });
}

async function markPublished(id: string): Promise<void> {
  await prisma.walletOutboxEvent.update({
    where: { id },
    data: { publishedAt: new Date() }
  });
}

async function processWalletOutboxRow(id: string): Promise<void> {
  const event = await prisma.walletOutboxEvent.findFirst({
    where: { id, publishedAt: null }
  });
  if (!event) return;

  try {
    const payload = event.payload as Record<string, unknown>;
    validateWalletOutboxPayload(event.topic, payload);
    if (!shouldPublishLegacyWalletEvent(payload)) {
      await markPublished(event.id)
      return;
    }

    const isAdded = event.topic === 'wallet.balance_added';
    const amount = String(payload.amount);
    const balanceAfter = String(payload.balanceAfter);
    const transferType = String(payload.transferType);
    const userId = String(payload.userId);
    let message = `Ví của bạn vừa được ${isAdded ? 'cộng' : 'trừ'} ${amount} VND. Số dư mới: ${balanceAfter} VND.`;

    if (transferType === 'TOPUP') {
      message = `Nạp tiền thành công ${amount} VND. Số dư: ${balanceAfter} VND.`;
    } else if (transferType === 'PAYMENT' && !isAdded) {
      message = `Thanh toán dịch vụ trừ ${amount} VND. Số dư: ${balanceAfter} VND.`;
    } else if (transferType === 'REFUND' && isAdded) {
      message = `Hoàn tiền dịch vụ cộng ${amount} VND. Số dư: ${balanceAfter} VND.`;
    }

    let type = event.topic.toUpperCase().replace('.', '_');
    if (type === 'WALLET_BALANCE_ADDED') type = 'WALLET_CREDITED';
    if (type === 'WALLET_BALANCE_DEDUCTED') type = 'WALLET_DEBITED';

    const mqPayload = { eventId: String(event.id), userId, type, message };
    const sent = await publish('wallet.events', ROUTING_KEY, mqPayload, { messageId: String(event.id) })
      .catch(() => false);

    if (!sent) {
      const response = await fetch(`${NOTIFICATION_SERVICE_URL}/api/notifications`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-Internal-Key': INTERNAL_KEY
        },
        body: JSON.stringify(mqPayload),
        signal: AbortSignal.timeout(8000)
      });

      if (!response.ok) {
        const error = new Error(`Notification fallback returned HTTP ${response.status}`)
        Object.assign(error, { status: response.status })
        throw error
      }
    }

    await markPublished(event.id);
  } catch (error: unknown) {
    if (error instanceof InvalidWalletOutboxDataError) {
      console.error('[Wallet Outbox] Invalid event data; marking row complete', {
        eventId: event.id,
        topic: event.topic
      });
      await markPublished(event.id);
      return;
    }

    const status = (error as { status?: number }).status;
    const attempts = event.attempts + 1;
    if (status !== undefined && status >= 400 && status < 500) {
      console.error('[Wallet Outbox] Permanent notification rejection', {
        eventId: event.id,
        topic: event.topic,
        status
      });
      await markPublished(event.id);
      return;
    }

    console.error('[Wallet Outbox] Delivery failed; event remains pending', {
      eventId: event.id,
      topic: event.topic,
      error: error instanceof Error ? error.message : 'unknown error'
    });
    await prisma.walletOutboxEvent.update({
      where: { id: event.id },
      data: { attempts }
    });
  }
}

async function runOutboxDrain(): Promise<void> {
  const claimedIds = await claimPendingRows();
  for (const id of claimedIds) {
    await processWalletOutboxRow(id);
  }
}

export const drainOutbox = createWalletOutboxDrain(runOutboxDrain);

export function startOutboxScheduler(): void {
  cron.schedule('*/1 * * * * *', () => {
    void drainOutbox().catch(error => {
      console.error('[Wallet Outbox] Scheduler error:', error instanceof Error ? error.message : 'unknown error');
    });
  });
  console.log('[Scheduler] Wallet Outbox processor started (1-second fallback interval)');
}
</file>

<file path="services/wallet-service/src/services/ledger.service.ts">
import { LedgerDirection, OwnerType, Prisma, PrismaClient, SystemWalletCode, TransferType, Wallet } from "@prisma/client";
import { randomUUID } from "crypto";
import { DomainException } from "../utils/domain.exception";
import { TransferDto, CreditDto, DebitDto } from "../dtos/wallet.dto";
import { assertWalletActive, conflict, decimalToString, insufficientBalance, money } from "../utils/wallet.helpers";

import { LimitService } from "./limit.service";
import { drainOutbox } from "../jobs/outbox.scheduler";
import { isPeerWalletPayment } from "../jobs/wallet-event-routing";

const HttpStatus = { NOT_FOUND: 404, BAD_REQUEST: 400, INTERNAL_SERVER_ERROR: 500 };
const prisma = new PrismaClient();

export class LedgerService {
  constructor(private readonly limitService: LimitService = new LimitService()) {}

  getSystemWalletCode(transferType: TransferType): SystemWalletCode {
    switch (transferType) {
      case TransferType.TOPUP:
        return SystemWalletCode.TOPUP_POOL;
      case TransferType.PAYMENT:
      case TransferType.REFUND:
      case TransferType.ADJUSTMENT:
      default:
        return SystemWalletCode.MAIN;
    }
  }

  async getWalletIds(
    tx: Prisma.TransactionClient, 
    specs: { userId?: string; ownerType: OwnerType; systemCode?: SystemWalletCode }[]
  ): Promise<number[]> {
    const ids: number[] = [];
    for (const spec of specs) {
      if (spec.systemCode) {
        const w = await tx.wallet.findUnique({ where: { systemCode: spec.systemCode }, select: { id: true } });
        if (!w) throw new DomainException(HttpStatus.INTERNAL_SERVER_ERROR, "SYSTEM_WALLET_NOT_FOUND", `System wallet ${spec.systemCode} missing`);
        ids.push(w.id);
      } else if (spec.userId) {
        const w = await tx.wallet.findFirst({ where: { userId: spec.userId, ownerType: spec.ownerType }, select: { id: true } });
        if (!w) throw new DomainException(HttpStatus.NOT_FOUND, "WALLET_NOT_FOUND", "Wallet was not found");
        ids.push(w.id);
      } else if (spec.ownerType === OwnerType.SYSTEM) {
        // Fallback default system wallet: MAIN
        const w = await tx.wallet.findUnique({ where: { systemCode: SystemWalletCode.MAIN }, select: { id: true } });
        if (!w) throw new DomainException(HttpStatus.INTERNAL_SERVER_ERROR, "SYSTEM_WALLET_NOT_FOUND", "System wallet MAIN missing");
        ids.push(w.id);
      }
    }
    return ids;
  }

  async lockAndFetchWalletsTx(tx: Prisma.TransactionClient, ids: number[]): Promise<Record<number, Wallet>> {
    const sortedIds = [...new Set(ids)].sort((a, b) => a - b);
    if (sortedIds.length > 0) {
      await tx.$queryRaw`SELECT id FROM "Wallet" WHERE id IN (${Prisma.join(sortedIds)}) ORDER BY id FOR UPDATE`;
    }
    const wallets = await tx.wallet.findMany({ where: { id: { in: sortedIds } } });
    const map: Record<number, Wallet> = {};
    for (const w of wallets) map[w.id] = w;
    return map;
  }

  async transfer(dto: TransferDto) {
    if (dto.fromUserId === dto.toUserId) {
      throw new DomainException(HttpStatus.BAD_REQUEST, "SAME_WALLET_TRANSFER", "Wallets must differ");
    }
    const amount = money(dto.amount);

    const result = await prisma.$transaction(async (tx) => {
      const ids = await this.getWalletIds(tx, [
        { userId: dto.fromUserId, ownerType: OwnerType.USER },
        { userId: dto.toUserId, ownerType: OwnerType.USER }
      ]);
      const wallets = await this.lockAndFetchWalletsTx(tx, ids);
      const from = wallets[ids[0]];
      const to = wallets[ids[1]];

      const replay = await tx.ledgerEntry.findUnique({
        where: { walletId_referenceId: { walletId: from.id, referenceId: dto.referenceId } }
      });

      if (!replay && from.ownerType === OwnerType.USER && from.userId) {
        await this.limitService.checkAndReserve(tx, from.userId, amount, from.kycTier ?? 0);
      }

      return await this.moveMoneyTxInternal(tx, {
        fromWallet: from,
        toWallet: to,
        amount,
        referenceId: dto.referenceId,
        transferType: TransferType.P2P_TRANSFER,
      });
    }, { maxWait: 15000, timeout: 25000 });
    void drainOutbox().catch(error => {
      console.error("[Wallet Outbox] Post-commit drain failed", error instanceof Error ? error.message : "unknown error");
    });
    return result;
  }

  async credit(userId: string, dto: CreditDto, ownerType: OwnerType = OwnerType.USER) {
    const transferType = dto.transferType ?? TransferType.TOPUP;
    const systemCode = dto.systemCode ?? this.getSystemWalletCode(transferType);
    const amount = money(dto.amount);

    const result = await prisma.$transaction(async (tx) => {
      const ids = await this.getWalletIds(tx, [
        { userId, ownerType },
        { ownerType: OwnerType.SYSTEM, systemCode }
      ]);
      const wallets = await this.lockAndFetchWalletsTx(tx, ids);
      const destination = wallets[ids[0]];
      const systemWallet = wallets[ids[1]];

      return await this.moveMoneyTxInternal(tx, {
        fromWallet: systemWallet,
        toWallet: destination,
        amount,
        referenceId: dto.referenceId,
        transferType,
      });
    });
    void drainOutbox().catch(error => {
      console.error("[Wallet Outbox] Post-commit drain failed", error instanceof Error ? error.message : "unknown error");
    });
    return result;
  }

  async debit(userId: string, dto: DebitDto, ownerType: OwnerType = OwnerType.USER) {
    const transferType = dto.transferType ?? TransferType.PAYMENT;
    const systemCode = dto.systemCode ?? this.getSystemWalletCode(transferType);
    const amount = money(dto.amount);

    const result = await prisma.$transaction(async (tx) => {
      const ids = await this.getWalletIds(tx, [
        { userId, ownerType },
        { ownerType: OwnerType.SYSTEM, systemCode }
      ]);
      const wallets = await this.lockAndFetchWalletsTx(tx, ids);
      const source = wallets[ids[0]];
      const systemWallet = wallets[ids[1]];

      return await this.moveMoneyTxInternal(tx, {
        fromWallet: source,
        toWallet: systemWallet,
        amount,
        referenceId: dto.referenceId,
        transferType,
      });
    });
    void drainOutbox().catch(error => {
      console.error("[Wallet Outbox] Post-commit drain failed", error instanceof Error ? error.message : "unknown error");
    });
    return result;
  }

  async getSystemWalletTx(tx: Prisma.TransactionClient, systemCode: SystemWalletCode = SystemWalletCode.MAIN): Promise<Wallet> {
    const ids = await this.getWalletIds(tx, [{ ownerType: OwnerType.SYSTEM, systemCode }]);
    const wallets = await this.lockAndFetchWalletsTx(tx, ids);
    return wallets[ids[0]];
  }

  async findWalletTx(tx: Prisma.TransactionClient, userId: string, ownerType: OwnerType): Promise<Wallet> {
    const ids = await this.getWalletIds(tx, [{ userId, ownerType }]);
    const wallets = await this.lockAndFetchWalletsTx(tx, ids);
    return wallets[ids[0]];
  }

  async moveMoneyTxInternal(tx: Prisma.TransactionClient, input: {
    fromWallet: Wallet;
    toWallet: Wallet;
    amount: Prisma.Decimal;
    referenceId: string;
    transferType: TransferType;
    consumeHeldFrom?: boolean;
    bypassLockedFrom?: boolean;
    note?: string;
  }) {
    const { fromWallet, toWallet, amount } = input;

    const replay = await tx.ledgerEntry.findUnique({
      where: { walletId_referenceId: { walletId: fromWallet.id, referenceId: input.referenceId } }
    });

    if (replay) {
      if (
        replay.direction !== LedgerDirection.DEBIT ||
        replay.transferType !== input.transferType ||
        !replay.amount.equals(amount)
      ) {
        throw conflict("REFERENCE_ID_REUSED", "referenceId was used with a different operation");
      }

      const toWalletDb = await tx.wallet.findUnique({ where: { id: toWallet.id } });
      const fromWalletDb = await tx.wallet.findUnique({ where: { id: fromWallet.id } });

      return {
        sourceWallet: fromWalletDb!,
        destinationWallet: toWalletDb!,
        transactionId: replay.transactionId,
        replayed: true,
      };
    }

    assertWalletActive(fromWallet, input.bypassLockedFrom);
    assertWalletActive(toWallet, false);

    if (fromWallet.currency !== toWallet.currency) throw conflict("CURRENCY_MISMATCH", "Wallet currencies must match");

    if (input.consumeHeldFrom) {
      if (fromWallet.heldBalance.lt(amount)) throw conflict("HOLD_BALANCE_INCONSISTENT", "Hold amount exceeds held balance");
      await tx.wallet.update({
        where: { id: fromWallet.id },
        data: { heldBalance: { decrement: amount } }
      });
    } else if (fromWallet.ownerType !== OwnerType.SYSTEM && fromWallet.balance.sub(fromWallet.heldBalance).lt(amount)) {
      throw insufficientBalance();
    }

    const updatedSource = await tx.wallet.update({
      where: { id: fromWallet.id },
      data: { balance: { decrement: amount } }
    });

    const updatedDest = await tx.wallet.update({
      where: { id: toWallet.id },
      data: { balance: { increment: amount } }
    });

    const transactionId = randomUUID();

    await tx.ledgerEntry.create({
      data: {
        transactionId,
        walletId: fromWallet.id,
        direction: LedgerDirection.DEBIT,
        amount,
        balanceAfter: updatedSource.balance,
        referenceId: input.referenceId,
        transferType: input.transferType,
        note: input.note,
      }
    });

    await tx.ledgerEntry.create({
      data: {
        transactionId,
        walletId: toWallet.id,
        direction: LedgerDirection.CREDIT,
        amount,
        balanceAfter: updatedDest.balance,
        referenceId: input.referenceId,
        transferType: input.transferType,
        note: input.note,
      }
    });

    if (fromWallet.ownerType === OwnerType.USER && fromWallet.userId) {
      await tx.walletOutboxEvent.create({
        data: {
          topic: 'wallet.balance_deducted',
          payload: {
            userId: fromWallet.userId,
            amount: decimalToString(amount),
            balanceAfter: decimalToString(updatedSource.balance),
            transferType: input.transferType,
            isPeerTransfer: isPeerWalletPayment(input.transferType, fromWallet.ownerType, toWallet.ownerType),
            referenceId: input.referenceId,
            transactionId,
            note: input.note || '',
          }
        }
      });
    }

    if (toWallet.ownerType === OwnerType.USER && toWallet.userId) {
      await tx.walletOutboxEvent.create({
        data: {
          topic: 'wallet.balance_added',
          payload: {
            userId: toWallet.userId,
            amount: decimalToString(amount),
            balanceAfter: decimalToString(updatedDest.balance),
            transferType: input.transferType,
            isPeerTransfer: isPeerWalletPayment(input.transferType, fromWallet.ownerType, toWallet.ownerType),
            referenceId: input.referenceId,
            transactionId,
            note: input.note || '',
          }
        }
      });
    }

    return {
      sourceWallet: updatedSource,
      destinationWallet: updatedDest,
      transactionId,
      replayed: false,
    };
  }
}
