<file path="services/payment-service/src/funding/clients/payout.client.ts">
import { DomainException } from '../../utils/domain.exception';
import { mockPayoutEnabled, MockPayoutService, type MockPayoutRow } from '../services/mock-payout.service';

export type PayoutOutcome =
  | { outcome: 'SUCCESS' | 'FAILED'; bankTransactionId: string | null; failureCode: string | null }
  // PENDING is a first-class result: the bank may or may not have moved money,
  // so the caller must reconcile before it can conclude anything.
  | { outcome: 'PENDING' };

// Seam between the cash-out workflow and whatever actually talks to a bank.
// Today only the durable mock exists, so an unconfigured provider must fail
// closed *before* any hold is placed rather than silently answering SUCCESS.
export class PayoutClient {
  constructor(private readonly mock: MockPayoutService = new MockPayoutService()) {}

  assertConfigured(): void {
    if (!mockPayoutEnabled()) {
      throw new DomainException(503, 'PAYOUT_PROVIDER_NOT_CONFIGURED', 'No payout provider is configured');
    }
  }

  async payout(providerRef: string, amount: string): Promise<PayoutOutcome> {
    this.assertConfigured();
    return toOutcome(await this.mock.payout(providerRef, amount));
  }

  // Reads the provider's verdict without creating one. Recovery uses this so a
  // row that was already sent is never re-sent under a different reference.
  async query(providerRef: string): Promise<PayoutOutcome | null> {
    this.assertConfigured();
    const row = await this.mock.query(providerRef);
    return row ? toOutcome(row) : null;
  }
}

function toOutcome(row: MockPayoutRow): PayoutOutcome {
  return row.result === 'PENDING'
    ? { outcome: 'PENDING' }
    : { outcome: row.result, bankTransactionId: row.bankTransactionId, failureCode: row.failureCode };
}
</file>

<file path="services/payment-service/src/funding/controllers/cashout.controller.ts">
import { Request, Response } from 'express';
import { DomainException } from '../../utils/domain.exception';
import { CashOutService } from '../services/cashout.service';
import { MockPayoutService } from '../services/mock-payout.service';
import { mockPayoutEnabled } from '../services/mock-payout.service';

const cashOutService = new CashOutService();
const mockPayoutService = new MockPayoutService();

// Never echo the bank account, the PIN, the token or internal keys.
// failureReason is included because it is an error code, not free-form PII.
function view(cashOut: any) {
  return {
    id: cashOut.id,
    userId: cashOut.userId,
    amount: cashOut.amount?.toFixed ? cashOut.amount.toFixed(0) : String(cashOut.amount),
    destination: cashOut.destination ?? null,
    status: cashOut.status,
    failureReason: cashOut.failureReason ?? null,
    createdAt: cashOut.createdAt,
    updatedAt: cashOut.updatedAt,
    ...(cashOut.replayed === undefined ? {} : { replayed: cashOut.replayed }),
  };
}

function idempotencyKey(req: Request, bodyKey?: string): string {
  const headerKey = req.get('Idempotency-Key');
  if (headerKey && bodyKey && headerKey !== bodyKey) {
    throw new DomainException(400, 'IDEMPOTENCY_KEY_MISMATCH', 'Header and body keys differ');
  }
  const key = headerKey || bodyKey;
  if (!key) throw new DomainException(400, 'IDEMPOTENCY_KEY_REQUIRED', 'Idempotency-Key is required');
  if (key.length > 255) throw new DomainException(400, 'IDEMPOTENCY_KEY_REQUIRED', 'Idempotency-Key is too long');
  return key;
}

export const create = async (req: Request, res: Response) => {
  const { cashOut, replayed } = await cashOutService.create({
    userId: req.auth!.userId,
    idempotencyKey: idempotencyKey(req),
    amount: req.body.amount,
    destination: req.body.destination,
  });
  res.status(201).json({ success: true, data: view({ ...cashOut, replayed }) });
};

export const confirm = async (req: Request, res: Response) => {
  const result = await cashOutService.confirm(
    req.params.id as string,
    req.auth!.userId,
    req.transactionToken!,
  );
  if (!result) throw new DomainException(503, 'CASHOUT_PROCESSING', 'Cash-out is being processed; query its status');
  if (result.status === 'FAILED') {
    throw new DomainException(409, 'CASHOUT_FAILED', result.failureReason || 'Cash-out failed');
  }
  if (result.status === 'PAYOUT_PENDING') {
    throw new DomainException(503, 'CASHOUT_PAYOUT_PENDING', 'Payout outcome is being reconciled; query its status');
  }
  res.json({ success: true, data: view(result) });
};

export const getById = async (req: Request, res: Response) => {
  const result = await cashOutService.get(req.params.id as string, req.auth!.userId, req.auth!.role);
  res.json({ success: true, data: view(result) });
};

// ---- internal mock payout routes: never proxied publicly ----

function assertMockEnabled() {
  if (!mockPayoutEnabled()) {
    throw new DomainException(404, 'MOCK_PAYOUT_DISABLED', 'Mock payout is not enabled');
  }
}

export const mockPayoutQuery = async (req: Request, res: Response) => {
  assertMockEnabled();
  const row = await mockPayoutService.query(req.params.providerRef as string);
  if (!row) throw new DomainException(404, 'PAYOUT_NOT_FOUND', 'Payout not found');
  res.json({ success: true, data: row });
};

export const mockPayoutResolve = async (req: Request, res: Response) => {
  assertMockEnabled();
  const row = await mockPayoutService.resolve(req.params.providerRef as string, req.body.result);
  res.json({ success: true, data: row });
};
</file>

<file path="services/payment-service/src/funding/events/cashout.events.ts">
import type { FinvaultEvent } from 'finvault-events';

type CashOutEventRow = {
  id: string;
  userId: string;
  amount: { toFixed(decimals: number): string };
};

// Both events carry the full envelope because the outbox job validates it with
// parseFinvaultEvent before publishing. cashOutId must equal the outbox row's
// aggregateId, otherwise buildPaymentFinvaultEvent rejects the row.
export function cashoutCompletedEvent(
  eventId: string,
  cashOut: CashOutEventRow,
  walletTransactionId: string | null,
): FinvaultEvent {
  return {
    eventId,
    eventType: 'funding.cashout_completed',
    eventVersion: 1,
    occurredAt: new Date().toISOString(),
    data: {
      cashOutId: cashOut.id,
      userId: cashOut.userId,
      amount: cashOut.amount.toFixed(0),
      ...(walletTransactionId ? { walletTransactionId } : {}),
    },
  };
}

export function cashoutFailedEvent(eventId: string, cashOut: CashOutEventRow, reason: string): FinvaultEvent {
  return {
    eventId,
    eventType: 'funding.cashout_failed',
    eventVersion: 1,
    occurredAt: new Date().toISOString(),
    data: {
      cashOutId: cashOut.id,
      userId: cashOut.userId,
      amount: cashOut.amount.toFixed(0),
      reason: reason || 'CASHOUT_FAILED',
    },
  };
}
</file>

<file path="services/payment-service/src/funding/jobs/recoverCashouts.job.ts">
import cron from 'node-cron';
import { CashOutService } from '../services/cashout.service';

// Re-drives cash-outs whose hold/payout/capture step was interrupted. Every
// step is idempotent by holdRef/providerRef, so a repeated pass cannot move
// money twice; the lease inside drive() keeps two instances from deciding
// different terminal states for the same row.
export function startRecoverCashoutsJob() {
  const service = new CashOutService();
  let running = false;

  const run = async () => {
    if (running) return;
    running = true;
    try {
      const scanned = await service.recover();
      // Only the scheduled pass proves recovery on its own; an explicit test
      // call logs nothing, so this line cannot be satisfied by a manual retry.
      if (scanned > 0) console.log('[Job:recoverCashouts] scanned=' + scanned);
    } catch (error) {
      console.error('[Job:recoverCashouts] Recovery pass failed', error instanceof Error ? error.message : 'unknown error');
    } finally {
      running = false;
    }
  };

  cron.schedule('* * * * *', () => void run());
  console.log('Cash-out recovery job started (runs every minute)');
}
</file>

<file path="services/payment-service/src/funding/jobs/recoverTopups.job.ts">
import cron from 'node-cron';
import { TopupService } from '../../services/topup.service';

// A paid but still-PROCESSING topup means the wallet outcome was never
// confirmed (timeout, 5xx, crash between credit and status update). This worker
// re-drives those rows with the same referenceId (topup.code), so wallet
// idempotency prevents a second credit. Anything less certain must not be
// touched here: only rows VNPAY already reported as paid are eligible.
export function startRecoverTopupsJob() {
  const service = new TopupService();
  let running = false;

  const run = async () => {
    if (running) return;
    running = true;
    try {
      await service.recoverStuckTopups();
    } catch (error) {
      console.error('[Job:recoverTopups] Recovery pass failed', error instanceof Error ? error.message : 'unknown error');
    } finally {
      running = false;
    }
  };

  cron.schedule('* * * * *', () => void run());
  console.log('Topup recovery job started (runs every minute)');
}
</file>

