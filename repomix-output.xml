<file path="services/user-service/prisma/schema.prisma">
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  // Local profile ID; distinct from the Auth ID used by tokens and other services.
  id          String    @id @default(uuid())
  // Account ID from auth-service.User.id. Keep this field name for API/event compatibility.
  authUserId  String    @unique @map("auth_user_id")
  email       String    @unique
  fullName    String?   @map("full_name")
  phone       String?
  address     String?
  kycStatus   KycStatus @default(NONE) @map("kyc_status")
  kycTier     Int       @default(0) @map("kyc_tier")
  idNumber    String?   @map("id_number")
  idImageUrl  String?   @map("id_image_url")
  kycObjectKey String? @map("kyc_object_key")
  kycMimeType String? @map("kyc_mime_type")
  kycFileSize Int? @map("kyc_file_size")
  version Int @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@index([authUserId])
  @@map("users")
}

enum KycStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

model ConsumedEvent {
  id String @id
  payloadHash String @map("payload_hash")
  processedAt DateTime @default(now()) @map("processed_at")
  @@map("consumed_events")
}

model StorageCleanup {
  objectKey String @id @map("object_key")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([nextAttemptAt])
  @@map("storage_cleanup")
}

model UserOutboxEvent {
  id               String    @id @default(uuid())
  aggregateId      String    @map("aggregate_id")
  aggregateVersion Int       @map("aggregate_version")
  eventType        String    @map("event_type")
  payload          Json
  status           String    @default("PENDING")
  createdAt        DateTime  @default(now()) @map("created_at")
  publishedAt      DateTime? @map("published_at")

  @@unique([aggregateId, aggregateVersion])
  @@index([status, createdAt])
  @@map("user_outbox_events")
}
</file>

