  const original = prisma.$transaction.bind(prisma)
  stub(prisma, '$transaction', (callback: any, options: any) => original(async tx => {
    tx.merchantOutboxEvent.create = (async () => { throw new Error('Simulated outbox failure') }) as any
    return callback(tx)
  }, options))
