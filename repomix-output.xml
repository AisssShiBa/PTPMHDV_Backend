  ALTER COLUMN "userId" DROP NOT NULL,
  ADD COLUMN "ownerType" "OwnerType" NOT NULL DEFAULT 'USER',
  ADD COLUMN "heldBalance" DECIMAL(20,2) NOT NULL DEFAULT 0,
