<file path="services/user-service/src/services/kyc-tier.service.ts">
import { randomUUID } from 'node:crypto'
import { z } from 'zod'
import { Prisma, User } from '@prisma/client'
import { transaction } from '../utils/transaction'
import { HttpError } from '../utils/errors'

// Trusted domain operation only; profile/upload HTTP bodies cannot set this field.
export async function recordTierChange(tx: Prisma.TransactionClient, profile: User, previousTier: number) {
  if (profile.kycTier === previousTier) return
  const eventId = randomUUID()
  await tx.userOutboxEvent.create({ data: {
    id: eventId, aggregateId: profile.id, aggregateVersion: profile.version,
    eventType: 'user.kyc_updated',
    payload: {
      eventId, eventType: 'user.kyc_updated', eventVersion: 1, occurredAt: new Date().toISOString(),
      data: { authUserId: profile.authUserId, kycTier: profile.kycTier, previousTier }
    }
  } })
}

export async function updateKycTier(profileId: string, nextTier: number, requireApproved = false) {
  z.string().uuid().parse(profileId)
  z.number().int().min(0).max(2).parse(nextTier)
  return transaction(async tx => {
    const current = await tx.user.findFirst({ where: { id: profileId, deletedAt: null } })
    if (!current) throw new HttpError(404, 'NOT_FOUND', 'User not found')
    if (requireApproved && current.kycStatus !== 'APPROVED')
      throw new HttpError(409, 'KYC_NOT_APPROVED', 'Approve KYC before changing its tier')
    if (current.kycTier === nextTier) return current
    const profile = await tx.user.update({
      where: { id: profileId, deletedAt: null, version: current.version },
      data: { kycTier: nextTier, version: { increment: 1 } }
    })
    await recordTierChange(tx, profile, current.kycTier)
    return profile
  })
}
</file>

<file path="services/user-service/src/services/recipient-lookup.ts">
import { prisma } from '../config/prisma'
import { HttpError } from '../utils/errors'

// A rolling minute, shared by all instances. The conflicting row is locked by
// PostgreSQL, so concurrent requests cannot each spend the same remaining slot.
export async function consumeLookupAttempt(authUserId: string) {
  const accepted = await prisma.$queryRaw<Array<{ auth_user_id: string }>>`
    INSERT INTO recipient_lookup_limits (auth_user_id, attempts)
    VALUES (${authUserId}, ARRAY[statement_timestamp()])
    ON CONFLICT (auth_user_id) DO UPDATE SET attempts = array_append(
      ARRAY(SELECT attempt FROM unnest(recipient_lookup_limits.attempts) AS attempt
        WHERE attempt > statement_timestamp() - INTERVAL '1 minute'), statement_timestamp())
    WHERE cardinality(ARRAY(SELECT attempt FROM unnest(recipient_lookup_limits.attempts) AS attempt
      WHERE attempt > statement_timestamp() - INTERVAL '1 minute')) < 10
    RETURNING auth_user_id
  `
  if (!accepted.length) throw new HttpError(429, 'RATE_LIMIT_EXCEEDED', 'Too many recipient lookups; retry later')
}

export function maskName(name: string | null) {
  const parts = name?.trim().split(/\s+/).filter(Boolean) || []
  if (!parts.length) return '***'
  if (parts.length === 1) return Array.from(parts[0])[0] + '***'
  return [parts[0], ...parts.slice(1).map(part => Array.from(part)[0] + '.')].join(' ')
}

export async function lookupRecipient(query: string, callerAuthUserId: string) {
  // Count ambiguous matches before visibility filtering; never expose a list.
  type Recipient = { authUserId: string; fullName: string | null; deletedAt: Date | null }
  const matches = query.includes('@')
    ? await prisma.$queryRaw<Recipient[]>`SELECT auth_user_id AS "authUserId", full_name AS "fullName", deleted_at AS "deletedAt"
        FROM users WHERE LOWER(email) = LOWER(${query}) LIMIT 2`
    : await prisma.$queryRaw<Recipient[]>`SELECT auth_user_id AS "authUserId", full_name AS "fullName", deleted_at AS "deletedAt"
        FROM users WHERE phone = ${query} LIMIT 2`
  const recipient = matches[0]
  if (matches.length !== 1 || recipient.deletedAt || recipient.authUserId === callerAuthUserId)
    throw new HttpError(404, 'RECIPIENT_NOT_FOUND', 'Recipient not found')
  return { authUserId: recipient.authUserId, maskedName: maskName(recipient.fullName) }
}
</file>

<file path="services/user-service/src/services/storage-cleanup.ts">
import { Prisma } from '@prisma/client'
import { prisma } from '../config/prisma'
import { env } from '../config/env'
import { storage } from './storage'

// Serialize final upload commit and deletion for the same immutable object key.
export async function lockKycObject(tx: Prisma.TransactionClient, key: string) {
  await tx.$queryRaw`SELECT 1 AS locked FROM pg_advisory_xact_lock(hashtextextended(${key}, 0))`
}

export async function removeUnreferenced(key: string, requireJob = false) {
  // ReadCommitted sees a submission that committed while we waited for its lock.
  // Never automatically retry a transaction containing a storage delete.
  return prisma.$transaction(async tx => {
    await lockKycObject(tx, key)
    const job = await tx.storageCleanup.findUnique({ where: { objectKey: key } })
    if (requireJob && !job) return 'skipped' as const
    if (job && job.nextAttemptAt.getTime() > Date.now()) return 'protected' as const
    const referenced = await tx.user.findFirst({ where: { OR: [{ kycObjectKey: key }, { kycBackObjectKey: key }] }, select: { id: true } })
    if (!referenced) await storage.remove(key)
    await tx.storageCleanup.deleteMany({ where: { objectKey: key } })
    return referenced ? 'referenced' as const : 'deleted' as const
  }, { isolationLevel: 'ReadCommitted', timeout: 25000 })
}

export async function scanKycOrphans(options: {
  dryRun?: boolean; graceMs?: number; log?: (entry: Record<string, unknown>) => void
} = {}) {
  const dryRun = options.dryRun ?? true
  const graceMs = options.graceMs ?? env.cleanupGraceMs
  if (!Number.isSafeInteger(graceMs) || graceMs <= 0) throw new Error('Cleanup grace period must be positive')
  const log = options.log ?? (entry => console.log(JSON.stringify(entry)))
  const startedAt = Date.now()
  const summary = { mode: dryRun ? 'dry-run' : 'delete', scanned: 0, referenced: 0, orphan: 0,
    tooYoung: 0, protected: 0, skipped: 0, deleted: 0, failed: 0, durationMs: 0 }
  for await (const object of storage.listKyc()) {
    summary.scanned++
    if (!object.key.startsWith('kyc/') || !object.lastModified || !Number.isFinite(object.lastModified.getTime())) {
      summary.skipped++; continue
    }
    if (startedAt - object.lastModified.getTime() < graceMs) { summary.tooYoung++; continue }
    try {
      // A reference lookup error fails closed; tombstones still protect their documents.
      const referenced = await prisma.user.findFirst({ where: { OR: [{ kycObjectKey: object.key }, { kycBackObjectKey: object.key }] }, select: { id: true } })
      if (referenced) { summary.referenced++; continue }
      const job = await prisma.storageCleanup.findUnique({ where: { objectKey: object.key } })
      if (job && job.nextAttemptAt.getTime() > Date.now()) { summary.protected++; continue }
      summary.orphan++
      if (dryRun) { log({ code: 'KYC_ORPHAN_CANDIDATE', objectKey: object.key }); continue }
      // Recheck inside the same per-key lock used by upload commit and queued cleanup.
      const outcome = await removeUnreferenced(object.key)
      if (outcome === 'deleted') summary.deleted++
      else if (outcome === 'referenced') summary.referenced++
      else if (outcome === 'protected') summary.protected++
      else summary.skipped++
    } catch {
      summary.failed++
      log({ code: 'KYC_ORPHAN_CLEANUP_FAILED', objectKey: object.key })
    }
  }
  summary.durationMs = Date.now() - startedAt
  log({ code: 'KYC_ORPHAN_CLEANUP_SUMMARY', ...summary })
  return summary
}
</file>

