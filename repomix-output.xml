<file path="services/merchant-service/src/controllers/merchantController.ts">
import { Response } from 'express'
import { RequestWithContext } from '../middlewares/requestId'
import { prisma } from '../config/prisma'
import { requireAdmin, requireOwner } from '../utils/access'
import { HttpError } from '../utils/errors'
import { findMerchantById, register, changeStatus, updateProfile } from '../services/merchant.service'
import { createOutlet, listOutlets, getOutletQr } from '../services/outlet.service'
import { issueApiKey, revokeApiKey } from '../services/merchant-api-key.service'

export async function registerMerchant(req: RequestWithContext, res: Response) {
  const callerAuthUserId = req.auth?.userId ?? req.internalUserId
  const ownerAuthUserId = req.isInternalCall ? (req.body.ownerId || callerAuthUserId) : callerAuthUserId
  if (!ownerAuthUserId) throw new HttpError(400, 'OWNER_REQUIRED', 'Owner identity required')
  if (!req.isInternalCall && req.body.ownerId !== undefined && req.body.ownerId !== callerAuthUserId)
    throw new HttpError(403, 'FORBIDDEN', 'Cannot register for another owner')
  const { businessName, taxId, bankAccount } = req.body
  const merchant = await register({ ownerId: ownerAuthUserId, businessName, taxId, bankAccount })
  return res.status(201).json({ success: true, message: 'Success', data: merchant })
}
// Identity comes from verified authentication, never a query/body ownerId.
// Explicit null distinguishes no registration from a missing endpoint or server error.
export async function getMyMerchant(req: RequestWithContext, res: Response) {
  const callerAuthUserId = req.auth?.userId ?? req.internalUserId
  if (!callerAuthUserId) throw new HttpError(401, 'UNAUTHORIZED', 'Authenticated owner required')
  const merchant = await prisma.merchant.findFirst({ where: { ownerId: callerAuthUserId, deletedAt: null } })
  return res.json({ success: true, message: 'Success', data: merchant })
}

export async function getMerchantById(req: RequestWithContext, res: Response) {
  const merchantId = String(req.params.id)
  const merchant = await findMerchantById(merchantId)
  requireOwner(req, merchant.ownerId)
  return res.json({ success: true, message: 'Success', data: merchant })
}
export async function updateMerchant(req: RequestWithContext, res: Response) {
  const merchantId = String(req.params.id)
  const merchant = await findMerchantById(merchantId)
  requireOwner(req, merchant.ownerId)
  const updated = await updateProfile(merchant.id, req.body)
  return res.json({ success: true, message: 'Success', data: updated })
}
export async function updateMerchantStatus(req: RequestWithContext, res: Response) {
  requireAdmin(req)
  const merchantId = String(req.params.id)
  return res.json({ success: true, message: 'Success', data: await changeStatus(merchantId, req.body.status) })
}
export async function checkMerchantActive(req: RequestWithContext, res: Response) {
  // Minimal activity data is available to authenticated callers; bank details are never returned.
  const merchantId = String(req.params.id)
  const merchant = await findMerchantById(merchantId)
  return res.json({ success: true, message: 'Success', data: {
    id: merchant.id, ownerId: merchant.ownerId, businessName: merchant.businessName,
    status: merchant.status, active: merchant.status === 'APPROVED'
  } })
}
export async function createMerchantOutlet(req: RequestWithContext, res: Response) {
  const merchant = await findMerchantById(String(req.params.id))
  requireOwner(req, merchant.ownerId)
  const outlet = await createOutlet(merchant.id, req.body)
  return res.status(201).json({ success: true, message: 'Success', data: outlet })
}
export async function getMerchantOutlets(req: RequestWithContext, res: Response) {
  const merchant = await findMerchantById(String(req.params.id))
  requireOwner(req, merchant.ownerId)
  const { page, limit, search } = req.query as unknown as { page: number; limit: number; search: string }
  return res.json({ success: true, message: 'Success', data: await listOutlets(merchant.id, page, limit, search) })
}
export async function getMerchantOutletQr(req: RequestWithContext, res: Response) {
  const merchant = await findMerchantById(String(req.params.id))
  requireOwner(req, merchant.ownerId)
  const qr = await getOutletQr(merchant.id, String(req.params.outletId))
  // Signed payloads are per-request; never let an intermediary cache them.
  res.setHeader('Cache-Control', 'no-store')
  return res.json({ success: true, message: 'Success', data: qr })
}
export async function createMerchantApiKey(req: RequestWithContext, res: Response) {
  const merchant = await findMerchantById(String(req.params.id))
  requireOwner(req, merchant.ownerId)
  if (merchant.status !== 'APPROVED') throw new HttpError(409, 'MERCHANT_NOT_APPROVED', 'Merchant is not approved')
  const key = await issueApiKey(merchant.id)
  res.setHeader('Cache-Control', 'no-store')
  return res.status(201).json({ success: true, message: 'Success', data: key })
}
export async function revokeMerchantApiKey(req: RequestWithContext, res: Response) {
  const merchant = await findMerchantById(String(req.params.id))
  requireOwner(req, merchant.ownerId)
  const key = await revokeApiKey(merchant.id, String(req.params.keyId))
  return res.json({ success: true, message: 'Success', data: key })
}
export async function getMerchants(req: RequestWithContext, res: Response) {
  requireAdmin(req)
  const { page, limit, search, status } = req.query as unknown as {
    page: number; limit: number; search: string; status?: 'PENDING' | 'APPROVED' | 'REJECTED'
  }
  const where = { deletedAt: null, ...(status ? { status } : {}),
    ...(search ? { businessName: { contains: search, mode: 'insensitive' as const } } : {}) }
  const [content, totalElements] = await Promise.all([
    prisma.merchant.findMany({ where, skip: (page - 1) * limit, take: limit, orderBy: { createdAt: 'desc' } }),
    prisma.merchant.count({ where })
  ])
  return res.json({ success: true, message: 'Success', data: { content, page, limit, totalElements, totalPages: Math.max(1, Math.ceil(totalElements / limit)) } })
}
</file>

<file path="services/merchant-service/src/routes/merchantRoute.ts">
import { Router } from 'express'
import * as controller from '../controllers/merchantController'
import * as schema from '../validations/merchant.validation'
import { idSchema } from '../validations/common'
import { validate } from '../middlewares/validate'
const router = Router()
router.post('/register', validate(schema.registerMerchantSchema), controller.registerMerchant)
router.get('/', validate(schema.listMerchantsSchema), controller.getMerchants)
router.get('/me', controller.getMyMerchant)
// Nested resources are declared before the bare /:id handlers.
router.post('/:id/outlets', validate(schema.createOutletSchema), controller.createMerchantOutlet)
router.get('/:id/outlets', validate(schema.listOutletsSchema), controller.getMerchantOutlets)
router.get('/:id/outlets/:outletId/qr', validate(schema.getOutletQrSchema), controller.getMerchantOutletQr)
router.post('/:id/api-keys', validate(schema.createApiKeySchema), controller.createMerchantApiKey)
router.delete('/:id/api-keys/:keyId', validate(schema.revokeApiKeySchema), controller.revokeMerchantApiKey)
router.get('/:id/active', validate(idSchema), controller.checkMerchantActive)
router.get('/:id', validate(idSchema), controller.getMerchantById)
router.put('/:id', validate(schema.updateMerchantSchema), controller.updateMerchant)
router.patch('/:id/status', validate(schema.updateMerchantStatusSchema), controller.updateMerchantStatus)
export default router
</file>

<file path="services/merchant-service/src/services/merchant-api-key.service.ts">
import { createHash, randomBytes, randomUUID, timingSafeEqual } from 'node:crypto'
import { prisma } from '../config/prisma'
import { HttpError } from '../utils/errors'

// The raw secret is returned exactly once, at creation. Only its SHA-256 reaches the database.
const secretDigest = (secret: string) => createHash('sha256').update(secret, 'utf8').digest()

type ApiKeyRecord = {
  id: string; keyId: string; prefix: string; revokedAt: Date | null
  lastUsedAt: Date | null; createdAt: Date
}

function serialize(key: ApiKeyRecord) {
  return {
    id: key.id, keyId: key.keyId, prefix: key.prefix,
    revokedAt: key.revokedAt, lastUsedAt: key.lastUsedAt, createdAt: key.createdAt
  }
}

export async function issueApiKey(merchantId: string) {
  const keyId = randomUUID()
  const secret = randomBytes(32).toString('base64url')
  const key = await prisma.merchantApiKey.create({
    data: { merchantId, keyId, prefix: secret.slice(0, 8), secretHash: secretDigest(secret).toString('hex') }
  })
  return { ...serialize(key), key: keyId + '.' + secret }
}

export async function revokeApiKey(merchantId: string, keyId: string) {
  const existing = await prisma.merchantApiKey.findFirst({ where: { keyId, merchantId } })
  if (!existing) throw new HttpError(404, 'NOT_FOUND', 'API key not found')
  // Idempotent: a repeat keeps the first revocation time and never re-exposes the secret.
  if (existing.revokedAt) return serialize(existing)
  return serialize(await prisma.merchantApiKey.update({ where: { id: existing.id }, data: { revokedAt: new Date() } }))
}

// Verifies a `<keyId>.<secret>` credential. Revoked keys never authenticate, and
// lastUsedAt only moves when the presented secret actually matched.
export async function verifyApiKey(credential: string) {
  const separator = credential.indexOf('.')
  if (separator <= 0) return null
  const keyId = credential.slice(0, separator)
  const secret = credential.slice(separator + 1)
  if (!keyId || !secret) return null
  const record = await prisma.merchantApiKey.findFirst({ where: { keyId, revokedAt: null } })
  if (!record) return null
  const stored = Buffer.from(record.secretHash, 'hex')
  const presented = secretDigest(secret)
  if (stored.length !== presented.length || !timingSafeEqual(stored, presented)) return null
  const used = await prisma.merchantApiKey.updateMany({
    where: { id: record.id, revokedAt: null }, data: { lastUsedAt: new Date() }
  })
  return used.count === 0 ? null : serialize(record)
}
</file>

<file path="services/merchant-service/src/services/merchant.service.ts">
import { Merchant, Prisma } from '@prisma/client'
import { randomUUID } from 'node:crypto'
import { prisma } from '../config/prisma'
import { transaction } from '../utils/transaction'
import { HttpError } from '../utils/errors'

export async function findMerchantById(merchantId: string) {
  const merchant = await prisma.merchant.findFirst({ where: { id: merchantId, deletedAt: null } })
  if (!merchant) throw new HttpError(404, 'NOT_FOUND', 'Merchant not found')
  return merchant
}
export async function enqueue(tx: Prisma.TransactionClient, merchant: Merchant, eventType: string) {
  const eventId = randomUUID()
  await tx.merchantOutboxEvent.create({ data: {
    id: eventId, aggregateId: merchant.id, aggregateVersion: merchant.version, eventType,
    nextAttemptAt: new Date(0), // Immediately eligible, independent of application clock skew.
    payload: { eventId, eventType, eventVersion: 1, occurredAt: new Date().toISOString(),
      data: { merchantId: merchant.id, ownerId: merchant.ownerId, businessName: merchant.businessName,
        status: merchant.status, version: merchant.version } }
  } })
}
export async function register(data: { ownerId: string; businessName: string; taxId?: string | null; bankAccount?: string | null }) {
  // ownerId remains the owner's Auth ID in persistence and event payloads.
  return transaction(async tx => {
    const merchant = await tx.merchant.create({ data })
    await enqueue(tx, merchant, 'merchant.registered')
    return merchant
  })
}
export async function changeStatus(merchantId: string, status: Merchant['status']) {
  return transaction(async tx => {
    const current = await tx.merchant.findFirst({ where: { id: merchantId, deletedAt: null } })
    if (!current) throw new HttpError(404, 'NOT_FOUND', 'Merchant not found')
    if (current.status === status) return current // No-op: no version bump, no duplicate event.
    const transitions: Record<Merchant['status'], Merchant['status'][]> = {
      PENDING: ['APPROVED', 'REJECTED'], APPROVED: ['REJECTED'], REJECTED: ['PENDING']
    }
    if (!transitions[current.status].includes(status)) throw new HttpError(409, 'INVALID_TRANSITION', 'Invalid merchant status transition')
    const merchant = await tx.merchant.update({ where: { id: merchantId }, data: { status, version: { increment: 1 } } })
    await enqueue(tx, merchant, 'merchant.status_updated')
    return merchant
  })
}

export async function updateProfile(merchantId: string, data: {
  businessName?: string; taxId?: string | null; bankAccount?: string | null
}) {
  return transaction(async tx => {
    const current = await tx.merchant.findFirst({ where: { id: merchantId, deletedAt: null } })
    if (!current) throw new HttpError(404, 'NOT_FOUND', 'Merchant not found')
    // Whitelist editable fields even for callers other than the HTTP controller.
    const changes: typeof data = {}
    for (const field of ['businessName', 'taxId', 'bankAccount'] as const) {
      if (data[field] !== undefined && data[field] !== current[field]) {
        Object.assign(changes, { [field]: data[field] })
      }
    }
    if (Object.keys(changes).length === 0) return current
    const merchant = await tx.merchant.update({
      where: { id: merchantId, deletedAt: null }, data: { ...changes, version: { increment: 1 } }
    })
    await enqueue(tx, merchant, 'merchant.profile_updated')
    return merchant
  })
}
</file>

<file path="services/merchant-service/src/services/outlet.service.ts">
import { prisma } from '../config/prisma'
import { transaction } from '../utils/transaction'
import { HttpError } from '../utils/errors'
import { enqueue } from './merchant.service'
import { QR_VERSION, signOutletQr } from './qr.service'

export async function createOutlet(merchantId: string, data: { name: string; code: string }) {
  return transaction(async tx => {
    const merchant = await tx.merchant.findFirst({ where: { id: merchantId, deletedAt: null } })
    if (!merchant) throw new HttpError(404, 'NOT_FOUND', 'Merchant not found')
    // Only an approved merchant may expose a public point of sale.
    if (merchant.status !== 'APPROVED') throw new HttpError(409, 'MERCHANT_NOT_APPROVED', 'Merchant is not approved')
    const outlet = await tx.outlet.create({ data: { merchantId, ...data } })
    // Outlets are part of the merchant's public profile; reuse the registry-accepted event.
    const updated = await tx.merchant.update({ where: { id: merchantId }, data: { version: { increment: 1 } } })
    await enqueue(tx, updated, 'merchant.profile_updated')
    return outlet
  })
}

export async function listOutlets(merchantId: string, page: number, limit: number, search: string) {
  const where = {
    merchantId,
    ...(search ? { OR: [
      { name: { contains: search, mode: 'insensitive' as const } },
      { code: { contains: search, mode: 'insensitive' as const } }
    ] } : {})
  }
  const [content, totalElements] = await Promise.all([
    prisma.outlet.findMany({ where, skip: (page - 1) * limit, take: limit, orderBy: { createdAt: 'desc' } }),
    prisma.outlet.count({ where })
  ])
  return { content, page, limit, totalElements, totalPages: Math.max(1, Math.ceil(totalElements / limit)) }
}

export async function getOutletQr(merchantId: string, outletId: string) {
  const merchant = await prisma.merchant.findFirst({ where: { id: merchantId, deletedAt: null } })
  if (!merchant) throw new HttpError(404, 'NOT_FOUND', 'Merchant not found')
  if (merchant.status !== 'APPROVED') throw new HttpError(409, 'MERCHANT_NOT_APPROVED', 'Merchant is not approved')
  // Filter on merchantId too, so an outletId belonging to another merchant never resolves.
  const outlet = await prisma.outlet.findFirst({ where: { id: outletId, merchantId } })
  if (!outlet) throw new HttpError(404, 'NOT_FOUND', 'Outlet not found')
  const issuedAt = Date.now()
  const { token, signature } = signOutletQr({
    version: QR_VERSION, merchantId: merchant.id, outletId: outlet.id, outletCode: outlet.code, issuedAt
  })
  return {
    version: QR_VERSION, merchantId: merchant.id, outletId: outlet.id, outletCode: outlet.code,
    issuedAt, token, signature, algorithm: 'HMAC-SHA256'
  }
}
</file>

<file path="services/merchant-service/src/services/qr.service.ts">
import { createHmac, timingSafeEqual } from 'node:crypto'
import { env } from '../config/env'

export const QR_VERSION = 1

export interface OutletQrPayload {
  version: number
  merchantId: string
  outletId: string
  outletCode: string
  issuedAt: number
}

// Pipe-separated canonical form. Outlet codes are restricted to [A-Za-z0-9_-],
// so no field can contain the separator and each field boundary is unambiguous.
function canonical(payload: OutletQrPayload) {
  return [payload.version, payload.merchantId, payload.outletId, payload.outletCode, payload.issuedAt].join('|')
}

function sign(data: string) {
  return createHmac('sha256', env.merchantQrSecret).update(data, 'utf8').digest()
}

export function signOutletQr(payload: OutletQrPayload) {
  const body = canonical(payload)
  const signature = sign(body)
  return {
    token: Buffer.from(body, 'utf8').toString('base64url') + '.' + signature.toString('base64url'),
    signature: signature.toString('base64url')
  }
}

// Returns the payload only when the signature matches and the caller's expected
// merchant/outlet agree with what was signed (a QR from merchant B never passes for A).
export function verifyOutletQr(
  token: string,
  expected?: { merchantId?: string; outletId?: string }
): OutletQrPayload | null {
  const separator = token.lastIndexOf('.')
  if (separator <= 0) return null
  let body: string
  let presented: Buffer
  try {
    body = Buffer.from(token.slice(0, separator), 'base64url').toString('utf8')
    presented = Buffer.from(token.slice(separator + 1), 'base64url')
  } catch { return null }
  const actual = sign(body)
  if (presented.length !== actual.length || !timingSafeEqual(presented, actual)) return null
  const fields = body.split('|')
  if (fields.length !== 5) return null
  const [version, merchantId, outletId, outletCode, issuedAt] = fields
  if (Number(version) !== QR_VERSION || !Number.isInteger(Number(issuedAt))) return null
  if (expected?.merchantId !== undefined && expected.merchantId !== merchantId) return null
  if (expected?.outletId !== undefined && expected.outletId !== outletId) return null
  return { version: QR_VERSION, merchantId, outletId, outletCode, issuedAt: Number(issuedAt) }
}
</file>

<file path="services/merchant-service/src/validations/merchant.validation.ts">
import { z } from 'zod'
import { idParams, pageQuery } from './common'
const status = z.enum(['PENDING', 'APPROVED', 'REJECTED'])
const fields = {
  businessName: z.string().trim().min(1).max(200),
  taxId: z.string().trim().min(1).max(50).nullable().optional(),
  bankAccount: z.string().trim().min(1).max(100).nullable().optional()
}
export const registerMerchantSchema = z.object({ body: z.object({ ...fields, ownerId: z.string().uuid().optional() }).strict() })
export const updateMerchantSchema = z.object({ params: idParams, body: z.object({
  ...fields, businessName: fields.businessName.optional()
}).strict().refine(value => Object.keys(value).length > 0, 'At least one field is required') })
export const updateMerchantStatusSchema = z.object({ params: idParams, body: z.object({ status }).strict() })
export const listMerchantsSchema = z.object({ query: pageQuery.extend({ status: status.optional() }) })

const outletParams = z.object({ id: z.string().uuid(), outletId: z.string().uuid() })
// The QR canonical form is pipe-delimited, so a code may never contain the separator.
const outletCode = z.string().trim().min(3).max(64).regex(/^[A-Za-z0-9_-]+$/, 'Code may only contain letters, digits, hyphen and underscore')
export const createOutletSchema = z.object({ params: idParams, body: z.object({
  name: z.string().trim().min(1).max(200),
  code: outletCode
}).strict() })
export const listOutletsSchema = z.object({ params: idParams, query: pageQuery })
export const getOutletQrSchema = z.object({ params: outletParams })

const apiKeyParams = z.object({ id: z.string().uuid(), keyId: z.string().uuid() })
export const createApiKeySchema = z.object({ params: idParams })
export const revokeApiKeySchema = z.object({ params: apiKeyParams })
</file>

