import { Request, Response } from 'express'
import { KycActions } from '../services/kycActions'
import { createError } from '../middlewares/errorHandler'

function context(req: Request) {
  const userId = String(req.params.userId)
  if (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(userId))
    throw createError(400, 'VALIDATION_ERROR', 'userId must be a UUID')
  if (!req.auth || req.auth.role !== 'ADMIN') throw createError(403, 'FORBIDDEN', 'Administrator access required')
  return { userId, adminId: req.auth.userId, requestId: (req as Request & { requestId?: string }).requestId || 'unknown' }
}
function reason(value: unknown, required: boolean) {
  if (value === undefined && !required) return undefined
  if (typeof value !== 'string' || !value.trim() || value.trim().length > 500)
    throw createError(400, 'VALIDATION_ERROR', 'reason must contain 1 to 500 characters')
  return value.trim()
}
export async function reviewKyc(req: Request, res: Response) {
  const { userId, adminId, requestId } = context(req)
  const { status, detail } = req.body || {}
  if (status !== 'APPROVED' && status !== 'REJECTED')
    throw createError(400, 'INVALID_STATUS', 'Only APPROVED or REJECTED is accepted')
  return res.json(await KycActions.review(userId, status, reason(detail, status === 'REJECTED'), adminId, requestId))
}
export async function changeKycTier(req: Request, res: Response) {
  const { userId, adminId, requestId } = context(req)
  const { tier, reason: inputReason, ...extra } = req.body || {}
  if ((tier !== 1 && tier !== 2) || Object.keys(extra).length)
    throw createError(400, 'VALIDATION_ERROR', 'Expected tier 1 or 2 and reason')
  return res.json(await KycActions.changeTier(userId, tier, reason(inputReason, true)!, adminId, requestId))
}
export async function getKycDocuments(req: Request, res: Response) {
  const { userId, adminId, requestId } = context(req)
  res.setHeader('Cache-Control', 'no-store')
  return res.json(await KycActions.documents(userId, adminId, requestId))
}
</file>

<file path="services/admin-service/src/controllers/reconciliationController.ts">
import { Request, Response } from 'express'
import { createError } from '../middlewares/errorHandler'
import {
  parseAdjustment,
  parseAnomalyId,
  parsePagination,
  parseReportId,
  parseRunMode
} from '../validations/reconciliation'
import {
  adjustAnomaly,
  getReport,
  listReports,
  runReconciliation
} from '../services/reconciliationService'

type AdminContext = {
  adminId: string
  requestId: string
  gatewayToken: string
}

function context(req: Request): AdminContext {
  // /api/admin already runs requireGateway + requireRole('ADMIN'); re-check
  // here so a future route reordering can never expose this controller.
  if (!req.auth || req.auth.role !== 'ADMIN') {
    throw createError(403, 'FORBIDDEN', 'Administrator access required')
  }
  const gatewayToken = req.get('x-gateway-token')
  if (!gatewayToken) {
    throw createError(401, 'INVALID_GATEWAY_TOKEN', 'Gateway token required')
  }
  const requestId = (req as Request & { requestId?: string }).requestId || 'unknown'
  return { adminId: req.auth.userId, requestId, gatewayToken }
}

export async function run(req: Request, res: Response) {
  const admin = context(req)
  const mode = parseRunMode(req.query.mode)
  const report = await runReconciliation({ mode, ...admin })
  return res.json({ success: true, data: report })
}

export async function reports(req: Request, res: Response) {
  const admin = context(req)
  const { page, limit } = parsePagination(req.query)
  const data = await listReports({ page, limit, ...admin })
  return res.json({ success: true, data })
}

export async function report(req: Request, res: Response) {
  const admin = context(req)
  const id = parseReportId(req.params.id)
  const data = await getReport({ id, ...admin })
  return res.json({ success: true, data })
}

export async function adjust(req: Request, res: Response) {
  const admin = context(req)
  const anomalyId = parseAnomalyId(req.params.id)
  const { direction, amount, reason } = parseAdjustment(req.body)
  const data = await adjustAnomaly({ anomalyId, direction, amount, reason, ...admin })
  return res.json({ success: true, data })
}
</file>

