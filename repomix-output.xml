SET "requestHash" = 'LEGACY', 
    "idempotencyStatus" = 'COMPLETED',
    "idempotencyExpiresAt" = NOW() + INTERVAL '24 hours'
WHERE "requestHash" IS NULL;

-- Step 4: Enforce NOT NULL constraints on new columns after backfilling
