<file path="services/wallet-service/src/middlewares/gatewayOrInternalAuth.ts">
// Middleware dùng cho các route wallet cần hỗ trợ CẢ HAI luồng:
//   1. Request từ người dùng đi qua API Gateway  → xác thực bằng x-gateway-token (ES256)
//   2. Request service-to-service nội bộ         → xác thực bằng INTERNAL_KEY (timingSafeEqual)
//
// Lưu ý: KHÔNG còn nhánh nào tin header `x-gateway-verified` do client tự gán.

import { Request, Response, NextFunction } from 'express'
import { timingSafeEqual } from 'crypto'
import { requireGateway, verifyGatewayToken } from 'finvault-internal-auth'

/**
 * Kiểm tra INTERNAL_KEY an toàn.
 * Fail-closed: nếu biến môi trường INTERNAL_KEY chưa được cấu hình,
 * request nội bộ sẽ bị từ chối thay vì bị cho qua (tránh lỗi config im lặng).
 */
function isValidInternalKey(provided: string | string[] | undefined): boolean {
    const expectedRaw = process.env.INTERNAL_KEY
    if (!expectedRaw) {
        // Fail-closed: INTERNAL_KEY chưa cấu hình → không cho qua
        return false
    }
    if (!provided || typeof provided !== 'string') return false

    try {
        const expected = Buffer.from(expectedRaw, 'utf-8')
        const actual   = Buffer.from(provided,     'utf-8')
        if (expected.length !== actual.length) return false
        return timingSafeEqual(expected, actual)
    } catch {
        return false
    }
}

/**
 * requireGatewayOrInternalKey
 *
 * Luồng xử lý:
 *   A. Có header `x-gateway-token`  → Xác thực ES256 qua finvault-internal-auth.
 *      Kết quả hợp lệ được inject vào `req.auth` bởi thư viện.
 *   B. Có header `x-internal-key`   → So sánh timingSafeEqual với INTERNAL_KEY env.
 *      Gán `req.isInternalCall = true`; req.auth KHÔNG được set (không có user context).
 *   C. Không có cả hai             → 401.
 */
export const requireGatewayOrInternalKey = (
    req: Request,
    res: Response,
    next: NextFunction
): void | Response => {
    const rawToken   = req.headers['x-gateway-token']
    const internalKey = req.headers['x-internal-key']

    // --- Luồng A: Gateway Token ---
    if (rawToken && typeof rawToken === 'string') {
        // Delegate hoàn toàn cho requireGateway của package (verify ES256, iss, aud, TTL)
        // Cast to any giải quyết dual @types/express version mismatch (package vs service)
        return (requireGateway as any)(req, res, next)
    }

    // --- Luồng B: Internal Service Key ---
    if (isValidInternalKey(internalKey)) {
        // Đánh dấu đây là call nội bộ để các middleware downstream xử lý phù hợp
        ;(req as any).isInternalCall = true
        return next()
    }

    // --- Luồng C: Không có credential hợp lệ ---
    return res.status(401).json({
        success: false,
        error: {
            code: 'UNAUTHORIZED',
            message: 'Yêu cầu phải được xác thực qua API Gateway (x-gateway-token) hoặc Internal Key (x-internal-key).',
        },
    })
}
</file>

<file path="services/wallet-service/src/middlewares/requestId.ts">
// requestId.ts — chỉ đảm nhiệm gán request ID và đánh dấu loại request.
// userId/role KHÔNG được đọc từ header nữa; sau khi requireGateway chạy xong,
// controller dùng req.auth.userId và req.auth.role trực tiếp.

import { Request, Response, NextFunction } from 'express'
import { randomUUID } from 'crypto'

export interface RequestWithContext extends Request {
    requestId?: string
    isInternalCall?: boolean
}

export function attachRequestId(req: RequestWithContext, res: Response, next: NextFunction) {
    const incomingId = req.headers['x-request-id'] as string
    const requestId  = incomingId || randomUUID()
    req.requestId    = requestId
    res.setHeader('X-Request-Id', requestId)

    // isInternalCall đã được set bởi requireGatewayOrInternalKey (Luồng B).
    // Nếu middleware đó chưa chạy, mặc định là false.
    if (req.isInternalCall === undefined) {
        req.isInternalCall = false
    }

    next()
}
</file>

<file path="services/wallet-service/src/middlewares/requireOwnerOrAdmin.ts">
// requireOwnerOrAdmin.ts
// Đảm bảo người dùng chỉ có thể tác động lên ví của chính mình, trừ khi là ADMIN
// hoặc là call nội bộ từ service (isInternalCall = true).
//
// Đọc userId và role từ req.auth (do requireGateway inject), KHÔNG đọc từ header.

import { Request, Response, NextFunction } from 'express'
import { RequestWithContext } from './requestId'

export const requireOwnerOrAdmin = (req: RequestWithContext, res: Response, next: NextFunction) => {
    // Call nội bộ từ service (payment-service → wallet-service), cho phép qua
    if (req.isInternalCall) {
        return next()
    }

    // Đọc danh tính từ req.auth (đã được requireGateway verify bằng ES256)
    const auth = req.auth
    if (!auth) {
        return res.status(401).json({
            success: false,
            error: { code: 'UNAUTHORIZED', message: 'Missing authentication context' },
        })
    }

    const requesterId = auth.userId
    const requesterRole = auth.role

    // Lấy target userId từ params hoặc body
    const targetUserId = req.params.userId || (req.body && req.body.userId)

    if (targetUserId && requesterId !== targetUserId && requesterRole !== 'ADMIN') {
        return res.status(403).json({
            success: false,
            error: { code: 'FORBIDDEN', message: 'You are not authorized to perform this action' },
        })
    }

    next()
}
</file>

