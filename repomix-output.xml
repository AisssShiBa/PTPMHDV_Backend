import { env } from '../config/env'
import { KycReviewDto, PageResponse } from '../types'
import { AuditService } from './auditService'

export interface UserKycRecord {
  id: string
  authUserId: string
  email: string
  fullName: string | null
  phone: string | null
  address: string | null
  kycStatus: 'NONE' | 'PENDING' | 'APPROVED' | 'REJECTED'
  idNumber: string | null
  idImageUrl: string | null
  createdAt: string
  updatedAt: string
}

export interface KycListParams {
  page?: number
  limit?: number
  search?: string
  status?: 'NONE' | 'PENDING' | 'APPROVED' | 'REJECTED'
}

export class KycService {
  /**
   * Lấy danh sách hồ sơ KYC từ user-service
   */
  static async getKycList(
    params: KycListParams,
    requestId: string
  ): Promise<PageResponse<UserKycRecord>> {
    const page = params.page || 1
    const limit = params.limit || 10
    const search = params.search || ''

    const url = new URL(`${env.userServiceUrl}/api/users`)
    url.searchParams.set('page', String(page))
    url.searchParams.set('limit', String(limit))
    if (search) url.searchParams.set('search', search)

    try {
      const res = await fetch(url.toString(), {
        method: 'GET',
        headers: {
          'x-request-id': requestId,
          'x-internal-key': env.internalKey,
          'x-user-role': 'ADMIN'
        },
        signal: AbortSignal.timeout(2000) // Timeout 2s theo chuẩn quy định
      })

      if (!res.ok) {
        throw new Error(`user-service phản hồi lỗi HTTP ${res.status}: ${res.statusText}`)
      }

      const json = await res.json()
      let data: PageResponse<UserKycRecord> = json.data

      // Nếu client yêu cầu lọc theo status cụ thể (ví dụ: PENDING)
      if (params.status && data?.content) {
        const filtered = data.content.filter(u => u.kycStatus === params.status)
        return {
          ...data,
          content: filtered,
          totalElements: filtered.length,
          totalPages: Math.ceil(filtered.length / limit) || 1
        }
      }

      return data
    } catch (err: any) {
      // NẾU LÀ PRODUCTION: Tuyệt đối không trả mock dữ liệu người dùng
      if (env.isProduction) {
        console.error(`[KYC ERROR] Không thể lấy danh sách người dùng từ user-service: ${err.message}`)
        throw new Error(`Dịch vụ user-service không phản hồi hoặc đã quá thời gian chờ (timeout 2s). Lỗi: ${err.message}`)
      }

      // MÔI TRƯỜNG DEV: Cảnh báo rõ ràng và trả mock để tiếp tục thử nghiệm
      console.warn(
        `[MOCK FALLBACK] user-service (${url.toString()}) không phản hồi (Lỗi: ${err.message}). Đang trả dữ liệu KYC giả lập cho môi trường DEV!`
      )

