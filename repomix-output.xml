  validateRequest(signUpSchema),
  signUp
)

// 2. Đăng nhập hệ thống (Có giới hạn tần suất và validate dữ liệu)
router.post(
  '/signin',
  rateLimiter(15 * 60 * 1000, 30),
  validateRequest(signInSchema),
  signIn
)

// 3. Làm mới Access Token
