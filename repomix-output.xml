<file path="services/payment-service/src/jobs/outbox.job.ts">
import cron from 'node-cron'
import { createSingleFlight } from 'finvault-events'
import { OutboxEventStatus } from '../utils/enums'
import { prisma } from '../utils/prisma'
import { NotificationClient } from '../clients/notification.client'
import { publish } from '../utils/rabbitmq.publisher'
import { createPaymentFinvaultPublisher } from '../events/finvault.publisher'
import { claimPaymentOutboxEvents } from './payment-outbox-claim'
import { paymentRetryDelayMs, processPaymentOutboxEvent } from './payment-outbox-event'

const legacyRoutingKey = 'payment.notification'
const notificationClient = new NotificationClient()
const MAX_LEGACY_RETRIES = 10
let finvaultPublisher: ReturnType<typeof createPaymentFinvaultPublisher> | undefined

const getFinvaultPublisher = () => {
  if (!finvaultPublisher) finvaultPublisher = createPaymentFinvaultPublisher()
  return finvaultPublisher
}

function legacyMessage(eventType: string, payload: Record<string, unknown>): string | undefined {
  if (eventType === 'PAYMENT_REFUNDED') {
    return `Thanh toán đã được hoàn tiền ${String(payload.amount ?? '')} VND.`
  }
  if (eventType === 'PAYMENT_CANCELLED') return 'Thanh toán đã bị hủy.'
  return undefined
}

async function updateClaimed(
  id: string,
  lockToken: string,
  data: Parameters<typeof prisma.outboxEvent.updateMany>[0]['data']
): Promise<void> {
  await prisma.outboxEvent.updateMany({
    where: { id, status: OutboxEventStatus.PROCESSING, lockToken },
    data: { ...data, lockedUntil: null, lockToken: null }
  })
}

async function processClaimedEvent(id: string, lockToken: string): Promise<void> {
  const event = await prisma.outboxEvent.findFirst({
    where: { id, status: OutboxEventStatus.PROCESSING, lockToken }
  })
  if (!event) return

  const payload = event.payload as Record<string, unknown>
  const finvaultResult = await processPaymentOutboxEvent(event, {
    publish: finvaultEvent => getFinvaultPublisher().publish(finvaultEvent),
    markSent: () => updateClaimed(id, lockToken, {
      status: OutboxEventStatus.SENT,
      sentAt: new Date()
    }),
    markFailed: () => updateClaimed(id, lockToken, {
      status: OutboxEventStatus.FAILED
    }),
    scheduleRetry: delayMs => updateClaimed(id, lockToken, {
      status: OutboxEventStatus.PENDING,
      retryCount: { increment: 1 },
      nextRetryAt: new Date(Date.now() + delayMs)
    })
  })
  if (finvaultResult !== 'unhandled') return

  const message = legacyMessage(event.eventType, payload)
  if (!message) {
    await updateClaimed(id, lockToken, {
      status: OutboxEventStatus.SENT,
      sentAt: new Date()
    })
    return
  }

  const userId = typeof payload.userId === 'string' ? payload.userId : ''
  if (!userId.trim()) {
    console.error('[Payment Outbox] Invalid legacy event data; marking row FAILED', {
      eventId: event.id,
      eventType: event.eventType
    })
    await updateClaimed(id, lockToken, { status: OutboxEventStatus.FAILED })
    return
  }

  const legacyPayload = { eventId: event.id, userId, type: event.eventType, message }
  let sent = false
  try {
    sent = await publish(
      'payment.events',
      (event.eventType === 'PAYMENT_EXPIRED' || event.eventType === 'payment.expired') ? 'payment.expired' : legacyRoutingKey,
      legacyPayload,
      { messageId: event.id }
    )
  } catch {
    sent = false
  }

  try {
    if (!sent) await notificationClient.send(userId, event.eventType, message, event.id)
    await updateClaimed(id, lockToken, {
      status: OutboxEventStatus.SENT,
      sentAt: new Date()
    })
  } catch (error) {
    const status = (error as { response?: { status?: number } }).response?.status
    const nextRetryCount = event.retryCount + 1
    console.error('[Payment Outbox] Legacy notification delivery failed', {
      eventId: event.id,
      eventType: event.eventType,
      status
    })
    if ((status !== undefined && status >= 400 && status < 500) ||
        nextRetryCount >= MAX_LEGACY_RETRIES) {
      await updateClaimed(id, lockToken, {
        status: OutboxEventStatus.FAILED,
        retryCount: nextRetryCount
      })
      return
    }

    await updateClaimed(id, lockToken, {
      status: OutboxEventStatus.PENDING,
      retryCount: nextRetryCount,
      nextRetryAt: new Date(Date.now() + paymentRetryDelayMs(event.retryCount))
    })
  }
}

async function drainPendingOutbox(): Promise<void> {
  const claimed = await claimPaymentOutboxEvents(prisma)
  for (const event of claimed) {
    try {
      // Publishing happens after the short claim transaction. If a worker dies,
      // the lease expires and the stable eventId permits safe at-least-once retry.
      await processClaimedEvent(event.id, event.lockToken)
    } catch (error) {
      console.error('[Payment Outbox] Claimed event processing failed', {
        eventId: event.id,
        error: error instanceof Error ? error.message : 'unknown error'
      })
      await updateClaimed(event.id, event.lockToken, {
        status: OutboxEventStatus.PENDING,
        retryCount: { increment: 1 },
        nextRetryAt: new Date(Date.now() + 1000)
      }).catch(updateError => {
        console.error('[Payment Outbox] Could not release failed event lease', {
          eventId: event.id,
          error: updateError instanceof Error ? updateError.message : 'unknown error'
        })
      })
    }
  }
}

const runDrain = createSingleFlight(drainPendingOutbox)

export function drainOutbox(): Promise<void> {
  return runDrain()
}

export async function closeFinvaultOutboxPublisher(): Promise<void> {
  const publisher = finvaultPublisher
  finvaultPublisher = undefined
  await publisher?.close()
}

export const startOutboxJob = () => {
  cron.schedule('*/1 * * * * *', () => {
    void drainOutbox().catch(error => {
      console.error('[Payment Outbox] Drain failed', error instanceof Error ? error.message : 'unknown error')
    })
  })
  void drainOutbox().catch(error => {
    console.error('[Payment Outbox] Initial drain failed', error instanceof Error ? error.message : 'unknown error')
  })
  console.log('Outbox Job started (runs every second)')
}
</file>

<file path="services/payment-service/src/jobs/payment-expiry.job.ts">
import { P2pService } from '../services/p2p.service';
import cron from 'node-cron';
import { OutboxEventStatus, PaymentStatus } from '../utils/enums';
import { prisma } from '../utils/prisma';
import { WalletClient } from '../clients/wallet.client';
import { randomUUID } from 'crypto';
import { drainOutbox } from './outbox.job';

export interface SweepExpiredPaymentsOptions {
  now?: Date;
  limit?: number;
  walletClient?: WalletClient;
  paymentId?: string;
}

export interface SweepExpiredPaymentsResult {
  scanned: number;
  expired: number;
  skipped: number;
  errors: number;
}

export async function sweepExpiredPayments(
  options?: SweepExpiredPaymentsOptions
): Promise<SweepExpiredPaymentsResult> {
  const now = options?.now || new Date();
  const limit = options?.limit || 50;
  const wallet = options?.walletClient || new WalletClient();

  const where: any = options?.paymentId
    ? { id: options.paymentId }
    : {
      status: PaymentStatus.PENDING,
      holdExpiresAt: { lte: now }
    };

  const expiredPayments = await prisma.payment.findMany({
    where,
    take: limit,
  });

  const scanned = expiredPayments.length;
  let expired = 0;
  let skipped = 0;
  let errors = 0;

  for (const payment of expiredPayments) {
    console.log(`[Scheduler] Payment ${payment.id} hold expired. Releasing...`);
    try {
      if (payment.holdId) {
        try {
          await wallet.releaseHold(payment.userId, payment.holdId);
        } catch (releaseErr: any) {
          // Nếu hold đã được ví nhả hoặc trả lỗi lũy đẳng (HOLD_EXPIRED / HOLD_NOT_CAPTURABLE)
          const isAlreadyHandled =
            releaseErr?.code === 'HOLD_EXPIRED' ||
            releaseErr?.code === 'HOLD_NOT_CAPTURABLE' ||
            releaseErr?.code === 'HOLD_ALREADY_RELEASED';
          if (!isAlreadyHandled) {
            throw releaseErr;
          }
        }
      }

      // Cập nhật có điều kiện: chỉ đổi PENDING -> EXPIRED
      const txResult = await prisma.$transaction(async tx => {
        const updateResult = await tx.payment.updateMany({
          where: {
            id: payment.id,
            status: PaymentStatus.PENDING
          },
          data: {
            status: PaymentStatus.EXPIRED,
            workflow: 'IDLE'
          }
        });

        // Chỉ khi update thành công (đang là PENDING) mới ghi history và outbox event đúng 1 lần
        if (updateResult.count === 1) {
          await tx.paymentHistory.create({
            data: {
              id: randomUUID(),
              paymentId: payment.id,
              fromStatus: PaymentStatus.PENDING,
              toStatus: PaymentStatus.EXPIRED,
              note: 'Hold expired by scheduler',
            }
          });

          const eventId = randomUUID();
          await tx.outboxEvent.create({
            data: {
              id: eventId,
              aggregateId: payment.id,
              eventType: 'payment.expired',
              topic: payment.callbackTopic || 'finvault.events',
              payload: {
                eventId,
                eventType: 'payment.expired',
                eventVersion: 1,
                occurredAt: new Date().toISOString(),
                data: {
                  paymentId: payment.id,
                  senderId: payment.userId
                }
              },
              status: OutboxEventStatus.PENDING,
            }
          });

          return { expired: true };
        }

        // Đã là EXPIRED hoặc tiến trình khác xử lý -> idempotent, không tạo outbox lần 2
        return { expired: false };
      });

      if (txResult.expired) {
        expired++;
        void drainOutbox().catch(error => {
          console.error('[Payment Outbox] Post-expiry drain failed', error instanceof Error ? error.message : 'unknown error');
        });
      } else {
        skipped++;
      }
    } catch (err: any) {
      errors++;
      console.error(`[Scheduler] Failed to process expired payment ${payment.id}:`, err?.message || String(err));
    }
  }

  return { scanned, expired, skipped, errors };
}

// Cron jobs định kỳ 30s/lần để kiểm tra và xử lý các giao dịch thanh toán (payment) đã hết hạn hold
export const startPaymentExpiryJob = () => {
  const walletClient = new WalletClient();
  const p2p = new P2pService(walletClient);
  let recovering = false;
  const recover = async () => {
    if (recovering) return;
    recovering = true;
    try { await p2p.recover(); await drainOutbox(); }
    catch { console.error('[Payment] Recovery will retry'); }
    finally { recovering = false; }
  };
  setInterval(() => void recover(), 2000);
  void recover();

  cron.schedule('*/30 * * * * *', async () => {
    try {
      await sweepExpiredPayments({ walletClient });
    } catch (error) {
      console.error('[Payment Expiration Scheduler Error]', error);
    }
  });
  console.log('Payment Expiry Job started (runs every 30 seconds)');
};
</file>

<file path="services/payment-service/src/server.ts">
import { transactionPublicKey } from './utils/transaction-token';
import 'dotenv/config';
import app from './app';
import { startPaymentExpiryJob } from './jobs/payment-expiry.job';
import { startOutboxJob } from './jobs/outbox.job';
import { startTopupExpiryJob } from './jobs/expireTopups.job';
import { startTokenCleanupJob } from './jobs/cleanup-tokens.job';
import { startRefundWorker } from './jobs/refund.worker';
import { startRecoverTopupsJob } from './funding/jobs/recoverTopups.job';
import { startRecoverCashoutsJob } from './funding/jobs/recoverCashouts.job';
import { closeRabbitMQ } from './utils/rabbitmq.publisher';
import { closeFinvaultOutboxPublisher } from './jobs/outbox.job';

transactionPublicKey();
const port = process.env.PORT || 3005;

const server = app.listen(port, () => {
  console.log(`Payment Service is running on port ${port}`);
  startPaymentExpiryJob();
  startOutboxJob();
  startTopupExpiryJob();
  startTokenCleanupJob();
  startRefundWorker();
  startRecoverTopupsJob();
  startRecoverCashoutsJob();
});

async function shutdown(signal: string) {
  console.log(`[Payment] Received ${signal}, shutting down gracefully...`);
  server.close();
  await closeFinvaultOutboxPublisher();
  await closeRabbitMQ();
  process.exit(0);
}

process.once('SIGTERM', () => void shutdown('SIGTERM'));
process.once('SIGINT', () => void shutdown('SIGINT'));
</file>

<file path="services/wallet-service/src/controllers/wallet.controller.ts">
import { Request, Response } from 'express';
import { WalletService } from '../services/wallet.service';
import { LedgerService } from '../services/ledger.service';
import { WalletHoldService } from '../services/wallet-hold.service';
import { decimalToString, walletView } from '../utils/wallet.helpers';
import { OwnerType } from '@prisma/client';
import { DomainException } from '../utils/domain.exception';

const walletService = new WalletService();
const ledgerService = new LedgerService();
const walletHoldService = new WalletHoldService(ledgerService);

export const create = async (req: Request, res: Response) => {
  const result = await walletService.createWallet(req.body);
  res.status(result.created ? 201 : 200).json({ success: true, data: { ...walletView(result.wallet), created: result.created } });
};

export const getMe = async (req: Request, res: Response) => {
  const auth = (req as any).auth;
  if (!auth?.userId) {
    console.warn(JSON.stringify({
      route: '/me',
      errorCode: 'UNAUTHORIZED',
      message: 'Missing authentication context',
    }));
    return res.status(401).json({
      success: false,
      error: { code: 'UNAUTHORIZED', message: 'Missing authentication context' },
    });
  }

  try {
    const wallet = await walletService.getBalance(auth.userId, OwnerType.USER);
    return res.json({
      success: true,
      data: {
        id: wallet.id,
        userId: wallet.userId,
        balance: decimalToString(wallet.balance),
        heldBalance: decimalToString(wallet.heldBalance),
        availableBalance: decimalToString(wallet.balance.sub(wallet.heldBalance)),
        currency: wallet.currency,
        status: wallet.status,
        createdAt: wallet.createdAt.toISOString(),
        updatedAt: wallet.updatedAt.toISOString(),
      },
    });
  } catch (err: any) {
    console.warn(JSON.stringify({
      route: '/me',
      userId: auth.userId,
      errorCode: err.code || 'UNKNOWN_ERROR',
      message: err.message,
    }));
    throw err;
  }
};

export const getMeLedger = async (req: Request, res: Response) => {
  const auth = (req as any).auth;
  if (!auth?.userId) {
    console.warn(JSON.stringify({
      route: '/me/ledger',
      errorCode: 'UNAUTHORIZED',
      message: 'Missing authentication context',
    }));
    return res.status(401).json({
      success: false,
      error: { code: 'UNAUTHORIZED', message: 'Missing authentication context' },
    });
  }

  let limit = 20;
  if (req.query.limit !== undefined) {
    const rawLimit = Number(req.query.limit);
    if (!Number.isInteger(rawLimit) || rawLimit <= 0) {
      console.warn(JSON.stringify({
        route: '/me/ledger',
        userId: auth.userId,
        errorCode: 'INVALID_LIMIT',
        message: 'Limit must be a positive integer',
      }));
      throw new DomainException(400, 'INVALID_LIMIT', 'Limit phải là số nguyên dương');
    }
    limit = Math.min(rawLimit, 100);
  }

  const cursor = typeof req.query.cursor === 'string' && req.query.cursor.trim() !== ''
    ? req.query.cursor.trim()
    : undefined;

  try {
    const result = await walletService.getMeLedger(auth.userId, { cursor, limit });
    return res.json({
      success: true,
      data: result,
    });
  } catch (err: any) {
    console.warn(JSON.stringify({
      route: '/me/ledger',
      userId: auth.userId,
      errorCode: err.code || 'UNKNOWN_ERROR',
      message: err.message,
    }));
    throw err;
  }
};

