DO $$ BEGIN
  CREATE TYPE "CashOutStatus" AS ENUM ('REQUESTED', 'HOLDING', 'PAYOUT_PENDING', 'SUCCEEDED', 'FAILED');
EXCEPTION WHEN duplicate_object THEN NULL;
END $$;

CREATE TABLE IF NOT EXISTS "CashOut" (
    "id" UUID NOT NULL,
