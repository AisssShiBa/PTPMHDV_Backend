<file path="services/wallet-service/prisma/schema.prisma">
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OwnerType {
  USER
  MERCHANT
  SYSTEM
}

enum WalletStatus {
  ACTIVE
  LOCKED
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum TransferType {
  TOPUP
  PAYMENT
  REFUND
  P2P_TRANSFER
  ADJUSTMENT
}

enum HoldStatus {
  PENDING
  CAPTURED
  RELEASED
  EXPIRED
}

enum SystemWalletCode {
  MAIN
  FEE
  TOPUP_POOL
}

model Wallet {
  id            Int               @id @default(autoincrement())
  userId        String?           @db.VarChar(50)
  ownerType     OwnerType
  systemCode    SystemWalletCode? @unique
  balance       Decimal           @default(0) @db.Decimal(20, 2)
  heldBalance   Decimal           @default(0) @db.Decimal(20, 2)
  currency      String            @default("VND") @db.VarChar(3)
  status        WalletStatus      @default(ACTIVE)
  kycTier       Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  ledgerEntries      LedgerEntry[]
  holdsAsSource      WalletHold[] @relation("HoldSource")
  holdsAsDestination WalletHold[] @relation("HoldDestination")

  @@unique([userId, ownerType])
  @@index([ownerType])
  @@index([ownerType, status])
}

model WalletInbox {
  eventId String @id
  payloadHash String
  processedAt DateTime @default(now())
}

model WalletOutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  topic       String    @db.VarChar(100)
  payload     Json
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
  attempts    Int       @default(0)

  @@index([publishedAt, createdAt])
}

model LedgerEntry {
  id            BigInt          @id @default(autoincrement())
  transactionId String          @db.Uuid
  walletId      Int
  direction     LedgerDirection
  amount        Decimal         @db.Decimal(20, 2)
  balanceAfter  Decimal         @db.Decimal(20, 2)
  referenceId   String          @db.VarChar(255)
  transferType  TransferType
  note          String?         @db.VarChar(500)
  createdAt     DateTime        @default(now())
  wallet        Wallet          @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@unique([walletId, referenceId])
  @@index([transactionId])
  @@index([walletId, createdAt])
}

model WalletHold {
  id            String     @id @default(uuid()) @db.Uuid
  sourceWalletId      Int
  destinationWalletId Int?
  amount              Decimal    @db.Decimal(20, 2)
  referenceId         String     @db.VarChar(255)
  status              HoldStatus @default(PENDING)
  transactionId       String?    @db.Uuid
  usageDay            String?    @db.VarChar(10)
  expiresAt           DateTime
  createdAt           DateTime   @default(now())
  sourceWallet        Wallet     @relation("HoldSource", fields: [sourceWalletId], references: [id], onDelete: Restrict)
  destinationWallet   Wallet?    @relation("HoldDestination", fields: [destinationWalletId], references: [id], onDelete: SetNull)

  @@unique([sourceWalletId, referenceId])
  @@index([status, expiresAt])
  @@index([destinationWalletId])
}

model LimitPolicy {
  kycTier   Int      @id
  perTxn    Decimal  @db.Decimal(20, 2)
  perDay    Decimal  @db.Decimal(20, 2)
  perMonth  Decimal  @db.Decimal(20, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserDailyUsage {
  id        BigInt   @id @default(autoincrement())
  userId    String   @db.VarChar(50)
  day       String   @db.VarChar(10)
  monthKey  String   @db.VarChar(7)
  spentDay  Decimal  @default(0) @db.Decimal(20, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, day])
  @@index([userId, monthKey])
}

enum AnomalyType {
  NEGATIVE_BALANCE
  BALANCE_DRIFT_QUICK
  BALANCE_DRIFT_FULL
  TRANSACTION_UNBALANCED
}

model ReconciliationReport {
  id                    Int      @id @default(autoincrement())
  runAt                 DateTime @default(now())
  totalWallets          Int
  anomaliesFound        Int
  systemBalanceExpected Decimal  @db.Decimal(20, 2)
  systemBalanceActual   Decimal  @db.Decimal(20, 2)
  isBalanced            Boolean

  anomalies ReconciliationAnomaly[]

  @@index([runAt])
}

model ReconciliationAnomaly {
  id            BigInt      @id @default(autoincrement())
  reportId      Int
  type          AnomalyType
  walletId      Int?
  transactionId String?     @db.Uuid
  detail        Json

  report ReconciliationReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([type])
  @@index([walletId])
}
</file>

<file path="services/wallet-service/src/controllers/wallet.controller.ts">
import { Request, Response } from 'express';
import { WalletService } from '../services/wallet.service';
import { LedgerService } from '../services/ledger.service';
import { WalletHoldService } from '../services/wallet-hold.service';
import { decimalToString, walletView } from '../utils/wallet.helpers';
import { OwnerType } from '@prisma/client';

const walletService = new WalletService();
const ledgerService = new LedgerService();
const walletHoldService = new WalletHoldService(ledgerService);

export const create = async (req: Request, res: Response) => {
  const result = await walletService.createWallet(req.body);
  res.status(result.created ? 201 : 200).json({ success: true, data: { ...walletView(result.wallet), created: result.created } });
};

export const getBalance = async (req: Request, res: Response) => {
  const userId = req.params.userId as string;
  const ownerType = (req.query.ownerType as string as OwnerType) || OwnerType.USER;
  const systemCode = req.query.systemCode as any;
  const wallet = await walletService.getBalance(userId, ownerType, systemCode);
  res.json({
    success: true, data: {
      balance: decimalToString(wallet.balance),
      heldBalance: decimalToString(wallet.heldBalance),
      availableBalance: decimalToString(wallet.balance.sub(wallet.heldBalance)),
      currency: wallet.currency,
      status: wallet.status,
    }
  });
};

export const hold = async (req: Request, res: Response) => {
  const userId = req.params.userId as string;
  const ownerType = (req.query.ownerType as string as OwnerType) || OwnerType.USER;
  const { amount, referenceId, expiresAt, destinationUserId, destinationOwnerType } = req.body;

  const { hold, replayed } = await walletHoldService.createHold(
    userId, amount, referenceId, expiresAt, ownerType, 
    destinationUserId, destinationOwnerType || OwnerType.USER
  );
  res.json({
    success: true, data: {
      id: hold.id,
      amount: decimalToString(hold.amount),
      referenceId: hold.referenceId,
      status: hold.status,
      expiresAt: hold.expiresAt.toISOString(),
      replayed,
    }
  });
};

export const capture = async (req: Request, res: Response) => {
  const userId = req.params.userId as string;
  const ownerType = (req.query.ownerType as string as OwnerType) || OwnerType.USER;
  const { referenceId } = req.body;
  const result = await walletHoldService.captureHold(userId, referenceId, ownerType);
  res.json({
    success: true, data: {
      balance: decimalToString(result.balance),
      transactionId: result.transactionId,
      replayed: result.replayed,
    }
  });
};

export const release = async (req: Request, res: Response) => {
  const userId = req.params.userId as string;
  const ownerType = (req.query.ownerType as string as OwnerType) || OwnerType.USER;
  const { referenceId } = req.body;
  const { hold, replayed } = await walletHoldService.releaseHold(userId, referenceId, ownerType);
  res.json({ success: true, data: { id: hold.id, status: hold.status, replayed } });
};

export const transfer = async (req: Request, res: Response) => {
  const fromUserId = req.params.userId as string;
  const result = await ledgerService.transfer({ fromUserId, ...req.body });
  res.json({
    success: true, data: {
      fromBalance: decimalToString(result.sourceWallet.balance),
      toBalance: decimalToString(result.destinationWallet.balance),
      transactionId: result.transactionId,
      replayed: result.replayed,
    }
  });
};

export const credit = async (req: Request, res: Response) => {
  const userId = req.params.userId as string;
  const ownerType = (req.query.ownerType as string as OwnerType) || OwnerType.USER;
  const result = await ledgerService.credit(userId, req.body, ownerType);
  res.json({
    success: true, data: {
      balance: decimalToString(result.destinationWallet.balance),
      transactionId: result.transactionId,
      replayed: result.replayed,
    }
  });
};

export const debit = async (req: Request, res: Response) => {
  const userId = req.params.userId as string;
  const ownerType = (req.query.ownerType as string as OwnerType) || OwnerType.USER;
  const result = await ledgerService.debit(userId, req.body, ownerType);
  res.json({
    success: true, data: {
      balance: decimalToString(result.sourceWallet.balance),
      transactionId: result.transactionId,
      replayed: result.replayed,
    }
  });
};

export const history = async (req: Request, res: Response) => {
  const userId = req.params.userId as string;
  const query: any = req.query;
  const result = await walletService.getHistory(userId, query);
  res.json({
    success: true, data: {
      items: result.entries.map((entry: any) => ({
        id: entry.id.toString(),
        transactionId: entry.transactionId,
        direction: entry.direction,
        amount: decimalToString(entry.amount),
        balanceAfter: decimalToString(entry.balanceAfter),
        referenceId: entry.referenceId,
        transferType: entry.transferType,
        note: entry.note,
        createdAt: entry.createdAt.toISOString(),
      })),
      total: result.total,
      page: result.page,
      limit: result.limit,
      from: result.from.toISOString(),
      to: result.to.toISOString(),
    }
  });
};
