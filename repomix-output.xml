<file path="services/user-service/src/services/kyc-tier.service.ts">
import { randomUUID } from 'node:crypto'
import { z } from 'zod'
import { Prisma, User } from '@prisma/client'
import { transaction } from '../utils/transaction'
import { HttpError } from '../utils/errors'

// Trusted domain operation only; profile/upload HTTP bodies cannot set this field.
export async function recordTierChange(tx: Prisma.TransactionClient, profile: User, previousTier: number) {
  if (profile.kycTier === previousTier) return
  const eventId = randomUUID()
  await tx.userOutboxEvent.create({ data: {
    id: eventId, aggregateId: profile.id, aggregateVersion: profile.version,
    eventType: 'user.kyc_updated',
    payload: {
      eventId, eventType: 'user.kyc_updated', eventVersion: 1, occurredAt: new Date().toISOString(),
      data: { authUserId: profile.authUserId, kycTier: profile.kycTier, previousTier }
    }
  } })
}

export async function updateKycTier(profileId: string, nextTier: number, requireApproved = false) {
  z.string().uuid().parse(profileId)
  z.number().int().min(0).max(2).parse(nextTier)
  return transaction(async tx => {
    const current = await tx.user.findFirst({ where: { id: profileId, deletedAt: null } })
    if (!current) throw new HttpError(404, 'NOT_FOUND', 'User not found')
    if (requireApproved && current.kycStatus !== 'APPROVED')
      throw new HttpError(409, 'KYC_NOT_APPROVED', 'Approve KYC before changing its tier')
    if (current.kycTier === nextTier) return current
    const profile = await tx.user.update({
      where: { id: profileId, deletedAt: null, version: current.version },
      data: { kycTier: nextTier, version: { increment: 1 } }
    })
    await recordTierChange(tx, profile, current.kycTier)
    return profile
  })
}
</file>

<file path="services/user-service/src/services/storage.ts">
import { S3Client, PutObjectCommand, DeleteObjectCommand, GetObjectCommand, HeadObjectCommand, ListObjectsV2Command } from '@aws-sdk/client-s3'
import { getSignedUrl } from '@aws-sdk/s3-request-presigner'
import { env } from '../config/env'
import { HttpError } from '../utils/errors'

function config(forSigning = false) {
  const { bucket, accessKeyId, secretAccessKey, publicEndpoint, ...options } = env.s3
  if (!bucket || !accessKeyId || !secretAccessKey) throw new HttpError(503, 'STORAGE_UNAVAILABLE', 'KYC storage is not configured')
  return { bucket, client: new S3Client({ ...options,
    endpoint: forSigning ? (publicEndpoint || options.endpoint) : options.endpoint,
    credentials: { accessKeyId, secretAccessKey }, maxAttempts: 2 }) }
}
export const storage = {
  async assertExists(key: string) {
    const { bucket, client } = config()
    try { await client.send(new HeadObjectCommand({ Bucket: bucket, Key: key }), { abortSignal: AbortSignal.timeout(15000) }) }
    finally { client.destroy() }
  },
  async *listKyc(): AsyncGenerator<{ key: string; lastModified?: Date }> {
    const { bucket, client } = config()
    try {
      let token: string | undefined
      do {
        const page = await client.send(new ListObjectsV2Command({
          Bucket: bucket, Prefix: 'kyc/', MaxKeys: 1000, ContinuationToken: token
        }), { abortSignal: AbortSignal.timeout(15000) })
        for (const object of page.Contents || []) {
          if (object.Key) yield { key: object.Key, lastModified: object.LastModified }
        }
        const next = page.IsTruncated ? page.NextContinuationToken : undefined
        if (page.IsTruncated && (!next || next === token)) throw new Error('Invalid storage continuation token')
        token = next
      } while (token)
    } finally { client.destroy() }
  },
  async put(key: string, body: Buffer) {
    const { bucket, client } = config()
    try { await client.send(new PutObjectCommand({ Bucket: bucket, Key: key, Body: body, ContentType: 'image/jpeg' }), { abortSignal: AbortSignal.timeout(15000) }) }
    finally { client.destroy() }
  },
  async remove(key: string) {
    const { bucket, client } = config()
    try { await client.send(new DeleteObjectCommand({ Bucket: bucket, Key: key }), { abortSignal: AbortSignal.timeout(15000) }) }
    finally { client.destroy() }
  },
  async url(key: string, expiresIn = env.kycUrlTtlSeconds) {
    const { bucket, client } = config(true)
    try { return await getSignedUrl(client, new GetObjectCommand({ Bucket: bucket, Key: key, ResponseCacheControl: 'no-store' }), { expiresIn }) }
    finally { client.destroy() }
  }
}
</file>

<file path="services/user-service/src/services/user.service.ts">
import { Prisma, User as UserProfile } from '@prisma/client'
import { prisma } from '../config/prisma'
import { HttpError } from '../utils/errors'
import { transaction } from '../utils/transaction'
import { recordTierChange } from './kyc-tier.service'

export function findProfileByAuthUserId(authUserId: string): Promise<UserProfile> {
  return findProfile({ authUserId })
}

// Legacy /:id routes accept either ID. Keep ambiguity detection for compatibility.
export function resolveProfileByIdOrAuthUserId(profileIdOrAuthUserId: string): Promise<UserProfile> {
  return findProfile({ OR: [{ id: profileIdOrAuthUserId }, { authUserId: profileIdOrAuthUserId }] })
}

async function findProfile(where: Prisma.UserWhereInput): Promise<UserProfile> {
  const matches = await prisma.user.findMany({
    where,
    take: 2
  })
  // Include tombstones in ambiguity detection; never resolve an identifier to another account.
  if (matches.length > 1) throw new HttpError(409, 'AMBIGUOUS_IDENTIFIER', 'Use the explicit by-auth endpoint')
  const profile = matches[0]
  if (!profile || profile.deletedAt) throw new HttpError(404, 'NOT_FOUND', 'User not found')
  return profile
}

export function userResponse(profile: UserProfile) {
  const { kycObjectKey, kycBackObjectKey, idImageUrl, ...data } = profile
  return { ...data, hasKycDocument: Boolean(kycObjectKey) }
}
export async function provisionProfile(tx: Prisma.TransactionClient, authUserId: string, email: string) {
  const existing = await tx.user.findUnique({ where: { authUserId } })
  if (existing) {
    if (existing.deletedAt || existing.email !== email) throw new HttpError(409, 'PROFILE_CONFLICT', 'Profile conflicts with registration')
    return existing
  }
  const duplicate = await tx.user.findUnique({ where: { email } })
  if (duplicate) throw new HttpError(409, 'PROFILE_CONFLICT', 'Email belongs to another profile')
  return tx.user.create({ data: { authUserId, email } })
}
export async function setKycStatus(profile: UserProfile, status: UserProfile['kycStatus']) {
  if (profile.kycStatus === status) return profile
  const transitions: Record<UserProfile['kycStatus'], UserProfile['kycStatus'][]> = {
    NONE: [], PENDING: ['APPROVED', 'REJECTED'], APPROVED: ['REJECTED'], REJECTED: []
  }
  if (!transitions[profile.kycStatus].includes(status)) throw new HttpError(409, 'INVALID_TRANSITION', 'Invalid KYC status transition')
  if (status === 'APPROVED' && (!profile.kycObjectKey || !profile.kycBackObjectKey || !profile.idNumber))
    throw new HttpError(409, 'KYC_DOCUMENTS_REQUIRED', 'Both uploaded KYC images are required before approval')
  const profileId = profile.id
  return transaction(async tx => {
    const result = await tx.user.updateMany({
      where: { id: profileId, version: profile.version, deletedAt: null },
      data: { kycStatus: status, kycTier: status === 'APPROVED' ? 1 : status === 'REJECTED' ? 0 : profile.kycTier,
        version: { increment: 1 } }
    })
    if (result.count !== 1) throw new HttpError(409, 'CONCURRENT_UPDATE', 'Profile changed; reload and retry')
    const updated = await tx.user.findUniqueOrThrow({ where: { id: profileId } })
    await recordTierChange(tx, updated, profile.kycTier)
    return updated
  })
}
</file>

