    "fetch('http://127.0.0.1:'+process.env.PORT+'/health').then(r=>{if(!r.ok)process.exit(1);console.log('ok')}).catch(()=>process.exit(1))"), 'ok')
}
for (const service of ['auth-service', 'admin-service', 'user-service']) {
