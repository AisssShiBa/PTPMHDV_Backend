<file path="services/merchant-service/prisma/schema.prisma">
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Merchant {
  // Merchant record ID; distinct from the owner's Auth ID.
  id           String         @id @default(uuid())
  // Owner's auth-service.User.id, NOT user-service.User.id (profile ID).
  ownerId      String         @unique @map("owner_id")
  businessName String         @map("business_name")
  taxId        String?        @map("tax_id")
  bankAccount  String?        @map("bank_account")
  status       MerchantStatus @default(PENDING)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  deletedAt    DateTime?      @map("deleted_at")
  version      Int            @default(1)
  outlets      Outlet[]
  apiKeys      MerchantApiKey[]

  @@index([status])
  @@index([ownerId])
  @@map("merchants")
}

model Outlet {
  id         String   @id @default(uuid())
  merchantId String   @map("merchant_id")
  name       String
  // Globally unique: a scanned QR resolves an outlet without merchant context.
  code       String   @unique
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  @@index([merchantId])
  @@map("outlets")
}

model MerchantApiKey {
  id         String    @id @default(uuid())
  merchantId String    @map("merchant_id")
  keyId      String    @unique @map("key_id")
  // Public, non-secret display/log fragment of the secret.
  prefix     String
  // SHA-256 of the secret; the raw value is never persisted.
  secretHash String    @map("secret_hash")
  revokedAt  DateTime? @map("revoked_at")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  merchant   Merchant  @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  @@index([merchantId, revokedAt])
  @@map("merchant_api_keys")
}

enum MerchantStatus {
  PENDING
  APPROVED
  REJECTED
}

model MerchantOutboxEvent {
  id String @id @default(uuid())
  aggregateId String @map("aggregate_id")
  aggregateVersion Int @map("aggregate_version")
  eventType String @map("event_type")
  payload Json
  status String @default("PENDING")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at")
  lockedUntil DateTime? @map("locked_until")
  lockToken String? @map("lock_token")
  lastError String? @map("last_error")
  createdAt DateTime @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")
  @@index([status, nextAttemptAt])
  @@unique([aggregateId, aggregateVersion])
  @@map("merchant_outbox_events")
}
</file>

<file path="services/merchant-service/scripts/init-broker.cjs">
const amqp = require('amqplib')
async function main() {
  const connection = await amqp.connect(process.env.RABBITMQ_URL)
  try {
    const channel = await connection.createChannel()
    const exchange = process.env.EVENT_EXCHANGE || 'finvault.events'
    // Durable observation queue for local/demo deployment; not a business consumer.
    const queue = process.env.MERCHANT_EVENT_QUEUE || 'finvault.demo.merchant-events.v1'
    await channel.assertExchange(exchange, 'topic', { durable: true })
    // Provisioning must reach both durable queues even before either consumer starts.
    for (const subscriber of ['user-service.user-registered.v1', 'wallet-service.kyc-updated']) {
      await channel.assertQueue(subscriber, { durable: true })
      await channel.bindQueue(subscriber, exchange, 'user.registered')
    }
    await channel.assertQueue(queue, { durable: true })
    for (const key of ['merchant.registered', 'merchant.status_updated', 'merchant.profile_updated'])
      await channel.bindQueue(queue, exchange, key)
    await channel.close()
    console.log('Merchant event bindings ready')
  } finally { await connection.close() }
}
main().catch(() => { console.error('BROKER_INIT_FAILED'); process.exitCode = 1 })
