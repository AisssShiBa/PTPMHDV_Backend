<file path="services/utilities-service/src/services/recoveryService.ts">
import { prisma } from '../config/prisma'
import type { PaymentClient, ProviderClient } from '../types/utility'
import {
  fulfillPaidOrder,
  retryRefund,
  settleProviderOutcome
} from './fulfillmentService'
import { transitionOrder } from './orderService'

export const CHECKOUT_STALE_MS = 120_000
export const RECOVERY_BATCH_SIZE = 20

export type RecoveryDependencies = {
  paymentClient: PaymentClient
  providerClient: ProviderClient
}

export type RecoverySummary = {
  paidRetried: number
  providerChecked: number
  abandonedCheckouts: number
  refundsRetried: number
}

// Safe to run on several instances: every state change is a conditional
// updateMany, so only one worker wins each claim.
export async function runRecoveryOnce(
  dependencies: RecoveryDependencies,
  now: Date,
  staleMs: number
): Promise<RecoverySummary> {
  const stale = new Date(now.getTime() - staleMs)
  const summary: RecoverySummary = {
    paidRetried: 0,
    providerChecked: 0,
    abandonedCheckouts: 0,
    refundsRetried: 0
  }

  const paid = await prisma.utilityOrder.findMany({
    where: { status: 'PAID', updatedAt: { lt: stale } },
    orderBy: { updatedAt: 'asc' },
    take: RECOVERY_BATCH_SIZE
  })
  for (const order of paid) {
    const before = await prisma.utilityOrder.findUnique({ where: { id: order.id } })
    if (before?.status !== 'PAID') continue
    await fulfillPaidOrder(order.id, dependencies.providerClient, dependencies.paymentClient)
    summary.paidRetried += 1
  }

  const providerPending = await prisma.utilityOrder.findMany({
    where: { status: 'PROVIDER_PENDING', updatedAt: { lt: stale } },
    orderBy: { updatedAt: 'asc' },
    take: RECOVERY_BATCH_SIZE
  })
  for (const order of providerPending) {
    const current = await prisma.utilityOrder.findUnique({ where: { id: order.id } })
    if (current?.status !== 'PROVIDER_PENDING') continue
    const outcome = await dependencies.providerClient.getStatus(order.id)
    await settleProviderOutcome(current, outcome, dependencies.paymentClient)
    summary.providerChecked += 1
  }

  const abandonedBefore = new Date(now.getTime() - CHECKOUT_STALE_MS)
  const abandoned = await prisma.utilityOrder.findMany({
    where: {
      status: 'PENDING_PAYMENT',
      paymentId: null,
      createdAt: { lt: abandonedBefore }
    },
    select: { id: true },
    take: RECOVERY_BATCH_SIZE
  })
  for (const { id } of abandoned) {
    const changed = await transitionOrder(
      id,
      ['PENDING_PAYMENT'],
      'FAILED',
      'CHECKOUT_NOT_CREATED',
      { failureReason: 'CHECKOUT_NOT_CREATED' }
    )
    if (changed) summary.abandonedCheckouts += 1
  }

  const refunds = await prisma.utilityOrder.findMany({
    where: { status: 'REFUND_REQUESTED', refundAttempts: { lt: 5 }, updatedAt: { lt: stale } },
    select: { id: true },
    take: RECOVERY_BATCH_SIZE
  })
  for (const { id } of refunds) {
    await retryRefund(id, dependencies.paymentClient)
    summary.refundsRetried += 1
  }

  return summary
}

export type RecoveryJob = { stop(): void }

export function createRecoveryJob(
  dependencies: RecoveryDependencies,
  options: { enabled: boolean; intervalMs: number; staleMs: number; log?: (message: string) => void }
): RecoveryJob | undefined {
  if (!options.enabled) return undefined
  let running = true
  let timer: NodeJS.Timeout | undefined

  const tick = async () => {
    if (!running) return
    try {
      const summary = await runRecoveryOnce(dependencies, new Date(), options.staleMs)
      const touched =
        summary.paidRetried + summary.providerChecked + summary.abandonedCheckouts + summary.refundsRetried
      if (touched > 0) {
        ;(options.log ?? console.log)(
          `[Utilities recovery] ${JSON.stringify(summary)}`
        )
      }
    } catch (error) {
      console.error('[Utilities recovery] sweep failed', error)
    } finally {
      if (running) timer = setTimeout(tick, options.intervalMs)
    }
  }

  timer = setTimeout(tick, options.intervalMs)
  timer.unref?.()

  return {
    stop() {
      running = false
      if (timer) clearTimeout(timer)
    }
  }
}
</file>

<file path="services/utilities-service/src/services/utilityEventsConsumer.ts">
import { createConsumer, type EventConsumer, type FinvaultEvent } from 'finvault-events'
import { env } from '../config/env'
import { prisma } from '../config/prisma'
import { createUtilityInbox, type UtilityTransactionContext } from './utilityInbox'
import { fulfillPaidOrder } from './fulfillmentService'
import type { PaymentClient, ProviderClient } from '../types/utility'

export const utilityEventQueue = 'utilities.finvault.events'
export const utilityEventBindings = [
  'payment.succeeded',
  'payment.failed',
  'payment.expired'
] as const

export type UtilityEventDependencies = {
  paymentClient: PaymentClient
  providerClient: ProviderClient
}

const paymentIdFrom = (event: FinvaultEvent): string | undefined => {
  const data = event.data
  if (typeof data !== 'object' || data === null) return undefined
  const paymentId = (data as Record<string, unknown>).paymentId
  return typeof paymentId === 'string' && paymentId.length > 0 ? paymentId : undefined
}

export async function handleUtilityEvent(
  event: FinvaultEvent,
  context: { tx: unknown },
  dependencies: UtilityEventDependencies
): Promise<void> {
  const transaction = context.tx as UtilityTransactionContext
  const paymentId = paymentIdFrom(event)
  if (!paymentId) return

  const order = await transaction.prisma.utilityOrder.findUnique({ where: { paymentId } })
  // Payments that do not belong to a utilities order are acknowledged and
  // ignored; they are not errors and must not be retried forever.
  if (!order) return

  if (event.eventType === 'payment.succeeded') {
    const updated = await transaction.prisma.utilityOrder.updateMany({
      where: { id: order.id, status: 'PENDING_PAYMENT' },
      data: { status: 'PAID' }
    })
    if (updated.count === 0) return
    await transaction.prisma.utilityOrderHistory.create({
      data: {
        orderId: order.id,
        fromStatus: 'PENDING_PAYMENT',
        toStatus: 'PAID',
        note: 'PAYMENT_SUCCEEDED'
      }
    })
    transaction.afterCommit(() =>
      fulfillPaidOrder(order.id, dependencies.providerClient, dependencies.paymentClient)
    )
    return
  }

  const reason = event.eventType === 'payment.failed' ? 'PAYMENT_FAILED' : 'PAYMENT_EXPIRED'
  const updated = await transaction.prisma.utilityOrder.updateMany({
    where: { id: order.id, status: 'PENDING_PAYMENT' },
    data: { status: 'FAILED', failureReason: reason }
  })
  if (updated.count > 0) {
    await transaction.prisma.utilityOrderHistory.create({
      data: {
        orderId: order.id,
        fromStatus: 'PENDING_PAYMENT',
        toStatus: 'FAILED',
        note: reason
      }
    })
  }
}

export function createUtilityEventsConsumer(
  url: string,
  dependencies: UtilityEventDependencies,
  queue = utilityEventQueue
): EventConsumer {
  return createConsumer({
    url,
    queue,
    exchange: 'finvault.events',
    bindings: [...utilityEventBindings],
    logger: {
      info: (message, context) => console.info(`[Utilities events] ${message}`, context)
    },
    inbox: createUtilityInbox(prisma),
    handlers: {
      'payment.succeeded': (event, context) =>
        handleUtilityEvent(event, context, dependencies),
      'payment.failed': (event, context) => handleUtilityEvent(event, context, dependencies),
      'payment.expired': (event, context) => handleUtilityEvent(event, context, dependencies)
    }
  })
}

export type UtilityConsumerSupervisor = {
  whenStarted: Promise<boolean>
  stop(): Promise<void>
}

export function startUtilityEventsConsumer(
  dependencies: UtilityEventDependencies,
  url: string | undefined = env.rabbitmqUrl
): UtilityConsumerSupervisor | undefined {
  if (!url) {
    console.log('Utilities FinVault consumer disabled: RABBITMQ_URL is not configured')
    return undefined
  }

  let running = true
  let consumer: EventConsumer | undefined
  let resolveStarted!: (value: boolean) => void
  const whenStarted = new Promise<boolean>(resolve => {
    resolveStarted = resolve
  })

  const runner = (async () => {
    let attempt = 0
    while (running) {
      try {
        const candidate = createUtilityEventsConsumer(url, dependencies)
        await candidate.start()
        if (!running) {
          await candidate.stop()
          break
        }
        consumer = candidate
        resolveStarted(true)
        console.log(`Utilities events consumer started for ${utilityEventBindings.join(', ')}`)
        return
      } catch (error) {
        console.error('[Utilities events] Consumer startup failed; retrying', error)
        attempt += 1
        const waitMs = Math.min(30_000, 1000 * 2 ** Math.min(attempt, 5))
        await new Promise<void>(resolve => setTimeout(resolve, waitMs))
      }
    }
    resolveStarted(false)
  })()

  return {
    whenStarted,
    async stop() {
      running = false
      if (consumer) await consumer.stop()
      await runner
    }
  }
}
</file>

<file path="services/utilities-service/src/services/utilityInbox.ts">
import type { InboxAdapter, InboxResult } from 'finvault-events'
import type { Prisma, PrismaClient } from '@prisma/client'
import { prisma } from '../config/prisma'

export type UtilityTransactionContext = {
  prisma: Prisma.TransactionClient
  afterCommit(callback: () => void | Promise<void>): void
}

export function createUtilityInbox(database: PrismaClient = prisma): InboxAdapter {
  return {
    async runOnce<T>(
      args: { eventId: string; eventType: string; payloadHash: string },
      handler: (tx: unknown) => Promise<T>
    ): Promise<InboxResult<T>> {
      const afterCommit: Array<() => void | Promise<void>> = []
      const result = await database.$transaction(async transaction => {
        const inserted = await transaction.$executeRaw`
          INSERT INTO "utility_inbox" ("event_id", "event_type", "payload_hash")
          VALUES (${args.eventId}, ${args.eventType}, ${args.payloadHash})
          ON CONFLICT ("event_id") DO NOTHING
        `

        if (inserted === 0) {
          const rows = await transaction.$queryRaw<Array<{ payload_hash: string }>>`
            SELECT "payload_hash"
            FROM "utility_inbox"
            WHERE "event_id" = ${args.eventId}
          `
          const existing = rows[0]
          if (!existing) throw new Error('Utility inbox row missing after conflict')
          return existing.payload_hash === args.payloadHash
            ? { status: 'duplicate' as const }
            : { status: 'conflict' as const }
        }

        const context: UtilityTransactionContext = {
          prisma: transaction,
          afterCommit: callback => afterCommit.push(callback)
        }
        return { status: 'processed' as const, result: await handler(context) }
      })

      if (result.status === 'processed') {
        for (const callback of afterCommit) {
          try {
            await callback()
          } catch (error) {
            console.error('[Utilities] after-commit callback failed', {
              eventId: args.eventId,
              error
            })
          }
        }
      }

      return result
    }
  }
}
