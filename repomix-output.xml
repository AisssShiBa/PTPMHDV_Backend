<file path="services/notification-service/src/services/financeEventsConsumer.ts">
import { createConsumer, type EventConsumer, type FinvaultEvent } from 'finvault-events'
import type { Notification } from '@prisma/client'
import { env } from '../config/env'
import { prisma } from '../config/prisma'
import { notificationIO } from '../socket'
import { createFinanceEventsInbox, type FinanceTransactionContext } from './financeEventsInbox'
import {
  mapFinanceEventToNotifications,
  paymentCounterpartyIds,
  type FinanceNotificationDraft
} from './financeEventMapping'
import { createUserLookupClient, type UserLookupClient } from './userLookup'

export const financeEventQueue = 'notification.finvault.events'
export const financeEventBindings = [
  'user.registered',
  'user.kyc_updated',
  'merchant.status_updated',
  'payment.succeeded',
  'payment.failed',
  'payment.expired'
] as const

const ignoredEventTypes = ['user.registered', 'merchant.status_updated']
const retryInitialDelayMs = 2000
const retryMaxDelayMs = 30_000

export interface FinanceConsumerSupervisor {
  whenStarted: Promise<boolean>
  stop(): Promise<void>
}

interface FinanceConsumerRetryOptions {
  url: string
  createConsumer(url: string): EventConsumer
  initialDelayMs?: number
  maxDelayMs?: number
  sleep?(milliseconds: number, signal: AbortSignal): Promise<void>
  logError?(message: string, error: unknown): void
  logStarted?(): void
}

const abortableDelay = (milliseconds: number, signal: AbortSignal): Promise<void> =>
  new Promise((resolve, reject) => {
    if (signal.aborted) {
      resolve()
      return
    }
    const timer = setTimeout(() => {
      signal.removeEventListener('abort', onAbort)
      resolve()
    }, milliseconds)
    const onAbort = () => {
      clearTimeout(timer)
      signal.removeEventListener('abort', onAbort)
      resolve()
    }
    signal.addEventListener('abort', onAbort, { once: true })
  })

export function startFinanceEventsConsumerWithRetry(
  options: FinanceConsumerRetryOptions
): FinanceConsumerSupervisor {
  const initialDelayMs = options.initialDelayMs ?? retryInitialDelayMs
  const maxDelayMs = options.maxDelayMs ?? retryMaxDelayMs
  if (!Number.isInteger(initialDelayMs) || initialDelayMs < 1 ||
      !Number.isInteger(maxDelayMs) || maxDelayMs < initialDelayMs) {
    throw new TypeError('Consumer retry delays must be positive integers with max >= initial')
  }

  const controller = new AbortController()
  let running = true
  let activeConsumer: EventConsumer | undefined
  let retryCount = 0
  let resolveStarted!: (started: boolean) => void
  const whenStarted = new Promise<boolean>(resolve => { resolveStarted = resolve })

  const runner = (async () => {
    while (running) {
      let candidate: EventConsumer | undefined
      try {
        candidate = options.createConsumer(options.url)
        await candidate.start()
        if (!running) {
          await candidate.stop()
          break
        }
        activeConsumer = candidate
        options.logStarted?.()
        resolveStarted(true)
        return
      } catch (error) {
        options.logError?.('Consumer startup failed; retrying', error)
        if (candidate) {
          try {
            await candidate.stop()
          } catch (stopError) {
            options.logError?.('Failed to close consumer after startup error', stopError)
          }
        }
        if (!running) break
        const waitMs = Math.min(maxDelayMs, initialDelayMs * 2 ** Math.min(retryCount, 30))
        retryCount += 1
        try {
          await (options.sleep ?? abortableDelay)(waitMs, controller.signal)
        } catch (sleepError) {
          if (running) options.logError?.('Consumer retry wait failed', sleepError)
        }
      }
    }
    resolveStarted(false)
  })()

  return {
    whenStarted,
    async stop() {
      running = false
      controller.abort()
      const consumer = activeConsumer
      activeConsumer = undefined
      if (consumer) await consumer.stop()
      await runner
    }
  }
}
const userLookup = createUserLookupClient({
  baseUrl: env.userLookupUrl,
  internalKey: env.internalKey,
  timeoutMs: 1500,
  cacheTtlMs: 60_000,
  maxCacheEntries: 1000,
  logFailure: (code, userId) => {
    console.warn('[User lookup] Enrichment unavailable', { code, userId })
  }
})

export interface FinanceEventsConsumerDependencies {
  userLookup?: UserLookupClient
  updateNotification?(
    id: string,
    message: string
  ): Promise<Notification>
}

export function createFinanceEventsConsumer(
  url: string,
  queue = financeEventQueue,
  dependencies: FinanceEventsConsumerDependencies = {}
): EventConsumer {
  const lookup = dependencies.userLookup ?? userLookup
  const updateNotification = dependencies.updateNotification ?? ((id: string, message: string) =>
    prisma.notification.update({ where: { id }, data: { message } }))
  return createConsumer({
    url,
    queue,
    exchange: 'finvault.events',
    bindings: [...financeEventBindings],
    ignoredEventTypes,
    allowLegacyKycUpdated: true,
    logger: {
      info: (message, context) => console.info(`[FinVault events] ${message}`, context)
    },
    inbox: createFinanceEventsInbox(prisma),
    handlers: {
      'user.kyc_updated': (event, context) =>
        persistEventNotifications(event, context, lookup, updateNotification),
      'payment.succeeded': (event, context) =>
        persistEventNotifications(event, context, lookup, updateNotification),
      'payment.failed': (event, context) =>
        persistEventNotifications(event, context, lookup, updateNotification),
      'payment.expired': (event, context) =>
        persistEventNotifications(event, context, lookup, updateNotification)
    }
  })
}

async function persistEventNotifications(
  event: FinvaultEvent,
  context: { tx: unknown },
  userLookup: UserLookupClient,
  updateNotification: (id: string, message: string) => Promise<Notification>
): Promise<void> {
  const transaction = context.tx as FinanceTransactionContext
  const drafts = mapFinanceEventToNotifications(event)
  const created: Array<{ draft: FinanceNotificationDraft; notification: Notification }> = []

  for (const draft of drafts) {
    const notification = await transaction.prisma.notification.create({
      data: {
        eventId: event.eventId,
        userId: draft.userId,
        type: draft.type,
        message: draft.message
      }
    })
    created.push({ draft, notification })
  }

  transaction.afterCommit(async () => {
    let notifications = created.map(item => item.notification)
    if (event.eventType === 'payment.succeeded') {
      const ids = [...new Set(paymentCounterpartyIds(event))]
      const fullNames = await Promise.all(ids.map(id => userLookup.getFullName(id)))
      const names = new Map<string, string>()
      fullNames.forEach((fullName, index) => {
        if (fullName) names.set(ids[index], fullName)
      })
      const enriched = mapFinanceEventToNotifications(event, names)
      notifications = await Promise.all(created.map(async item => {
        const replacement = enriched.find(draft => draft.userId === item.draft.userId)
        if (!replacement || replacement.message === item.notification.message) return item.notification
        try {
          return await updateNotification(item.notification.id, replacement.message)
        } catch (error) {
          console.error('[Notification] Could not persist enriched payment message', {
            eventId: event.eventId,
            userId: item.draft.userId,
            error
          })
          return item.notification
        }
      }))
    }

    for (const notification of notifications) {
      try {
        notificationIO?.to(`user:${notification.userId}`).emit('notification:new', notification)
      } catch (error) {
        console.error('[Socket] Could not emit finance notification', {
          eventId: event.eventId,
          userId: notification.userId,
          error
        })
      }
    }
  })
}

export function startFinanceEventsConsumer(): FinanceConsumerSupervisor | undefined {
  if (!env.rabbitmqUrl) {
    console.log('FinVault events consumer disabled: RABBITMQ_URL is not configured')
    return
  }

  console.info(
    '[FinVault events] Ignoring user.registered and merchant.status_updated: no notification recipient is defined'
  )
  if (!env.userLookupUrl) {
    console.info('[User lookup] USER_LOOKUP_URL is unset; payment notifications will use anonymous wording')
  }
  return startFinanceEventsConsumerWithRetry({
    url: env.rabbitmqUrl,
    createConsumer: url => createFinanceEventsConsumer(url),
    logError: (message, error) => console.error(`[FinVault events] ${message}`, error),
    logStarted: () => console.log(`FinVault events consumer started for ${financeEventBindings.join(', ')}`)
  })
}
</file>

<file path="services/notification-service/src/services/rabbitmqConsumer.ts">
import amqp, { type ConfirmChannel, type ConsumeMessage } from 'amqplib'
import { env } from '../config/env'
import { notificationIO } from '../socket'
import {
  ingestNotification,
  isNotificationType,
  NotificationIngestError,
  type NotificationTypeValue
} from './notificationService'

const exchanges = ['wallet.events', 'payment.events', 'kyc.events']
const deadLetterQueue = 'notification-service.dlq'
const deadLetterExchange = 'notification.dlx'
const maxRetries = 3

export type ParsedNotificationEvent = {
  eventId?: string
  userId: string
  type: NotificationTypeValue
  message: string
}

export type NotificationAmqpMessage = {
  content: Buffer
  properties: {
    messageId?: string
  }
}

export class InvalidNotificationEventError extends Error {
  constructor(message: string) {
    super(message)
    this.name = 'InvalidNotificationEventError'
  }
}

export type RetryDecision =
  | { action: 'retry'; retryCount: number }
  | { action: 'dead-letter' }

export const decideRetry = (retryCount: number): RetryDecision =>
  retryCount >= maxRetries
    ? { action: 'dead-letter' }
    : { action: 'retry', retryCount: retryCount + 1 }

const isRecord = (value: unknown): value is Record<string, unknown> =>
  typeof value === 'object' && value !== null && !Array.isArray(value)

export const parseEvent = (message: NotificationAmqpMessage): ParsedNotificationEvent => {
  let body: unknown
  try {
    body = JSON.parse(message.content.toString()) as unknown
  } catch {
    throw new InvalidNotificationEventError('Invalid JSON notification event')
  }

  if (!isRecord(body)) {
    throw new InvalidNotificationEventError('Notification event must be an object')
  }

  const payload = isRecord(body.data)
    ? body.data
    : isRecord(body.payload)
      ? body.payload
      : body
  const eventId = body.eventId ?? message.properties.messageId
  const type = payload.type ?? body.eventType

  if (
    typeof payload.userId !== 'string' ||
    payload.userId.trim().length === 0 ||
    !isNotificationType(type) ||
    typeof payload.message !== 'string' ||
    (eventId !== undefined && (typeof eventId !== 'string' || eventId.trim().length === 0))
  ) {
    throw new InvalidNotificationEventError('Invalid notification event payload')
  }

  return {
    ...(eventId !== undefined ? { eventId } : {}),
    userId: payload.userId,
    type,
    message: payload.message
  }
}

const retryCountFrom = (message: ConsumeMessage): number => {
  const value = message.properties.headers?.['x-retry-count']
  if (typeof value === 'number' && Number.isInteger(value) && value >= 0) return value
  if (typeof value === 'string' && /^\d+$/.test(value)) return Number(value)
  return 0
}

const republishForRetry = (
  channel: ConfirmChannel,
  queueName: string,
  message: ConsumeMessage,
  nextRetryCount: number,
  source: string
) =>
  new Promise<void>((resolve, reject) => {
    channel.publish(
      '',
      queueName,
      message.content,
      {
        ...message.properties,
        headers: {
          ...message.properties.headers,
          'x-retry-count': nextRetryCount,
          'x-notification-source': source
        },
        persistent: true
      },
      (error) => (error ? reject(error) : resolve())
    )
  })

const deadLetter = (channel: ConfirmChannel, message: ConsumeMessage, reason: string) => {
  console.error(`[RabbitMQ] Đưa message từ ${message.fields.exchange} vào DLQ: ${reason}`)
  channel.nack(message, false, false)
}

const sourceFrom = (message: ConsumeMessage) => {
  const source = message.properties.headers?.['x-notification-source']
  return typeof source === 'string' ? source : message.fields.exchange
}

const handleMessage = async (
  channel: ConfirmChannel,
  queueName: string,
  message: ConsumeMessage
) => {
  let event: ParsedNotificationEvent
  try {
    event = parseEvent(message)
  } catch (error) {
    deadLetter(
      channel,
      message,
      error instanceof Error ? error.message : 'Invalid notification event'
    )
    return
  }

  try {
    const result = await ingestNotification({
      ...event,
      source: sourceFrom(message)
    })
    if (!result.duplicate && result.notification) {
      try {
        notificationIO?.to(`user:${event.userId}`).emit('notification:new', result.notification)
      } catch (error) {
        console.error('[Socket] Không thể gửi notification:new:', error)
      }
    }
    channel.ack(message)
  } catch (error) {
    if (
      error instanceof NotificationIngestError &&
      (error.code === 'EVENT_CONFLICT' || error.code === 'INVALID_NOTIFICATION')
    ) {
      deadLetter(channel, message, error.code)
      return
    }

    const retryCount = retryCountFrom(message)
    const decision = decideRetry(retryCount)
    if (decision.action === 'dead-letter') {
      deadLetter(channel, message, 'Maximum retry count exceeded')
      return
    }

    try {
      await republishForRetry(channel, queueName, message, decision.retryCount, sourceFrom(message))
      channel.ack(message)
    } catch (retryError) {
      console.error('[RabbitMQ] Không thể phát lại message để retry:', retryError)
      deadLetter(channel, message, 'Unable to republish for retry')
    }
  }
}

export const startRabbitMqConsumer = async () => {
  if (!env.rabbitmqUrl) {
    console.log('RabbitMQ consumer disabled: RABBITMQ_URL chưa được cấu hình')
    return
  }

  try {
    const connection = await amqp.connect(env.rabbitmqUrl)
    const channel = await connection.createConfirmChannel()

    await channel.assertExchange(deadLetterExchange, 'fanout', { durable: true })
    await channel.assertQueue(deadLetterQueue, { durable: true })
    await channel.bindQueue(deadLetterQueue, deadLetterExchange, '')

    for (const exchange of exchanges) {
      await channel.assertExchange(exchange, 'topic', { durable: true })
      // Legacy queues need to be deleted manually after consumers have moved to these versioned queues.
      const queue = await channel.assertQueue(`${env.rabbitmqQueue}.v2.${exchange}`, {
        durable: true,
        deadLetterExchange
      })
      await channel.bindQueue(queue.queue, exchange, '#')
      await channel.consume(queue.queue, async (message) => {
        if (!message) return
        try {
          await handleMessage(channel, queue.queue, message)
        } catch (error) {
          console.error('[RabbitMQ] Lỗi không mong đợi khi xử lý message:', error)
          channel.nack(message, false, false)
        }
      })
    }

    console.log(`RabbitMQ consumer started for: ${exchanges.join(', ')}`)
  } catch (error) {
    console.error('[RabbitMQ] Không thể khởi động consumer:', error)
  }
}
</file>

