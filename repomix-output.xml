import { PrismaClient } from '@prisma/client';

const prisma = new PrismaClient();

export async function seedLimitPolicies() {
  const policies = [
    { kycTier: 0, perTxn: '200000', perDay: '500000', perMonth: '2000000' },
    { kycTier: 1, perTxn: '10000000', perDay: '20000000', perMonth: '100000000' },
    { kycTier: 2, perTxn: '50000000', perDay: '100000000', perMonth: '500000000' },
  ];

  for (const p of policies) {
    await prisma.limitPolicy.upsert({
      where: { kycTier: p.kycTier },
      update: {
        perTxn: p.perTxn,
        perDay: p.perDay,
        perMonth: p.perMonth,
      },
      create: {
        kycTier: p.kycTier,
        perTxn: p.perTxn,
        perDay: p.perDay,
        perMonth: p.perMonth,
      },
    });
  }
  console.log('✅ Limit policies seeded successfully');
}

if (require.main === module) {
  seedLimitPolicies()
    .catch((e) => {
      console.error(e);
      process.exit(1);
    })
    .finally(async () => {
      await prisma.$disconnect();
    });
}
</file>

<file path="services/wallet-service/src/events/kyc.consumer.ts">
import { OwnerType, Prisma, PrismaClient } from '@prisma/client';
import { createConsumer, type EventConsumer, type InboxAdapter, type InboxResult } from 'finvault-events';
const prisma = new PrismaClient();
let consumer: EventConsumer | undefined;
let retry: NodeJS.Timeout | undefined;
let stopped = false;

export function walletInbox(database = prisma): InboxAdapter {
  return {
    async runOnce<T>(args: { eventId: string; payloadHash: string }, handler: (tx: unknown) => Promise<T>): Promise<InboxResult<T>> {
      return database.$transaction(async tx => {
        const inserted = await tx.$executeRaw`INSERT INTO "WalletInbox" ("eventId", "payloadHash")
          VALUES (${args.eventId}, ${args.payloadHash}) ON CONFLICT ("eventId") DO NOTHING`;
        if (!inserted) {
          const previous = await tx.walletInbox.findUniqueOrThrow({ where: { eventId: args.eventId } });
          return previous.payloadHash === args.payloadHash ? { status: 'duplicate' } : { status: 'conflict' };
        }
        return { status: 'processed', result: await handler(tx) };
      });
    }
  };
}

export async function startKycConsumer(): Promise<void> {
  if (stopped) return;
  const url = process.env.RABBITMQ_URL;
  if (!url) throw new Error('RABBITMQ_URL is required for Wallet provisioning');
  consumer = createConsumer({ url, queue: 'wallet-service.kyc-updated',
    exchange: process.env.EVENT_EXCHANGE || 'finvault.events',
    bindings: ['user.registered', 'user.kyc_updated', 'merchant.status_updated'],
    inbox: walletInbox(), handlers: {
      'user.registered': async (event, context) => {
        const tx = context.tx as Prisma.TransactionClient;
        const data = event.data as { authUserId: string };
        await tx.wallet.upsert({ where: { userId_ownerType: { userId: data.authUserId, ownerType: OwnerType.USER } },
          create: { userId: data.authUserId, ownerType: OwnerType.USER }, update: {} });
      },
      'user.kyc_updated': async (event, context) => {
        const tx = context.tx as Prisma.TransactionClient;
        const data = event.data as { authUserId: string; kycTier: number };
        await tx.wallet.upsert({ where: { userId_ownerType: { userId: data.authUserId, ownerType: OwnerType.USER } },
          create: { userId: data.authUserId, ownerType: OwnerType.USER, kycTier: data.kycTier },
          update: { kycTier: data.kycTier } });
      },
      'merchant.status_updated': async (event, context) => {
        const data = event.data as { merchantId: string; status: string };
        const tx = context.tx as Prisma.TransactionClient;
        if (data.status === 'APPROVED') await tx.wallet.upsert({
          where: { userId_ownerType: { userId: data.merchantId, ownerType: OwnerType.MERCHANT } },
          create: { userId: data.merchantId, ownerType: OwnerType.MERCHANT }, update: {} });
      }
    } });
  try { await consumer.start(); }
  catch {
    await consumer.stop().catch(() => {});
    if (!stopped) retry = setTimeout(() => void startKycConsumer(), 2000);
  }
}
export async function stopKycConsumer() {
  stopped = true;
  clearTimeout(retry);
  await consumer?.stop();
  await prisma.$disconnect();
}
</file>

<file path="services/wallet-service/src/middlewares/requireOwnerOrAdmin.ts">
// requireOwnerOrAdmin.ts
// Đảm bảo người dùng chỉ có thể tác động lên ví của chính mình, trừ khi là ADMIN
// hoặc là call nội bộ từ service (isInternalCall = true).
//
// Đọc userId và role từ req.auth (do requireGateway inject), KHÔNG đọc từ header.

import { Request, Response, NextFunction } from 'express'
import { RequestWithContext } from './requestId'

export const requireOwnerOrAdmin = (req: RequestWithContext, res: Response, next: NextFunction) => {
    // Call nội bộ từ service (payment-service → wallet-service), cho phép qua
    if (req.isInternalCall) {
        return next()
    }

    // Đọc danh tính từ req.auth (đã được requireGateway verify bằng ES256)
    const auth = req.auth
    if (!auth) {
        return res.status(401).json({
            success: false,
            error: { code: 'UNAUTHORIZED', message: 'Missing authentication context' },
        })
    }

    const requesterId = auth.userId
    const requesterRole = auth.role

    // Lấy target userId từ params hoặc body (với route /me và /me/ledger, luôn là chính người gọi)
    const isMeRoute = req.path === '/me' || req.path === '/me/ledger' || req.path.startsWith('/me/');
    const targetUserId = isMeRoute ? undefined : (req.params.userId || (req.body && req.body.userId))

    if (targetUserId && requesterId !== targetUserId && requesterRole !== 'ADMIN') {
        return res.status(403).json({
            success: false,
            error: { code: 'FORBIDDEN', message: 'You are not authorized to perform this action' },
        })
    }

    next()
}
</file>

<file path="services/wallet-service/src/services/limit.service.ts">
import { LimitPolicy, Prisma, PrismaClient } from '@prisma/client';
import { DomainException } from '../utils/domain.exception';
import { getVnDay, getVnMonthKey } from '../utils/timezone.helper';
import { decimalToString } from '../utils/wallet.helpers';

const prisma = new PrismaClient();

export interface LimitDetails {
  limitType: 'PER_TXN' | 'PER_DAY' | 'PER_MONTH';
  limit: string;
  used: string;
  remaining: string;
  kycTier: number;
}

export class LimitService {
  private policyCache = new Map<number, { policy: LimitPolicy; expiry: number }>();
  private readonly CACHE_TTL_MS = 60_000;

  async getPolicy(kycTier: number, client: Prisma.TransactionClient | PrismaClient = prisma): Promise<LimitPolicy> {
    const cached = this.policyCache.get(kycTier);
    if (cached && cached.expiry > Date.now()) {
      return cached.policy;
    }

    const policy = await client.limitPolicy.findUnique({
      where: { kycTier },
    });

    if (!policy) {
      throw new DomainException(
        400,
        'INVALID_KYC_TIER',
        `No limit policy found for KYC tier ${kycTier}`
      );
    }

    this.policyCache.set(kycTier, { policy, expiry: Date.now() + this.CACHE_TTL_MS });
    return policy;
  }

  clearCache() {
    this.policyCache.clear();
  }

  /**
   * checkAndReserve
   * Runs within an existing caller transaction.
   * Lock order: Caller MUST have locked Wallet first, then checkAndReserve locks UserDailyUsage.
   */
  async checkAndReserve(
    tx: Prisma.TransactionClient,
    userId: string,
    amount: Prisma.Decimal,
    kycTier: number,
    now: Date = new Date()
  ): Promise<{ usageDay: string }> {
    const policy = await this.getPolicy(kycTier, tx);

    // 1. Kiểm tra perTxn (chưa cần chạm DB)
    if (amount.gt(policy.perTxn)) {
      throw new DomainException(
        422,
        'LIMIT_EXCEEDED',
        `Giao dịch vượt hạn mức tối đa một lần (${decimalToString(policy.perTxn)} VND)`,
        {
          limitType: 'PER_TXN',
          limit: decimalToString(policy.perTxn),
          used: decimalToString(amount),
          remaining: decimalToString(policy.perTxn),
          kycTier,
        }
      );
    }

    const day = getVnDay(now);
    const monthKey = getVnMonthKey(now);

    // 2. INSERT ... ON CONFLICT (userId, day) DO NOTHING để đảm bảo row ngày hôm nay tồn tại
    await tx.$executeRaw`
      INSERT INTO "UserDailyUsage" ("userId", "day", "monthKey", "spentDay", "createdAt", "updatedAt")
      VALUES (${userId}, ${day}, ${monthKey}, 0, NOW(), NOW())
      ON CONFLICT ("userId", "day") DO NOTHING
    `;

    // 3. SELECT ... FOR UPDATE trên row đó để serialize các request cùng user cùng ngày
    const lockedRows = await tx.$queryRaw<{ spentDay: Prisma.Decimal }[]>`
      SELECT "spentDay"
      FROM "UserDailyUsage"
      WHERE "userId" = ${userId} AND "day" = ${day}
      FOR UPDATE
    `;

    if (!lockedRows || lockedRows.length === 0) {
      throw new DomainException(500, 'CONCURRENCY_ERROR', 'Failed to lock user daily usage row');
    }

    const currentSpentDay = new Prisma.Decimal(lockedRows[0].spentDay);

    // 4. Kiểm tra perDay
    const newSpentDay = currentSpentDay.add(amount);
    if (newSpentDay.gt(policy.perDay)) {
      const remaining = Prisma.Decimal.max(0, policy.perDay.sub(currentSpentDay));
      throw new DomainException(
        422,
        'LIMIT_EXCEEDED',
        `Giao dịch vượt hạn mức ngày (${decimalToString(policy.perDay)} VND)`,
        {
          limitType: 'PER_DAY',
          limit: decimalToString(policy.perDay),
          used: decimalToString(currentSpentDay),
          remaining: decimalToString(remaining),
          kycTier,
        }
      );
    }

    // 5. Kiểm tra perMonth qua SUM(spentDay) của monthKey
    // Vì row của ngày hôm nay đã được lock, tổng các ngày khác là tĩnh
    const monthSumResult = await tx.$queryRaw<{ total: Prisma.Decimal | null }[]>`
      SELECT COALESCE(SUM("spentDay"), 0) as total
      FROM "UserDailyUsage"
      WHERE "userId" = ${userId} AND "monthKey" = ${monthKey}
    `;

    const currentSpentMonth = new Prisma.Decimal(monthSumResult[0]?.total ?? 0);
    const newSpentMonth = currentSpentMonth.add(amount);

    if (newSpentMonth.gt(policy.perMonth)) {
      const remaining = Prisma.Decimal.max(0, policy.perMonth.sub(currentSpentMonth));
      throw new DomainException(
        422,
        'LIMIT_EXCEEDED',
        `Giao dịch vượt hạn mức tháng (${decimalToString(policy.perMonth)} VND)`,
        {
          limitType: 'PER_MONTH',
          limit: decimalToString(policy.perMonth),
          used: decimalToString(currentSpentMonth),
          remaining: decimalToString(remaining),
          kycTier,
        }
      );
    }

    // 6. UPDATE spentDay = spentDay + amount
    await tx.$executeRaw`
      UPDATE "UserDailyUsage"
      SET "spentDay" = "spentDay" + ${amount}, "updatedAt" = NOW()
      WHERE "userId" = ${userId} AND "day" = ${day}
    `;

    return { usageDay: day };
  }

  /**
   * refundUsage
   * Caller chịu trách nhiệm đảm bảo tính idempotent trước khi gọi hàm này.
   * Trừ spentDay đúng row usageDay. Không clamp im lặng: nếu sắp âm thì ném lỗi và rollback transaction.
   */
  async refundUsage(
    tx: Prisma.TransactionClient,
    userId: string,
    amount: Prisma.Decimal,
    usageDay: string
  ): Promise<void> {
    const rows = await tx.$queryRaw<Array<{ spentDay: Prisma.Decimal }>>`
      SELECT "spentDay"
      FROM "UserDailyUsage"
      WHERE "userId" = ${userId} AND "day" = ${usageDay}
      FOR UPDATE
    `;

    if (!rows || rows.length === 0) {
      throw new DomainException(
        400,
        'USAGE_ROW_NOT_FOUND',
        `No usage record found for user ${userId} on day ${usageDay}`
      );
    }

    const currentSpent = new Prisma.Decimal(rows[0].spentDay);
    if (currentSpent.lt(amount)) {
      throw new DomainException(
        400,
        'NEGATIVE_SPENT_DAY',
        `spentDay (${currentSpent.toString()}) would become negative if amount (${amount.toString()}) is refunded`
      );
    }

    await tx.$executeRaw`
      UPDATE "UserDailyUsage"
      SET "spentDay" = "spentDay" - ${amount}, "updatedAt" = NOW()
      WHERE "userId" = ${userId} AND "day" = ${usageDay}
    `;
  }
}
</file>

<file path="services/wallet-service/src/services/wallet-admin.service.ts">
import { LedgerDirection, OwnerType, PrismaClient, TransferType, WalletStatus } from "@prisma/client";
import { DomainException } from "../utils/domain.exception";
import { money } from "../utils/wallet.helpers";
import { LedgerService } from "./ledger.service";
import { AdjustDto } from "../dtos/wallet.dto";
import { drainOutbox } from "../jobs/outbox.scheduler";

const HttpStatus = { NOT_FOUND: 404 };
const prisma = new PrismaClient();

export class WalletAdminService {
  constructor(private readonly ledgerService: LedgerService) {}

  async adjust(userId: string, dto: AdjustDto, ownerType: OwnerType = OwnerType.USER) {
    const amount = money(dto.amount);
    const userIsSource = dto.direction === LedgerDirection.DEBIT;

    const result = await prisma.$transaction(async (tx) => {
      const userWallet = await this.ledgerService.findWalletTx(tx, userId, ownerType);
      const systemWallet = await this.ledgerService.getSystemWalletTx(tx);

      return await this.ledgerService.moveMoneyTxInternal(tx, {
        fromWallet: userIsSource ? userWallet : systemWallet,
        toWallet: userIsSource ? systemWallet : userWallet,
        amount,
        referenceId: dto.referenceId,
        transferType: TransferType.ADJUSTMENT,
        note: dto.reason,
        bypassLockedFrom: userIsSource,
      });
    });
    void drainOutbox().catch(error => {
      console.error("[Wallet Outbox] Post-commit drain failed", error instanceof Error ? error.message : "unknown error");
    });
    return result;
  }

  async setLock(userId: string, locked: boolean, ownerType: OwnerType = OwnerType.USER) {
    const status = locked ? WalletStatus.LOCKED : WalletStatus.ACTIVE;
    const wallet = await prisma.wallet.findFirst({ where: { userId, ownerType } });
    if (!wallet) throw new DomainException(HttpStatus.NOT_FOUND, "WALLET_NOT_FOUND", "Wallet was not found");

    return await prisma.wallet.update({
      where: { id: wallet.id },
      data: { status }
    });
  }
}
</file>

<file path="services/wallet-service/src/services/wallet.service.ts">
import { OwnerType, Prisma, PrismaClient, SystemWalletCode, WalletStatus } from "@prisma/client";
import { DomainException } from "../utils/domain.exception";
import { CreateWalletDto, HistoryQueryDto, ListWalletsDto } from "../dtos/wallet.dto";
import { decimalToString } from "../utils/wallet.helpers";
import { decodeCursor, encodeCursor, KeysetCursor } from "../utils/cursor.helper";

const HttpStatus = { NOT_FOUND: 404, BAD_REQUEST: 400, INTERNAL_SERVER_ERROR: 500 };
const prisma = new PrismaClient();

export class WalletService {
  constructor() {
    // System wallets are seeded via migration, no runtime creation
  }

  async createWallet(dto: CreateWalletDto) {
    const ownerType = dto.ownerType ?? OwnerType.USER;
    if (ownerType === OwnerType.SYSTEM) {
      throw new DomainException(HttpStatus.BAD_REQUEST, "INVALID_OWNER_TYPE", "SYSTEM wallets are managed by wallet-service only");
    }

    return await prisma.$transaction(async (tx) => {
      const existing = await tx.wallet.findUnique({
        where: { userId_ownerType: { userId: dto.userId, ownerType } }
      });
      if (existing) {
        return { wallet: existing, created: false };
      }

      const wallet = await tx.wallet.create({
        data: {
          userId: dto.userId,
          ownerType,
          currency: dto.currency ?? "VND",
          status: WalletStatus.ACTIVE,
        }
      });
      return { wallet, created: true };
    });
  }

  async getBalance(userId: string, ownerType: OwnerType = OwnerType.USER, systemCode?: SystemWalletCode) {
    let where: Prisma.WalletWhereInput;
    if (systemCode) {
      where = { systemCode };
    } else {
      where = { userId, ownerType };
    }

    const wallet = await prisma.wallet.findFirst({
      where
    });
    if (!wallet) throw new DomainException(HttpStatus.NOT_FOUND, "WALLET_NOT_FOUND", "Wallet was not found");
    return wallet;
  }

  async getHistory(userId: string, query: HistoryQueryDto) {
    const ownerType = query.ownerType ?? OwnerType.USER;
    const wallet = await prisma.wallet.findFirst({ where: { userId, ownerType } });
    if (!wallet) throw new DomainException(HttpStatus.NOT_FOUND, "WALLET_NOT_FOUND", "Wallet was not found");

    const to = query.to ? new Date(query.to) : new Date();
    const from = query.from ? new Date(query.from) : new Date(to.getTime() - 30 * 24 * 60 * 60 * 1000);
    const page = query.page ?? 1;
    const limit = query.limit ?? 20;

    const [entries, total] = await Promise.all([
      prisma.ledgerEntry.findMany({
        where: {
          walletId: wallet.id,
          createdAt: { gte: from, lte: to }
        },
        orderBy: { id: 'desc' },
        skip: (page - 1) * limit,
        take: limit,
      }),
      prisma.ledgerEntry.count({
        where: {
          walletId: wallet.id,
          createdAt: { gte: from, lte: to }
        }
      })
    ]);

    const serializedEntries = entries.map(e => ({
      ...e,
      id: e.id.toString(),
    }));

    return { entries: serializedEntries, total, page, limit, from, to };
  }

  async listWallets(query: ListWalletsDto) {
    const page = query.page ?? 1;
    const limit = query.limit ?? 20;

    const where: any = {};
    if (query.userId) where.userId = query.userId;
    if (query.ownerType) where.ownerType = query.ownerType;
    if (query.status) where.status = query.status;

    const [wallets, total] = await Promise.all([
      prisma.wallet.findMany({
        where,
        skip: (page - 1) * limit,
        take: limit,
      }),
      prisma.wallet.count({ where })
    ]);

    return { wallets, total, page, limit };
  }

  async getMeLedger(userId: string, options: { cursor?: string; limit?: number }) {
    const wallet = await prisma.wallet.findFirst({
      where: { userId, ownerType: OwnerType.USER },
    });
    if (!wallet) {
      throw new DomainException(HttpStatus.NOT_FOUND, "WALLET_NOT_FOUND", "Wallet was not found");
    }

    let parsedCursor: KeysetCursor | undefined;
    if (options.cursor) {
      parsedCursor = decodeCursor(options.cursor);
    }

    const limit = options.limit ?? 20;

    const where: Prisma.LedgerEntryWhereInput = {
      walletId: wallet.id,
      ...(parsedCursor
        ? {
            OR: [
              { createdAt: { lt: parsedCursor.createdAt } },
              {
                AND: [
                  { createdAt: parsedCursor.createdAt },
                  { id: { lt: parsedCursor.id } },
                ],
              },
            ],
          }
        : {}),
    };

    const entries = await prisma.ledgerEntry.findMany({
      where,
      orderBy: [
        { createdAt: 'desc' },
        { id: 'desc' },
      ],
      take: limit + 1,
    });

    const hasNextPage = entries.length > limit;
    const items = hasNextPage ? entries.slice(0, limit) : entries;
    const nextCursor = hasNextPage && items.length > 0
      ? encodeCursor(items[items.length - 1])
      : null;

    return {
      items: items.map((entry) => ({
        id: entry.id.toString(),
        transactionId: entry.transactionId,
        direction: entry.direction,
        amount: decimalToString(entry.amount),
        balanceAfter: decimalToString(entry.balanceAfter),
        referenceId: entry.referenceId,
        transferType: entry.transferType,
        note: entry.note,
        createdAt: entry.createdAt.toISOString(),
      })),
      nextCursor,
    };
  }

}
</file>

<file path="services/wallet-service/src/utils/cursor.helper.ts">
import { DomainException } from './domain.exception';

export interface KeysetCursor {
  createdAt: Date;
  id: bigint;
}

export function encodeCursor(entry: { createdAt: Date; id: bigint | string | number }): string {
  const payload = JSON.stringify({
    createdAt: entry.createdAt.toISOString(),
    id: entry.id.toString(),
  });
  return Buffer.from(payload, 'utf-8').toString('base64url');
}

export function decodeCursor(cursorStr: string): KeysetCursor {
  try {
    const jsonStr = Buffer.from(cursorStr, 'base64url').toString('utf-8');
    const parsed = JSON.parse(jsonStr);
    if (!parsed || typeof parsed !== 'object') {
      throw new Error('Invalid cursor object');
    }
    const { createdAt, id } = parsed;
    if (!createdAt || typeof createdAt !== 'string' || id === undefined || id === null) {
      throw new Error('Missing cursor fields');
    }
    const date = new Date(createdAt);
    if (isNaN(date.getTime())) {
      throw new Error('Invalid date in cursor');
    }
    if (typeof id !== 'string' && typeof id !== 'number') {
      throw new Error('Invalid id type');
    }
    if (typeof id === 'string' && !/^\d+$/.test(id)) {
      throw new Error('Invalid numeric id in cursor');
    }
    const bigintId = BigInt(id);
    return { createdAt: date, id: bigintId };
  } catch (err: any) {
    throw new DomainException(400, 'INVALID_CURSOR', 'Cursor phân trang không hợp lệ');
  }
}
</file>

