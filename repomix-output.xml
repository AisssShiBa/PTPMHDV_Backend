import { prisma } from '../config/prisma'
import { env } from '../config/env'
import { AdminAuditLogRecord, PageResponse } from '../types'

export type LogActionParams = {
  adminId: string
  action: string
  targetId: string
  detail?: string | null
}

export type GetAuditLogsParams = {
  page?: number
  limit?: number
  action?: string
  adminId?: string
  targetId?: string
}

// Bộ nhớ tạm thời fallback cho môi trường Dev khi PostgreSQL chưa bật
const inMemoryAuditLogs: AdminAuditLogRecord[] = []

/**
 * Service kiểm toán viết bằng CONST OBJECT cơ bản (KHÔNG DÙNG CLASS)
 */
export const AuditService = {
  /**
   * 1. Ghi nhận một hành động của Quản trị viên vào bảng AdminAuditLog
   */
  logAction: async (params: LogActionParams) => {
    const { adminId, action, targetId, detail } = params

    try {
      const record = await prisma.adminAuditLog.create({
        data: {
          adminId,
          action,
          targetId,
          detail: detail || null
        }
      })
      console.log(`[AUDIT LOG SUCCESS] [${action}] Admin: ${adminId} -> Target: ${targetId}`)
      return { success: true, data: record }
    } catch (err: any) {
      // Ghi log nghiêm trọng mức CRITICAL ra hệ thống giám sát
      console.error(
        `[CRITICAL AUDIT FAILURE] Không thể ghi nhật ký kiểm toán vào database!`,
        { adminId, action, targetId, detail, error: err?.message || err }
      )

      // Trong môi trường development, lưu tạm vào in-memory để phục vụ xem lại ngay trong phiên test
      if (!env.isProduction) {
        const fallbackRecord: AdminAuditLogRecord = {
          id: 'mock-audit-' + Date.now(),
          adminId,
          action,
          targetId,
          detail: (detail || '') + ' (Lưu bộ nhớ tạm do DB offline)',
          createdAt: new Date()
        }
        inMemoryAuditLogs.unshift(fallbackRecord)
        console.warn(`[MOCK FALLBACK] Đã lưu audit log tạm thời vào in-memory array (chỉ áp dụng ở môi trường DEV).`)
      }

      // Trả về success: false để bên gọi biết và báo cảnh báo thích hợp
      return { success: false, error: err }
    }
  },

  /**
   * 2. Truy vấn danh sách lịch sử thao tác của các Quản trị viên
   */
  getLogs: async (params: GetAuditLogsParams): Promise<PageResponse<AdminAuditLogRecord>> => {
    const page = Math.max(1, params.page || 1)
    const limit = Math.max(1, Math.min(100, params.limit || 10))
    const skip = (page - 1) * limit

    const whereClause: any = {}
    if (params.action) whereClause.action = params.action
    if (params.adminId) whereClause.adminId = params.adminId
    if (params.targetId) whereClause.targetId = params.targetId

    try {
      const [logs, totalElements] = await Promise.all([
        prisma.adminAuditLog.findMany({
          where: whereClause,
          skip,
          take: limit,
          orderBy: { createdAt: 'desc' }
        }),
        prisma.adminAuditLog.count({ where: whereClause })
      ])

      const totalPages = Math.ceil(totalElements / limit) || 1

      return {
        content: logs,
        page,
        limit,
        totalElements,
        totalPages
      }
    } catch (err: any) {
      if (env.isProduction) {
        throw new Error(`Không thể kết nối cơ sở dữ liệu để truy vấn Audit Logs: ${err.message}`)
      }

      console.warn(`[MOCK FALLBACK] PostgreSQL không phản hồi khi đọc audit logs, đang trả dữ liệu từ in-memory fallback!`)

      const filtered = inMemoryAuditLogs.filter(item => {
        if (params.action && item.action !== params.action) return false
        if (params.adminId && item.adminId !== params.adminId) return false
        if (params.targetId && item.targetId !== params.targetId) return false
        return true
      })

      const paginated = filtered.slice(skip, skip + limit)
      const totalPages = Math.ceil(filtered.length / limit) || 1

      return {
        content: paginated,
        page,
        limit,
        totalElements: filtered.length,
        totalPages,
        isMockData: true,
        warning: 'Dữ liệu audit logs đang được lấy từ bộ nhớ giả lập do database admin_service offline'
      }
    }
  },

  /**
   * 3. Đếm tổng số log và thống kê hoạt động trong ngày hôm nay
   */
  getStats: async () => {
    try {
      const todayStart = new Date()
      todayStart.setHours(0, 0, 0, 0)

      const [totalLogs, todayActionsCount, recentActivities] = await Promise.all([
        prisma.adminAuditLog.count(),
        prisma.adminAuditLog.count({
          where: {
            createdAt: { gte: todayStart }
          }
        }),
        prisma.adminAuditLog.findMany({
          take: 5,
          orderBy: { createdAt: 'desc' }
        })
      ])

      return {
        totalLogs,
        todayActionsCount,
        recentActivities,
        isMockData: false
      }
    } catch {
      if (env.isProduction) {
        throw new Error('Không thể thống kê Audit Logs từ cơ sở dữ liệu')
      }

      console.warn(`[MOCK FALLBACK] DB offline khi thống kê Audit logs, sử dụng in-memory logs fallback.`)
      return {
        totalLogs: inMemoryAuditLogs.length,
        todayActionsCount: inMemoryAuditLogs.length,
        recentActivities: inMemoryAuditLogs.slice(0, 5),
        isMockData: true
      }
    }
  }
}
</file>

