<file path="services/notification-service/src/controllers/notificationController.ts">
import { Request, Response } from 'express'
import { prisma } from '../config/prisma'
import { notificationIO } from '../socket'
import {
  ingestNotification,
  isNotificationType,
  NotificationIngestError
} from '../services/notificationService'
import { issueSocketTicket, SocketTicketRateLimitError } from '../socket'
import { DEVICE_ID_PATTERN, findDevice } from '../services/deviceService'

export const getSocketTicket = async (req: Request, res: Response) => {
  const userId = req.auth?.userId
  if (!userId) {
    return res.status(401).json({
      success: false,
      error: { code: 'INVALID_GATEWAY_TOKEN', message: 'Gateway Token không hợp lệ hoặc đã hết hạn.' }
    })
  }

  const rawDeviceId = req.query.deviceId
  let deviceId: string | undefined
  if (rawDeviceId !== undefined) {
    if (typeof rawDeviceId !== 'string' || rawDeviceId.length > 128 ||
        !DEVICE_ID_PATTERN.test(rawDeviceId)) {
      return res.status(400).json({
        success: false,
        error: { code: 'VALIDATION_ERROR', message: 'deviceId không hợp lệ.' }
      })
    }
    deviceId = rawDeviceId
    const device = await findDevice(userId, deviceId)
    if (!device) {
      return res.status(404).json({
        success: false,
        error: { code: 'NOT_FOUND', message: 'Không tìm thấy thiết bị.' }
      })
    }
    if (device.revokedAt !== null) {
      return res.status(403).json({
        success: false,
        error: { code: 'DEVICE_REVOKED', message: 'Thiết bị đã bị thu hồi.' }
      })
    }
  }

  let ticket: ReturnType<typeof issueSocketTicket>
  try {
    ticket = issueSocketTicket(userId, deviceId)
  } catch (error) {
    if (error instanceof SocketTicketRateLimitError) {
      return res.status(429).json({
        success: false,
        error: { code: 'RATE_LIMITED', message: 'Quá nhiều yêu cầu cấp socket ticket.' }
      })
    }
    throw error
  }
  return res.status(200).json({
    success: true,
    data: ticket
  })
}

// ===================================================================
// INTERNAL — chỉ Outbox Scheduler của Payment/Wallet gọi (POST /)
// ===================================================================
export const createNotification = async (req: Request, res: Response) => {
  try {
    const { eventId, userId, type, message } = req.body
    if (
      typeof userId !== 'string' ||
      userId.trim().length === 0 ||
      !isNotificationType(type) ||
      typeof message !== 'string' ||
      (eventId !== undefined && (typeof eventId !== 'string' || eventId.trim().length === 0))
    ) {
      return res.status(400).json({
        success: false,
        error: { code: 'BAD_REQUEST', message: 'userId, type và message hợp lệ là bắt buộc' }
      })
    }

    const result = await ingestNotification({ eventId, userId, type, message, source: 'http' })
    if (result.duplicate) {
      return res.status(200).json({ success: true, data: null, duplicate: true })
    }
    if (result.notification) {
      try {
        notificationIO?.to(`user:${userId}`).emit('notification:new', result.notification)
      } catch (error) {
        console.error('[Socket] Không thể gửi notification:new:', error)
      }
    }
    return res.status(201).json({
      success: true,
      data: result.notification
    })
  } catch (error) {
    if (error instanceof NotificationIngestError && error.code === 'EVENT_CONFLICT') {
      return res.status(409).json({
        success: false,
        error: { code: error.code, message: error.message }
      })
    }
    console.error('Lỗi tạo thông báo:', error)
    return res.status(500).json({
      success: false,
      error: { code: 'INTERNAL_ERROR', message: 'Lỗi hệ thống' }
    })
  }
}

// ===================================================================
// CLIENT — Xem danh sách PHÂN TRANG + badge unreadCount (UC-12 / UC-13)
// Self-guard cứng: user chỉ xem thông báo của CHÍNH MÌNH (không ngoại lệ ADMIN)
// ===================================================================
export const getNotifications = async (req: Request, res: Response) => {
  try {
    const userId = req.auth!.userId

    // Phân trang từ query (clamp: page ≥ 1, 1 ≤ limit ≤ 50)
    const requestedPage = Number.parseInt(req.query.page as string, 10)
    const page = Number.isFinite(requestedPage) ? Math.max(requestedPage, 1) : 1
    const limit = Math.min(Math.max(parseInt(req.query.limit as string) || 10, 1), 50)
    const skip = (page - 1) * limit

    // Badge unreadCount đếm TỪ DB — KHÔNG đếm JS trên danh sách phân trang
    const [notifications, total, unreadCount] = await Promise.all([
      prisma.notification.findMany({
        where: { userId },
        orderBy: { createdAt: 'desc' },
        skip,
        take: limit
      }),
      prisma.notification.count({ where: { userId } }),
      prisma.notification.count({ where: { userId, read: false } })
    ])

    return res.status(200).json({
      success: true,
      data: {
        notifications,
        unreadCount,
        pagination: {
          page,
          limit,
          total,
          totalPages: Math.ceil(total / limit)
        }
      }
    })
  } catch (error) {
    console.error('Lỗi lấy thông báo:', error)
    return res.status(500).json({
      success: false,
      error: { code: 'INTERNAL_ERROR', message: 'Lỗi hệ thống' },
      requestId: req.get('x-request-id')
    })
  }
}

// ===================================================================
// CLIENT — Đánh dấu MỘT thông báo đã đọc (PATCH /:id/read)
// Self-guard: chỉ được update thông báo của CHÍNH MÌNH
// ===================================================================
export const markNotificationRead = async (req: Request, res: Response) => {
  try {
    const { id } = req.params as { id: string }
    const userId = req.auth!.userId
    const result = await prisma.notification.updateMany({
      where: { id, userId },
      data: { read: true }
    })
    if (result.count === 0) {
      return res.status(404).json({
        success: false,
        error: { code: 'NOT_FOUND', message: 'Không tìm thấy thông báo' },
        requestId: req.get('x-request-id')
      })
    }
    const notification = await prisma.notification.findFirst({
      where: { id, userId }
    })
    if (!notification) {
      return res.status(404).json({
        success: false,
        error: { code: 'NOT_FOUND', message: 'Không tìm thấy thông báo' },
        requestId: req.get('x-request-id')
      })
    }
    return res.status(200).json({
      success: true,
      data: notification
    })
  } catch (error) {
    console.error('Lỗi đánh dấu đã đọc:', error)
    return res.status(500).json({
      success: false,
      error: { code: 'INTERNAL_ERROR', message: 'Lỗi hệ thống' },
      requestId: req.get('x-request-id')
    })
  }
}

export const markAllNotificationsRead = async (req: Request, res: Response) => {
  try {
    const userId = req.auth!.userId
    const result = await prisma.notification.updateMany({
      where: { userId, read: false },
      data: { read: true }
    })
    return res.status(200).json({
      success: true,
      data: { updatedCount: result.count }
    })
  } catch (error) {
    console.error('Lỗi đánh dấu tất cả đã đọc:', error)
    return res.status(500).json({
      success: false,
      error: { code: 'INTERNAL_ERROR', message: 'Lỗi hệ thống' },
      requestId: req.get('x-request-id')
    })
  }
}
</file>

<file path="services/notification-service/tests/socket.test.ts">
import assert from 'node:assert/strict'
import http from 'node:http'
import { after, before, test } from 'node:test'
import { io as createClient, type Socket } from 'socket.io-client'
import { createTestGatewayToken } from 'finvault-internal-auth'
import app from '../src/app'
import { createSocketServer } from '../src/socket'
import {
  consumeSocketTicket,
  issueSocketTicket,
  SocketTicketRateLimitError
} from '../src/socket'
import { randomUUID } from 'node:crypto'

const clients = new Set<Socket>()
let httpServer: http.Server
let socketServer: ReturnType<typeof createSocketServer>
let baseUrl: string

const delay = (milliseconds: number) =>
  new Promise<void>((resolve) => setTimeout(resolve, milliseconds))

const makeFreshToken = async (userId: string) => {
  await delay(2)
  return createTestGatewayToken(userId)
}

const openSocket = (url: string, options: Parameters<typeof createClient>[1] = {}) => {
  const socket = createClient(url, {
    autoConnect: false,
    forceNew: true,
    reconnection: false,
    timeout: 1000,
    transports: ['websocket'],
    ...options
  })
  clients.add(socket)

  return new Promise<Socket>((resolve, reject) => {
    socket.once('connect', () => resolve(socket))
    socket.once('connect_error', (error) => {
      socket.close()
      reject(error)
    })
    socket.connect()
  })
}

const assertRejected = async (url: string, options: Parameters<typeof createClient>[1] = {}) => {
  await assert.rejects(openSocket(url, options), (error: unknown) =>
    error instanceof Error && error.message === 'INVALID_GATEWAY_TOKEN'
  )
}

const getSocketTicket = async (userId: string): Promise<string> => {
  const gatewayToken = createTestGatewayToken(userId)
  const response = await fetch(`${baseUrl}/api/notifications/socket-ticket`, {
    headers: { 'x-gateway-token': gatewayToken }
  })
  assert.equal(response.status, 200)
  const body = await response.json() as { data: { ticket: string } }
  return body.data.ticket
}

before(async () => {
  httpServer = http.createServer(app)
  socketServer = createSocketServer(httpServer, { maxAgeMs: 300 })
  await new Promise<void>((resolve, reject) => {
    httpServer.once('listening', resolve)
    httpServer.once('error', reject)
    httpServer.listen(0, '127.0.0.1')
  })
  const address = httpServer.address()
  assert.ok(address && typeof address !== 'string')
  baseUrl = `http://127.0.0.1:${address.port}`
})

after(async () => {
  for (const client of clients) client.close()
  await new Promise<void>((resolve) => socketServer.close(() => resolve()))
})

test('socket rejects a missing Gateway Token', async () => {
  await assertRejected(baseUrl)
})

test('socket rejects a malformed Gateway Token', async () => {
  await assertRejected(baseUrl, { auth: { token: 'not-a-token' } })
})

test('socket rejects an expired Gateway Token', async () => {
  const token = createTestGatewayToken('00000000-0000-4000-8000-000000000004', 'USER', 0, '-1s')
  await assertRejected(baseUrl, { auth: { token } })
})

test('socket rooms deliver notifications only to the matching user', async () => {
  const userA = '00000000-0000-4000-8000-000000000005'
  const userB = '00000000-0000-4000-8000-000000000006'
  const tokenA = await makeFreshToken(userA)
  const tokenB = await makeFreshToken(userB)
  const socketA = await openSocket(baseUrl, { auth: { token: tokenA } })
  const socketB = await openSocket(baseUrl, { auth: { token: tokenB } })
  await delay(20)

  let receivedByB = false
  const receivedByA = new Promise<void>((resolve) => {
    socketA.once('notification:new', () => resolve())
  })
  socketB.once('notification:new', () => {
    receivedByB = true
  })

  socketServer.to(`user:${userA}`).emit('notification:new', { userId: userA })
  await receivedByA
  await delay(30)

  assert.equal(receivedByB, false)
})

test('a Gateway Token jti can be used only once', async () => {
  const token = await makeFreshToken('00000000-0000-4000-8000-000000000007')
  const firstSocket = await openSocket(baseUrl, { auth: { token } })
  firstSocket.close()
  await delay(10)
  await assertRejected(baseUrl, { auth: { token } })
})

test('a socket ticket can be used once through auth.ticket', async () => {
  const ticket = await getSocketTicket('00000000-0000-4000-8000-000000000010')
  const firstSocket = await openSocket(baseUrl, { auth: { ticket } })
  firstSocket.close()
  await delay(10)
  await assertRejected(baseUrl, { auth: { ticket } })
})

test('a socket ticket remains compatible through deprecated auth.token', async () => {
  const ticket = await getSocketTicket('00000000-0000-4000-8000-000000000011')
  const firstSocket = await openSocket(baseUrl, { auth: { token: ticket } })
  firstSocket.close()
  await delay(10)
  await assertRejected(baseUrl, { auth: { token: ticket } })
})

test('socket ticket rate limit rejects the eleventh issue in one minute', () => {
  const userId = randomUUID()
  for (let count = 0; count < 10; count += 1) issueSocketTicket(userId)
  assert.throws(
    () => issueSocketTicket(userId),
    (error: unknown) => error instanceof SocketTicketRateLimitError
  )
})

test('socket ticket issuance caps unused tickets per user and evicts the oldest', () => {
  const userId = randomUUID()
  const tickets = Array.from({ length: 6 }, () => issueSocketTicket(userId).ticket)

  assert.equal(consumeSocketTicket(tickets[0]), undefined)
  assert.equal(consumeSocketTicket(tickets[1])?.userId, userId)
  assert.equal(consumeSocketTicket(tickets[5])?.userId, userId)
})

test('socket ignores Gateway Token supplied only in the query string', async () => {
  const token = await makeFreshToken('00000000-0000-4000-8000-000000000008')
  await assertRejected(`${baseUrl}?token=${encodeURIComponent(token)}`)
})

test('socket disconnects when its maximum age is reached', async () => {
  const token = await makeFreshToken('00000000-0000-4000-8000-000000000009')
  const socket = await openSocket(baseUrl, { auth: { token } })
  const disconnectReason = new Promise<string>((resolve) => {
    socket.once('disconnect', (reason) => resolve(reason))
  })

  assert.equal(await disconnectReason, 'io server disconnect')
})
</file>

<file path="services/notification-service/EVENTS.md">
# Notification event catalog

The notification service consumes the legacy `wallet.events`, `payment.events`,
and `kyc.events` exchanges alongside the versioned `finvault.events` exchange.
Its notification type enum is defined in
`prisma/schema.prisma` and mirrored in `src/types/notification.ts`.

| Source | Published event/type | Notification enum | Status |
| --- | --- | --- | --- |
| `payment-service` outbox | `PAYMENT_SUCCESS` → `payment.succeeded` | `PAYMENT_SUCCESS` | Published to `finvault.events`; sender and receiver get one inbox item each |
| `payment-service` outbox | `PAYMENT_FAILED` → `payment.failed` | `PAYMENT_FAILED` | Published to `finvault.events`; failure details are not included in the message |
| `payment-service` outbox | `PAYMENT_REFUNDED` | `PAYMENT_REFUNDED` | Published to `payment.events`; HTTP fallback exists |
| `payment-service` outbox | `PAYMENT_CANCELLED` | `PAYMENT_CANCELLED` | Published to `payment.events`; HTTP fallback exists |
| `payment-service` outbox/expiry job | `PAYMENT_EXPIRED` → `payment.expired` | `PAYMENT_EXPIRED` | Published to `finvault.events`; sender receives a notification |
| `wallet-service` outbox | `wallet.balance_added` → `WALLET_CREDITED` | `WALLET_CREDITED` | Published to `wallet.events`; HTTP fallback exists |
| `wallet-service` outbox | `wallet.balance_deducted` → `WALLET_DEBITED` | `WALLET_DEBITED` | Published to `wallet.events`; HTTP fallback exists |
| — | — | `KYC_APPROVED` | No current event source |
| — | — | `KYC_REJECTED` | No current event source |
| `user-service` outbox | `user.kyc_updated` on `finvault.events` | `KYC_TIER_CHANGED` | Consumed; legacy events without `previousTier` are supported |
| `merchant-service` outbox | `merchant.status_updated` on `finvault.events` | — | Bound and intentionally acknowledged without a notification; no recipient is defined |
| `user-service` outbox | `user.registered` on `finvault.events` | — | Bound and intentionally acknowledged without a notification; no recipient is defined |
| `payment-service` outbox | `payment.succeeded` on `finvault.events` | `PAYMENT_SUCCESS` | Envelope event ID is the Outbox row ID; optional `note` is included when present |
| `payment-service` outbox | `payment.failed` on `finvault.events` | `PAYMENT_FAILED` | Envelope event ID is the Outbox row ID |
| `payment-service` outbox | `payment.expired` on `finvault.events` | `PAYMENT_EXPIRED` | Envelope event ID is the Outbox row ID |

The new consumer binds only these six exact event types. Payment outbox rows
are claimed with `FOR UPDATE SKIP LOCKED`, drained after the state transaction
commits, and retried by a one-second fallback scheduler. The legacy payment
publisher remains active for refund/cancel events. Wallet outbox rows are
similarly drained after commit and every second; P2P wallet messages are
suppressed to avoid duplicating the shared payment notification. For merchant
and other `PAYMENT` transfers, the shared payment event is the canonical
notification; the legacy wallet debit/credit notification is suppressed.
`TOPUP` and `REFUND` wallet notifications remain unchanged. The new
consumer does not bind
`wallet.limit_exceeded` because no notification type is defined for it, nor
does it use broad user or merchant wildcards. Legacy exchange consumption
remains active during the migration.

## Proposed mappings added in N14a (mapping only, not bound)

N14a adds the notification enum values and pure mapping cases below. **These
event names are proposals and are not registered in
`packages/finvault-events/src/schemas.ts`**, so they are deliberately absent
from `financeEventBindings` and from the consumer handlers. Binding an
unregistered event would make the consumer dead-letter every message (N14b is
blocked until the schemas exist on `main`).

| Proposed event | Notification enum | Message |
| --- | --- | --- |
| `funding.topup_succeeded` | `TOPUP_SUCCEEDED` | `Bạn đã nạp <amount> vào ví thành công.` |
| `payment.refunded` | `PAYMENT_REFUNDED` | `Bạn được hoàn <amount> vào ví.` (`amount` may be `"50000.00"`; a non-zero fraction is rejected) |
| `funding.cashout_completed` | `CASHOUT_SUCCEEDED` | `Lệnh rút <amount> của bạn đã thành công.` |
| `funding.cashout_failed` | `CASHOUT_FAILED` | `Lệnh rút <amount> của bạn không thành công.` (upstream reason is ignored) |
| `utility.order_succeeded` | `UTILITY_SUCCEEDED` | `Giao dịch tiện ích <amount> đã thành công.` |
| `utility.order_failed` | `UTILITY_FAILED` | `Giao dịch tiện ích <amount> không thành công.` |
| `utility.order_refunded` | `UTILITY_REFUNDED` | `Giao dịch tiện ích <amount> đã được hoàn tiền.` |
| `user.kyc_reviewed` | `KYC_APPROVED` / `KYC_REJECTED` | Approval message, or a rejection message with an optional sanitized reason (≤200 chars). |

Amounts are validated as BigInt integer VND strings; malformed amounts and
missing `userId`/`authUserId` throw `TypeError`, which the consumer treats as
non-retryable. KYC reasons have control characters removed and are truncated to
200 characters. The existing `user.kyc_updated` → `KYC_TIER_CHANGED` mapping is
unchanged; `user.kyc_reviewed` is a separate event.
</file>

