import { P2pService } from './p2p.service';
import { DomainException } from '../utils/domain.exception';
import { PaymentStatus, OutboxEventStatus, PaymentType } from '../utils/enums';
import { IdempotencyStatus, Prisma } from '@prisma/client';
import { TransactionTokenPayload } from '../middlewares/transactionToken';
import { prisma } from '../utils/prisma';
import { randomUUID } from 'crypto';
import * as crypto from 'crypto';
import { WalletClient } from '../clients/wallet.client';
import { drainOutbox } from '../jobs/outbox.job';

export interface CheckoutDto {
  userId: string;
  amount: number | string;
  type: PaymentType;
  referenceId?: string;
  destinationUserId?: string;
  destinationOwnerType?: string;
  callbackTopic: string;
  idempotencyKey: string;
}

function triggerOutboxDrain(): void {
  void drainOutbox().catch(error => {
    console.error('[Payment Outbox] Post-commit drain failed', error instanceof Error ? error.message : 'unknown error');
  });
}

export class PaymentService {
  constructor(private walletClient: WalletClient = new WalletClient()) { }

  async checkout(dto: CheckoutDto) {
    const destUserId = dto.destinationUserId || (dto.type === PaymentType.WALLET_TRANSFER ? dto.referenceId : undefined);
    const destOwnerType = dto.destinationOwnerType || (destUserId ? 'USER' : undefined);

    if (dto.type === PaymentType.WALLET_TRANSFER) {
      if (!destUserId) throw new DomainException(400, 'DESTINATION_REQUIRED', 'A destination wallet is required');
      return new P2pService(this.walletClient).checkout({ ...dto, destinationUserId: destUserId, destinationOwnerType: destOwnerType });
    }

    // Kiểm tra nghiệp vụ người nhận: khác người gửi, tồn tại, ví ACTIVE
    if (destUserId) {
      if (destUserId === dto.userId) {
        throw new DomainException(400, 'SELF_TRANSFER_NOT_ALLOWED', 'Không thể chuyển tiền cho chính mình');
      }
      const destWallet = await this.walletClient.getBalance(destUserId);
      if (!destWallet) {
        throw new DomainException(404, 'DESTINATION_WALLET_NOT_FOUND', 'Người nhận không tồn tại hoặc chưa kích hoạt ví');
      }
      if (destWallet.status !== 'ACTIVE') {
        throw new DomainException(400, 'DESTINATION_WALLET_NOT_ACTIVE', 'Ví người nhận không ở trạng thái hoạt động');
      }
    }

    const hashData = `${dto.amount}|${dto.type}|${dto.referenceId || ''}|${destUserId || ''}|${dto.callbackTopic}`;
    const requestHash = crypto.createHash('sha256').update(hashData).digest('hex');

    const paymentId = randomUUID();
    const holdId = randomUUID();
    const holdExpiresAt = new Date(Date.now() + 5 * 60 * 1000); // 5 phút (theo yêu cầu P0-3)
    const idempotencyExpiresAt = new Date(Date.now() + 24 * 60 * 60 * 1000); // 24 giờ

    let payment: any;

    // 1. Thử tranh khóa (Acquire Lock) bằng cách CREATE thẳng
    try {
      payment = await prisma.payment.create({
        data: {
          id: paymentId,
          userId: dto.userId,
          amount: dto.amount,
          type: dto.type,
          referenceId: dto.referenceId || '',
          destinationUserId: destUserId || null,
          destinationOwnerType: destOwnerType || null,
          callbackTopic: dto.callbackTopic,
          idempotencyKey: dto.idempotencyKey,
          requestHash,
          idempotencyStatus: IdempotencyStatus.PROCESSING,
          idempotencyExpiresAt,
          status: PaymentStatus.PENDING,
          holdId: holdId,
          holdExpiresAt: holdExpiresAt,
          histories: {
            create: {
              id: randomUUID(),
              toStatus: PaymentStatus.PENDING,
              note: 'Payment checkout created in PROCESSING state',
            }
          }
        }
      });
    } catch (err: any) {
      if (err.code === 'P2002') { // Lỗi Unique Constraint (Idempotency Key đã tồn tại)
        const existing = await prisma.payment.findUnique({
          where: { userId_idempotencyKey: { userId: dto.userId, idempotencyKey: dto.idempotencyKey } }
        });

        if (!existing) throw new DomainException(500, 'INTERNAL_ERROR', 'Idempotency conflict but record missing');

        // Kiểm tra tính toàn vẹn Payload
        if (existing.requestHash !== requestHash && existing.requestHash !== 'LEGACY') {
          throw new DomainException(422, 'IDEMPOTENCY_KEY_REUSED_WITH_DIFFERENT_PAYLOAD', 'Idempotency key reused with different payload');
        }

        // Xử lý State Machine
        if (existing.idempotencyStatus === IdempotencyStatus.PROCESSING) {
          throw new DomainException(409, 'IDEMPOTENCY_REQUEST_IN_PROGRESS', 'Request in progress. Please retry later.');
        }

        if (existing.idempotencyStatus === IdempotencyStatus.COMPLETED) {
          return { payment: existing, replayed: true };
        }

        if (existing.idempotencyStatus === IdempotencyStatus.FAILED) {
          // Retry an toàn
          const updateRes = await prisma.payment.updateMany({
            where: { id: existing.id, idempotencyStatus: IdempotencyStatus.FAILED },
            data: {
              idempotencyStatus: IdempotencyStatus.PROCESSING,
              requestHash,
              holdId,
              holdExpiresAt,
              idempotencyExpiresAt
            }
          });
          if (updateRes.count === 0) {
            throw new DomainException(409, 'IDEMPOTENCY_REQUEST_IN_PROGRESS', 'Request in progress by another thread.');
          }
          payment = { ...existing, idempotencyStatus: IdempotencyStatus.PROCESSING, holdId, holdExpiresAt };
        }
      } else {
        throw err;
      }
    }

    // 2. Chạy nghiệp vụ Side-effect (Call sang Wallet Service)
    let holdSucceeded = false;
    try {
      const destinationUserId = payment.destinationUserId || undefined;
      const destinationOwnerType = payment.destinationOwnerType || (destinationUserId ? 'USER' : undefined);
      await this.walletClient.createHold(dto.userId, dto.amount.toString(), payment.holdId!, payment.holdExpiresAt!.toISOString(), destinationUserId, destinationOwnerType);
      holdSucceeded = true;
    } catch (err: any) {
      // Nếu hold xịt, nhả khóa về FAILED cho phép retry
      await prisma.payment.update({
        where: { id: payment.id! },
        data: {
          idempotencyStatus: IdempotencyStatus.FAILED,
          status: PaymentStatus.FAILED,
          failureReason: 'Hold failed: ' + (err.message || 'Unknown')
        }
      });
      if (err instanceof DomainException) throw err;
      throw new DomainException(500, 'INTERNAL_ERROR', 'Failed to communicate with wallet service for hold');
    }

    // 3. Hoàn tất Idempotency Lock
    const finalizedPayment = await prisma.payment.update({
      where: { id: payment.id! },
      data: { idempotencyStatus: IdempotencyStatus.COMPLETED }
    });

    return { payment: finalizedPayment, replayed: false };
  }

  async confirm(id: string, requesterUserId: string, tokenPayload: TransactionTokenPayload) {
    const payment = await prisma.payment.findUnique({ where: { id } });
    if (!payment) throw new DomainException(404, 'NOT_FOUND', 'Payment not found');
    if (payment.type === PaymentType.WALLET_TRANSFER && payment.status !== PaymentStatus.PROCESSING) {
      const result = await new P2pService(this.walletClient).confirm(id, requesterUserId, tokenPayload);
      triggerOutboxDrain();
      return result;
    }

    // 1. Kiểm tra quyền sở hữu (ownership)
    if (payment.userId !== requesterUserId || tokenPayload.sub !== requesterUserId) {
      throw new DomainException(403, 'FORBIDDEN', 'Bạn không có quyền xác nhận thanh toán này');
    }

    // 2. Kiểm tra claims gắn chặt với paymentId và amount
    if (tokenPayload.paymentId !== payment.id) {
      throw new DomainException(403, 'FORBIDDEN', 'Transaction token does not match payment ID');
    }

    const tokenAmount = new Prisma.Decimal(tokenPayload.amount);
    if (!tokenAmount.equals(payment.amount)) {
      throw new DomainException(403, 'FORBIDDEN', 'Transaction token amount does not match payment amount');
    }

    // 3. Kiểm tra trạng thái Payment
    if (payment.status === PaymentStatus.SUCCESS) {
      throw new DomainException(409, 'PAYMENT_ALREADY_CONFIRMED', 'Payment has already been confirmed');
    }

    if (payment.status !== PaymentStatus.PENDING && payment.status !== PaymentStatus.PROCESSING) {
      throw new DomainException(409, 'CONFLICT', `Payment is in ${payment.status} status. Cannot confirm.`);
    }

    // 4. Kiểm tra TTL giữ tiền (nếu còn ở PENDING)
    if (payment.status === PaymentStatus.PENDING && payment.holdExpiresAt && payment.holdExpiresAt.getTime() < Date.now()) {
      if (payment.holdId) {
        await this.walletClient.releaseHold(payment.userId, payment.holdId);
      }
      await prisma.$transaction(async tx => {
        const updated = await tx.payment.update({
          where: { id },
          data: {
            status: PaymentStatus.EXPIRED,
            histories: {
              create: {
                id: randomUUID(),
                fromStatus: payment.status,
                toStatus: PaymentStatus.EXPIRED,
                note: 'Hold expired during confirm',
              }
            }
          }
        });
        await tx.outboxEvent.create({
          data: {
            id: randomUUID(),
            aggregateId: id,
            eventType: 'PAYMENT_EXPIRED',
            topic: payment.callbackTopic,
            payload: JSON.parse(JSON.stringify(updated)),
            status: OutboxEventStatus.PENDING,
          }
        });
      });
      triggerOutboxDrain();
      throw new DomainException(410, 'PAYMENT_EXPIRED', 'Hold has expired, please checkout again');
    }

    // 5. PENDING -> PROCESSING và consume token chống replay
    if (payment.status === PaymentStatus.PENDING) {
      await prisma.$transaction(async (tx) => {
        try {
          await tx.usedTransactionToken.create({
            data: {
              jti: tokenPayload.jti,
              paymentId: payment.id,
              userId: tokenPayload.sub,
            }
          });
        } catch (err: any) {
          if (err.code === 'P2002') {
            throw new DomainException(409, 'TXN_TOKEN_REUSED', 'Transaction token has already been used');
          }
          throw err;
        }

        await tx.payment.update({
          where: { id },
          data: {
            status: PaymentStatus.PROCESSING,
            histories: {
              create: {
                id: randomUUID(),
                fromStatus: PaymentStatus.PENDING,
                toStatus: PaymentStatus.PROCESSING,
                note: 'Payment status changed to PROCESSING before capture',
              }
            }
          }
        });
      });
    } else {
      // payment.status === PaymentStatus.PROCESSING (retry confirm)
      try {
        await prisma.usedTransactionToken.create({
          data: {
            jti: tokenPayload.jti,
            paymentId: payment.id,
            userId: tokenPayload.sub,
          }
        });
      } catch (err: any) {
        if (err.code === 'P2002') {
          const used = await prisma.usedTransactionToken.findUnique({
            where: { jti: tokenPayload.jti }
          });
          if (!used || used.paymentId !== payment.id) {
            throw new DomainException(409, 'TXN_TOKEN_REUSED', 'Transaction token has already been used');
          }
        } else {
          throw err;
        }
      }
    }

    // 6. Gọi captureHold (lũy đẳng theo referenceId)
    try {
      await this.walletClient.captureHold(payment.userId, payment.holdId);

      // Capture thành công -> chuyển sang SUCCESS, ghi outbox event PAYMENT_SUCCESS
      const completed = await prisma.$transaction(async (tx) => {
        const updated = await tx.payment.update({
          where: { id },
          data: {
            status: PaymentStatus.SUCCESS,
            histories: {
              create: {
                id: randomUUID(),
                fromStatus: PaymentStatus.PROCESSING,
                toStatus: PaymentStatus.SUCCESS,
                note: 'Wallet capture successful',
              }
            }
          }
        });

        await tx.outboxEvent.create({
          data: {
            id: randomUUID(),
            aggregateId: id,
            eventType: 'PAYMENT_SUCCESS',
            topic: payment.callbackTopic,
            payload: JSON.parse(JSON.stringify(updated)),
            status: OutboxEventStatus.PENDING,
          }
        });

        return updated;
      });
      triggerOutboxDrain();
      return completed;
    } catch (captureError: any) {
      console.error(`Confirm payment capture error for ${id}:`, captureError);

      // Nếu capture lỗi dứt khoát (Deterministic, e.g. 4xx từ wallet):
      // -> FAILED, release hold, hoàn usage, ghi sự kiện outbox PAYMENT_FAILED
      // Tuyệt đối không gọi credit (compensate) tạo tiền từ hư không (P0-4)!
      // Ánh xạ HOLD_EXPIRED hoặc HOLD_NOT_CAPTURABLE -> EXPIRED (410 PAYMENT_EXPIRED)
      const isHoldExpired =
        captureError.code === 'HOLD_EXPIRED' ||
        captureError.code === 'HOLD_NOT_CAPTURABLE' ||
        captureError.message?.includes('HOLD_EXPIRED') ||
        captureError.message?.includes('HOLD_NOT_CAPTURABLE') ||
        captureError.message?.includes('Hold has expired') ||
        captureError.message?.includes('Hold has already been released');

      if (isHoldExpired) {
        if (payment.holdId) {
          await this.walletClient.releaseHold(payment.userId, payment.holdId);
        }

        const expiredNote = captureError.message || 'Hold expired or not capturable';

        await prisma.$transaction(async (tx) => {
          const updated = await tx.payment.update({
            where: { id },
            data: {
              status: PaymentStatus.EXPIRED,
              failureReason: expiredNote,
              histories: {
                create: {
                  id: randomUUID(),
                  fromStatus: PaymentStatus.PROCESSING,
                  toStatus: PaymentStatus.EXPIRED,
                  note: expiredNote,
                }
              }
            }
          });

          await tx.outboxEvent.create({
            data: {
              id: randomUUID(),
              aggregateId: id,
              eventType: 'PAYMENT_EXPIRED',
              topic: payment.callbackTopic,
              payload: JSON.parse(JSON.stringify(updated)),
              status: OutboxEventStatus.PENDING,
            }
          });
        });

        triggerOutboxDrain();
        throw new DomainException(410, 'PAYMENT_EXPIRED', captureError.message || 'Giao dịch thanh toán đã hết hạn');
      }

      if (captureError.isDeterministic || (captureError instanceof DomainException && captureError.status < 500)) {
        if (payment.holdId) {
          await this.walletClient.releaseHold(payment.userId, payment.holdId);
        }

        const failureNote = captureError.message || 'Capture failed deterministically';

        await prisma.$transaction(async (tx) => {
          const updated = await tx.payment.update({
            where: { id },
            data: {
              status: PaymentStatus.FAILED,
              failureReason: failureNote,
              histories: {
                create: {
                  id: randomUUID(),
                  fromStatus: PaymentStatus.PROCESSING,
                  toStatus: PaymentStatus.FAILED,
                  note: failureNote,
                }
              }
            }
          });

          await tx.outboxEvent.create({
            data: {
              id: randomUUID(),
              aggregateId: id,
              eventType: 'PAYMENT_FAILED',
              topic: payment.callbackTopic,
              payload: JSON.parse(JSON.stringify(updated)),
              status: OutboxEventStatus.PENDING,
            }
          });
        });

        triggerOutboxDrain();
        throw new DomainException(400, 'PAYMENT_FAILED', captureError.message || 'Thanh toán thất bại');
      }

      // Không chắc kết quả (timeout, network error, 5xx):
      // Giữ PROCESSING và cho phép thử lại capture (vì capture theo referenceId là lũy đẳng).
      await prisma.paymentHistory.create({
        data: {
          id: randomUUID(),
          paymentId: id,
          fromStatus: PaymentStatus.PROCESSING,
          toStatus: PaymentStatus.PROCESSING,
          note: `Capture timed out or network error: ${captureError.message}. Kept PROCESSING for retry.`,
        }
      }).catch((e: any) => console.error('Failed to log history for indeterminate error:', e));

      throw new DomainException(504, 'GATEWAY_TIMEOUT', 'Giao dịch đang được xử lý hoặc kết nối tới ví bị gián đoạn. Vui lòng thử lại sau.');
    }
  }

  async internalConfirm(id: string) {
    const payment = await prisma.payment.findUnique({ where: { id } });
    if (!payment) throw new DomainException(404, 'NOT_FOUND', 'Payment not found');
    if (payment.type === PaymentType.WALLET_TRANSFER) {
      throw new DomainException(403, 'TRANSACTION_TOKEN_REQUIRED', 'Wallet transfers require user PIN authorization');
    }

    if (payment.status === PaymentStatus.SUCCESS) {
      throw new DomainException(409, 'PAYMENT_ALREADY_CONFIRMED', 'Payment has already been confirmed');
    }

    if (payment.status !== PaymentStatus.PENDING && payment.status !== PaymentStatus.PROCESSING) {
      throw new DomainException(409, 'CONFLICT', `Payment is in ${payment.status} status. Cannot confirm.`);
    }

    if (payment.status === PaymentStatus.PENDING && payment.holdExpiresAt && payment.holdExpiresAt.getTime() < Date.now()) {
      if (payment.holdId) {
        await this.walletClient.releaseHold(payment.userId, payment.holdId);
      }
      await prisma.$transaction(async tx => {
        const updated = await tx.payment.update({
          where: { id },
          data: {
            status: PaymentStatus.EXPIRED,
            histories: {
              create: {
                id: randomUUID(),
                fromStatus: payment.status,
                toStatus: PaymentStatus.EXPIRED,
                note: 'Hold expired during internal confirm',
              }
            }
          }
        });
        await tx.outboxEvent.create({
          data: {
            id: randomUUID(),
            aggregateId: id,
            eventType: 'PAYMENT_EXPIRED',
            topic: payment.callbackTopic,
            payload: JSON.parse(JSON.stringify(updated)),
            status: OutboxEventStatus.PENDING,
          }
        });
      });
      triggerOutboxDrain();
      throw new DomainException(410, 'PAYMENT_EXPIRED', 'Hold has expired, please checkout again');
    }

    if (payment.status === PaymentStatus.PENDING) {
      await prisma.payment.update({
        where: { id },
        data: {
          status: PaymentStatus.PROCESSING,
          histories: {
            create: {
              id: randomUUID(),
              fromStatus: PaymentStatus.PENDING,
              toStatus: PaymentStatus.PROCESSING,
              note: 'Internal payment status changed to PROCESSING before capture',
            }
          }
        }
      });
    }

    try {
      await this.walletClient.captureHold(payment.userId, payment.holdId);

      const completed = await prisma.$transaction(async (tx) => {
        const updated = await tx.payment.update({
          where: { id },
          data: {
            status: PaymentStatus.SUCCESS,
            histories: {
              create: {
                id: randomUUID(),
                fromStatus: PaymentStatus.PROCESSING,
                toStatus: PaymentStatus.SUCCESS,
                note: 'Internal wallet capture successful',
              }
            }
          }
        });

        await tx.outboxEvent.create({
          data: {
            id: randomUUID(),
            aggregateId: id,
            eventType: 'PAYMENT_SUCCESS',
            topic: payment.callbackTopic,
            payload: JSON.parse(JSON.stringify(updated)),
            status: OutboxEventStatus.PENDING,
          }
        });

        return updated;
      });
      triggerOutboxDrain();
      return completed;
    } catch (captureError: any) {
      console.error(`Internal confirm payment capture error for ${id}:`, captureError);

      const isHoldExpired =
        captureError.code === 'HOLD_EXPIRED' ||
        captureError.code === 'HOLD_NOT_CAPTURABLE' ||
        captureError.message?.includes('HOLD_EXPIRED') ||
        captureError.message?.includes('HOLD_NOT_CAPTURABLE') ||
        captureError.message?.includes('Hold has expired') ||
        captureError.message?.includes('Hold has already been released');

      if (isHoldExpired) {
        if (payment.holdId) {
          await this.walletClient.releaseHold(payment.userId, payment.holdId);
        }

        const expiredNote = captureError.message || 'Hold expired or not capturable';

        await prisma.$transaction(async (tx) => {
          const updated = await tx.payment.update({
            where: { id },
            data: {
              status: PaymentStatus.EXPIRED,
              failureReason: expiredNote,
              histories: {
                create: {
                  id: randomUUID(),
                  fromStatus: PaymentStatus.PROCESSING,
                  toStatus: PaymentStatus.EXPIRED,
                  note: expiredNote,
                }
              }
            }
          });

          await tx.outboxEvent.create({
            data: {
              id: randomUUID(),
              aggregateId: id,
              eventType: 'PAYMENT_EXPIRED',
              topic: payment.callbackTopic,
              payload: JSON.parse(JSON.stringify(updated)),
              status: OutboxEventStatus.PENDING,
            }
          });
        });

        triggerOutboxDrain();
        throw new DomainException(410, 'PAYMENT_EXPIRED', captureError.message || 'Giao dịch thanh toán đã hết hạn');
      }

      if (captureError.isDeterministic || (captureError instanceof DomainException && captureError.status < 500)) {
        if (payment.holdId) {
          await this.walletClient.releaseHold(payment.userId, payment.holdId);
        }

        const failureNote = captureError.message || 'Internal capture failed deterministically';

        await prisma.$transaction(async (tx) => {
          const updated = await tx.payment.update({
            where: { id },
            data: {
              status: PaymentStatus.FAILED,
              failureReason: failureNote,
              histories: {
                create: {
                  id: randomUUID(),
                  fromStatus: PaymentStatus.PROCESSING,
                  toStatus: PaymentStatus.FAILED,
                  note: failureNote,
                }
              }
            }
          });

          await tx.outboxEvent.create({
            data: {
              id: randomUUID(),
              aggregateId: id,
              eventType: 'PAYMENT_FAILED',
              topic: payment.callbackTopic,
              payload: JSON.parse(JSON.stringify(updated)),
              status: OutboxEventStatus.PENDING,
            }
          });
        });

        triggerOutboxDrain();
        throw new DomainException(400, 'PAYMENT_FAILED', captureError.message || 'Thanh toán nội bộ thất bại');
      }

      await prisma.paymentHistory.create({
        data: {
          id: randomUUID(),
          paymentId: id,
          fromStatus: PaymentStatus.PROCESSING,
          toStatus: PaymentStatus.PROCESSING,
          note: `Internal capture timed out or indeterminate network error: ${captureError.message}. Kept PROCESSING for retry.`,
        }
      }).catch((e: any) => console.error('Failed to log history for indeterminate internal error:', e));

      throw new DomainException(504, 'GATEWAY_TIMEOUT', 'Giao dịch đang được xử lý hoặc kết nối tới ví bị gián đoạn. Vui lòng thử lại sau.');
    }
  }

  async refund(id: string, requesterId?: string, requesterRole?: string) {
    const refunded = await prisma.$transaction(async (tx) => {
      const rows: any[] = await tx.$queryRaw`
        SELECT "id", "status", "amount", "userId", "holdId", "destinationUserId", "refundRequestedAt", "refundedAt"
        FROM "Payment"
        WHERE "id" = ${id}::uuid
        FOR UPDATE
      `;

      if (!rows || rows.length === 0) {
        throw new DomainException(404, 'NOT_FOUND', 'Payment not found');
      }
      const payment = rows[0];

      if (payment.status === PaymentStatus.REFUNDING || payment.status === PaymentStatus.REFUNDED) {
        const current = await tx.payment.findUnique({ where: { id } });
        return { ...current, replayed: true };
      }

      if (payment.status === PaymentStatus.REFUND_FAILED) {
        throw new DomainException(409, 'REFUND_ALREADY_FAILED', 'Payment refund has failed and cannot be re-initiated');
      }
      if (payment.status !== PaymentStatus.SUCCESS) {
        throw new DomainException(409, 'INVALID_PAYMENT_STATUS', `Payment is in ${payment.status} status. Cannot initiate refund.`);
      }

      const requestedAt = new Date();
      const referenceId = `refund_${id}`;
      const initiator = requesterId || (requesterRole === 'ADMIN' ? 'ADMIN' : 'INTERNAL');

      const updated = await tx.payment.update({
        where: { id },
        data: {
          status: PaymentStatus.REFUNDING,
          refundRequestedAt: requestedAt,
          histories: {
            create: {
              id: randomUUID(),
              fromStatus: PaymentStatus.SUCCESS,
              toStatus: PaymentStatus.REFUNDING,
              note: `Refund saga initiated by ${initiator}`,
            },
          },
        },
      });

      await tx.outboxEvent.create({
        data: {
          id: randomUUID(),
          aggregateId: id,
          eventType: 'payment.refund_requested',
          topic: 'payment.refund_requested',
          payload: {
            paymentId: id,
            referenceId,
            originalHoldId: payment.holdId ?? null,
            userId: payment.userId,
            destinationUserId: payment.destinationUserId ?? null,
            amount: new Prisma.Decimal(payment.amount).toFixed(2),
            requestedBy: initiator,
            requestedAt: requestedAt.toISOString(),
          },
          status: OutboxEventStatus.PENDING,
        },
      });

      return { ...updated, replayed: false };
    }, { maxWait: 10000, timeout: 25000 });
    triggerOutboxDrain();
    return refunded;
  }

  // Thêm yêu cầu api phải chính là người dùng gọi hoặc là tài khoản admin
  // Tránh hiện một người khác có mã paymentId có thể hủy.
  async cancel(id: string, requesterId: string, requesterRole?: string) {
    const payment = await prisma.payment.findUnique({ where: { id } });
    if (!payment) throw new DomainException(404, 'NOT_FOUND', 'Payment not found');
    if (payment.type === PaymentType.WALLET_TRANSFER) {
      const result = await new P2pService(this.walletClient).cancel(id, requesterRole === 'ADMIN' ? undefined : requesterId);
      triggerOutboxDrain();
      return result;
    }
    if (requesterRole !== 'ADMIN' && payment.userId !== requesterId) {
      throw new DomainException(403, 'FORBIDDEN', 'Payment belongs to another user');
    }
    if (payment.status !== PaymentStatus.PENDING) {
      throw new DomainException(409, 'CONFLICT', `Payment is in ${payment.status} status. Cannot cancel.`);
    }

    if (payment.holdId) {
      await this.walletClient.releaseHold(payment.userId, payment.holdId);
    }

    return await prisma.payment.update({
      where: { id },
      data: {
        status: PaymentStatus.CANCELLED,
        histories: {
          create: {
            id: randomUUID(),
            fromStatus: PaymentStatus.PENDING,
            toStatus: PaymentStatus.CANCELLED,
            note: requesterRole === 'ADMIN' && payment.userId !== requesterId ? 'Admin cancelled and hold released' : 'User cancelled and hold released',
          }
        }
      }
    });
  }

  // Chỉ người dùng hoặc admin mới được quyền gọi
  async getById(id: string, requesterId: string, requesterRole?: string) {
    const payment = await prisma.payment.findUnique({
      where: { id },
      include: { histories: true }
    });
    if (!payment) throw new DomainException(404, 'NOT_FOUND', 'Payment not found');
    if (requesterRole !== 'ADMIN' && payment.userId !== requesterId) {
      throw new DomainException(403, 'FORBIDDEN', 'Payment belongs to another user');
    }
    return payment;
  }

  async list(userId?: string, type?: string, status?: string) {
    return await prisma.payment.findMany({
      where: {
        ...(userId && { userId }),
        ...(type && { type: type as PaymentType }),
        ...(status && { status: status as PaymentStatus }),
      },
      orderBy: { createdAt: 'desc' }
    });
  }

  // Luồng chuyển tiền p2p thông qua payment service để quản lý transaction
  // Luồng này sẽ tạo payment với status PENDING và hold số tiền tương ứng
  // Sau đó user sẽ confirm payment để hoàn tất transaction
  // Hoặc user có thể cancel payment để hoàn tác transaction
  // ** Luồng này dùng cho người dùng cuối user
  async p2pQuote(senderId: string, destinationUserId: string, amountStr: string) {
    if (senderId === destinationUserId) {
      throw new DomainException(400, 'SELF_TRANSFER_NOT_ALLOWED', 'Không thể chuyển tiền cho chính mình');
    }

    const amountNum = Number(amountStr);
    if (isNaN(amountNum) || amountNum <= 0) {
      throw new DomainException(400, 'INVALID_AMOUNT', 'Số tiền không hợp lệ');
    }

    // 1. Kiểm tra ví người nhận có tồn tại không
    const destWallet = await this.walletClient.getBalance(destinationUserId);
    if (!destWallet) {
      throw new DomainException(404, 'DESTINATION_WALLET_NOT_FOUND', 'Người nhận không tồn tại hoặc chưa kích hoạt ví');
    }

    // 2. Kiểm tra số dư khả dụng của người gửi
    const senderWallet = await this.walletClient.getBalance(senderId);
    if (!senderWallet) {
      throw new DomainException(404, 'SENDER_WALLET_NOT_FOUND', 'Ví người gửi không tồn tại');
    }

    const availableBalance = Number(senderWallet.availableBalance ?? senderWallet.balance);
    if (availableBalance < amountNum) {
      throw new DomainException(400, 'INSUFFICIENT_FUNDS', 'Số dư khả dụng không đủ để thực hiện giao dịch');
    }

    // 3. TTL 60 giây
    const expiresAt = new Date(Date.now() + 60 * 1000).toISOString();

    return {
      destinationUserId,
      amount: amountStr,
      fee: 0,
      expiresAt
    };
  }

  // Luồng chuyển tiền P2P checkout chuẩn hóa
  async p2pCheckout(dto: {
    senderId: string;
    destinationUserId: string;
    destinationOwnerType?: string;
    amount: string;
    idempotencyKey: string;
    note?: string;
  }) {
    const amountNum = Number(dto.amount);
    if (isNaN(amountNum) || amountNum <= 0) {
      throw new DomainException(400, 'INVALID_AMOUNT', 'Số tiền không hợp lệ');
    }

    return await this.checkout({
      userId: dto.senderId,
      amount: dto.amount,
      type: PaymentType.WALLET_TRANSFER,
      referenceId: dto.destinationUserId,
      destinationUserId: dto.destinationUserId,
      destinationOwnerType: dto.destinationOwnerType || 'USER',
      callbackTopic: 'payment.p2p.events',
      idempotencyKey: dto.idempotencyKey,
    });
  }
}
</file>

<file path="services/wallet-service/src/services/wallet-hold.service.ts">
import { HoldStatus, OwnerType, Prisma, PrismaClient, SystemWalletCode, TransferType } from "@prisma/client";
import { randomUUID } from "crypto";
import { DomainException } from "../utils/domain.exception";
import { assertWalletActive, conflict, decimalToString, insufficientBalance, money } from "../utils/wallet.helpers";
import { LedgerService } from "./ledger.service";
import { LimitService } from "./limit.service";
import { getVnDay } from "../utils/timezone.helper";
import { drainOutbox } from "../jobs/outbox.scheduler";

const HttpStatus = { NOT_FOUND: 404, BAD_REQUEST: 400, CONFLICT: 409 };
// A hold may be pushed forward while its owner is still settling the payment,
// but never indefinitely: past this lifetime the caller must capture or release.
const HOLD_MAX_LIFETIME_MS = Number(process.env.WALLET_HOLD_MAX_LIFETIME_MS || 24 * 60 * 60 * 1000);
// Where a hold with no explicit destination settles when captured.
const CAPTURE_SYSTEM_CODE = SystemWalletCode.SETTLEMENT;
const prisma = new PrismaClient();

export interface ReleaseExpiredHoldsOptions {
  batchSize?: number;
  instanceId?: string;
  now?: Date;
  walletId?: number;
}

export interface ReleaseExpiredHoldsResult {
  instanceId: string;
  scanned: number;
  released: number;
  skipped: number;
  errors: number;
  durationMs: number;
}

export class WalletHoldService {
  constructor(
    private readonly ledgerService: LedgerService,
    private readonly limitService: LimitService = new LimitService()
  ) { }

  async createHold(
    userId: string,
    amountValue: string,
    referenceId: string,
    expiresAtValue: string,
    ownerType: OwnerType = OwnerType.USER,
    destUserId?: string,
    destOwnerType: OwnerType = OwnerType.USER,
  ) {
    const amount = money(amountValue);
    const expiresAt = new Date(expiresAtValue);
    if (expiresAt.getTime() <= Date.now()) {
      throw new DomainException(HttpStatus.BAD_REQUEST, "INVALID_HOLD_EXPIRY", "expiresAt must be in the future");
    }

    return await prisma.$transaction(async (tx) => {
      // 1. Lock Wallets: Lock Wallet first to avoid deadlock
      const ids = await this.ledgerService.getWalletIds(tx, [
        { userId, ownerType }, ...(destUserId ? [{ userId: destUserId, ownerType: destOwnerType }] : [])
      ]);
      if (ids[0] === ids[1]) throw conflict('SAME_WALLET_TRANSFER', 'Wallets must differ');
      const wallets = await this.ledgerService.lockAndFetchWalletsTx(tx, ids);
      const wallet = wallets[ids[0]], destWallet = destUserId ? wallets[ids[1]] : null;

      const existing = await tx.walletHold.findUnique({
        where: { sourceWalletId_referenceId: { sourceWalletId: wallet.id, referenceId } }
      });

      if (existing) {
        if (!existing.amount.equals(amount) || existing.destinationWalletId !== (destWallet?.id ?? null)) {
          throw conflict("REFERENCE_ID_REUSED", "referenceId was used with a different amount");
        }
        return { hold: existing, replayed: true };
      }

      assertWalletActive(wallet);
      if (destWallet) {
        assertWalletActive(destWallet);
      }

      // 2. Kiểm tra hạn mức TRƯỚC KHI kiểm tra số dư (áp dụng cho USER wallet)
      let usageDay: string | null = null;
      if (wallet.ownerType === OwnerType.USER && wallet.userId) {
        const reserve = await this.limitService.checkAndReserve(
          tx,
          wallet.userId,
          amount,
          wallet.kycTier ?? 0
        );
        usageDay = reserve.usageDay;
      }

      // 3. Kiểm tra số dư khả dụng (sau khi checkAndReserve)
      if (wallet.balance.sub(wallet.heldBalance).lt(amount)) {
        throw insufficientBalance();
      }

      // 4. Cập nhật heldBalance và tạo WalletHold
      await tx.wallet.update({
        where: { id: wallet.id },
        data: { heldBalance: { increment: amount } }
      });

      const hold = await tx.walletHold.create({
        data: {
          sourceWalletId: wallet.id,
          destinationWalletId: destWallet ? destWallet.id : null,
          amount,
          referenceId,
          expiresAt,
          usageDay,
          status: HoldStatus.PENDING,
        }
      });

      return { hold, replayed: false };
    }, { maxWait: 15000, timeout: 25000 });
  }

  // Moves expiresAt forward without touching money: the held amount, the usage
  // reservation and the status all stay as they are. A caller still settling an
  // external payment uses this to keep its hold alive across an outcome it cannot
  // yet observe. Extending is monotonic and PENDING-only, so it can never revive a
  // hold that was already captured or released.
  async extendHold(
    userId: string,
    referenceId: string,
    expiresAtValue: string,
    ownerType: OwnerType = OwnerType.USER,
  ) {
    const requested = new Date(expiresAtValue);
    if (Number.isNaN(requested.getTime())) {
      throw new DomainException(HttpStatus.BAD_REQUEST, "INVALID_HOLD_EXPIRY", "expiresAt must be a valid date");
    }
    if (requested.getTime() <= Date.now()) {
      throw new DomainException(HttpStatus.BAD_REQUEST, "INVALID_HOLD_EXPIRY", "expiresAt must be in the future");
    }

    return await prisma.$transaction(async (tx) => {
      // Same lock order as capture/release/sweeper: the Wallet row comes first so
      // two workers cannot deadlock against each other through WalletHold.
      const wallet = await this.ledgerService.findWalletTx(tx, userId, ownerType);
      const hold = await tx.walletHold.findUnique({
        where: { sourceWalletId_referenceId: { sourceWalletId: wallet.id, referenceId } }
      });

      if (!hold) throw new DomainException(HttpStatus.NOT_FOUND, "HOLD_NOT_FOUND", "Hold was not found");
      if (hold.status === HoldStatus.CAPTURED) {
        throw conflict("HOLD_ALREADY_CAPTURED", "Captured holds cannot be extended");
      }
      if (hold.status !== HoldStatus.PENDING) {
        throw conflict("HOLD_NOT_EXTENDABLE", "Only a pending hold can be extended");
      }

      // A shorter or equal expiry is a replay, not a request to shrink the hold.
      if (requested.getTime() <= hold.expiresAt.getTime()) {
        return { hold, replayed: true, extended: false };
      }
      if (requested.getTime() > hold.createdAt.getTime() + HOLD_MAX_LIFETIME_MS) {
        throw new DomainException(HttpStatus.BAD_REQUEST, "HOLD_LIFETIME_EXCEEDED",
          `A hold may not stay open longer than ${HOLD_MAX_LIFETIME_MS}ms`);
      }

      // Conditional on PENDING and on the expiry still being shorter, so a
      // concurrent release/expiry or a competing extend cannot be overwritten.
      const updated = await tx.walletHold.updateMany({
        where: { id: hold.id, status: HoldStatus.PENDING, expiresAt: { lt: requested } },
        data: { expiresAt: requested }
      });
      if (updated.count !== 1) {
        throw conflict("HOLD_NOT_EXTENDABLE", "Hold is no longer pending");
      }

      const extended = await tx.walletHold.findUnique({ where: { id: hold.id } });
      return { hold: extended!, replayed: false, extended: true };
    }, { maxWait: 15000, timeout: 25000 });
  }

  async captureHold(
    userId: string,
    referenceId: string,
    ownerType: OwnerType = OwnerType.USER,
  ) {
    const result = await prisma.$transaction(async (tx) => {
      const source = await tx.wallet.findUnique({ where: { userId_ownerType: { userId, ownerType } } });
      if (!source) throw new DomainException(404, 'WALLET_NOT_FOUND', 'Wallet not found');
      const candidate = await tx.walletHold.findUnique({ where: { sourceWalletId_referenceId: { sourceWalletId: source.id, referenceId } } });
      if (!candidate) throw new DomainException(404, 'HOLD_NOT_FOUND', 'Hold not found');
      const ids = [source.id];
      if (candidate.destinationWalletId) ids.push(candidate.destinationWalletId);
      else {
        // A hold with no explicit destination is settlement-bound: cash-out and
        // every other platform payment settle into SYSTEM SETTLEMENT (plan §5.4
        // K12). MAIN stays the default for admin adjustments only.
        const system = await tx.wallet.findUniqueOrThrow({ where: { systemCode: CAPTURE_SYSTEM_CODE } });
        ids.push(system.id);
      }
      const wallets = await this.ledgerService.lockAndFetchWalletsTx(tx, ids);
      const wallet = wallets[source.id];
      const hold = await tx.walletHold.findUnique({
        where: { sourceWalletId_referenceId: { sourceWalletId: wallet.id, referenceId } }
      });

      if (!hold) throw new DomainException(HttpStatus.NOT_FOUND, "HOLD_NOT_FOUND", "Hold was not found");

      if (hold.status === HoldStatus.CAPTURED) {
        return { expired: false as const, balance: wallet.balance, transactionId: hold.transactionId, replayed: true };
      }

      if (hold.status === HoldStatus.EXPIRED) {
        throw conflict("HOLD_EXPIRED", "Hold has expired and was released");
      }

      if (hold.status === HoldStatus.RELEASED) {
        throw conflict("HOLD_NOT_CAPTURABLE", "Hold has already been released");
      }

      // Xử lý Hold hết hạn inline
      if (hold.expiresAt.getTime() <= Date.now()) {
        const updated = await tx.walletHold.updateMany({
          where: { id: hold.id, status: HoldStatus.PENDING },
          data: { status: HoldStatus.EXPIRED }
        });

        if (updated.count === 1) {
          const currentHeld = wallet.heldBalance;
          if (currentHeld.lt(hold.amount)) {
            throw new DomainException(
              HttpStatus.BAD_REQUEST,
              'NEGATIVE_HELD_BALANCE',
              `heldBalance (${currentHeld.toString()}) would become negative if hold amount (${hold.amount.toString()}) is deducted`
            );
          }
          await tx.wallet.update({
            where: { id: wallet.id },
            data: { heldBalance: { decrement: hold.amount } }
          });

          // Hoàn hạn mức đúng row usageDay
          const usageDay = hold.usageDay || getVnDay(hold.createdAt);
          if (wallet.userId && wallet.ownerType === OwnerType.USER) {
            await this.limitService.refundUsage(tx, wallet.userId, hold.amount, usageDay);
          }
        }

        // Commit the release and usage refund first. Throwing inside the
        // transaction would roll them back and leave this hold PENDING.
        return { expired: true as const };
      }

      let destWallet;
      if (hold.destinationWalletId) {
        const found = await tx.wallet.findUnique({ where: { id: hold.destinationWalletId } });
        if (!found) throw new DomainException(HttpStatus.NOT_FOUND, "DESTINATION_NOT_FOUND", "Destination wallet not found");
        destWallet = found;
      } else {
        destWallet = await this.ledgerService.getSystemWalletTx(tx, CAPTURE_SYSTEM_CODE);
      }

      const movement = await this.ledgerService.moveMoneyTxInternal(tx, {
        fromWallet: wallet,
        toWallet: destWallet,
        amount: hold.amount,
        referenceId,
        transferType: TransferType.PAYMENT,
        consumeHeldFrom: true,
      });

      await tx.walletHold.update({
        where: { id: hold.id },
        data: {
          status: HoldStatus.CAPTURED,
          transactionId: movement.transactionId
        }
      });

      return {
        expired: false as const,
        balance: movement.sourceWallet.balance,
        transactionId: movement.transactionId,
        replayed: movement.replayed,
      };
    }, { maxWait: 15000, timeout: 25000 });
    if (result.expired) throw conflict("HOLD_EXPIRED", "Hold has expired and was released");
    void drainOutbox().catch(error => {
      console.error('[Wallet Outbox] Post-commit drain failed', error instanceof Error ? error.message : 'unknown error');
    });
    return result;
  }

  // Chuyển đổi theo cơ chế SKIP LOCKED
  // Tránh tình trạng nhiều server chạy song song cùng nhảy vào quét tranh chấp
  async releaseHold(
    userId: string,
    referenceId: string,
    ownerType: OwnerType = OwnerType.USER,
  ) {
    return await prisma.$transaction(async (tx) => {
      const wallet = await this.ledgerService.findWalletTx(tx, userId, ownerType);
      // Khóa ví trước để đảm bảo thứ tự khóa nhất quán (Ví -> Hold)
      await tx.$queryRaw`SELECT id FROM "Wallet" WHERE id = ${wallet.id} FOR UPDATE`;
      const hold = await tx.walletHold.findUnique({
        where: { sourceWalletId_referenceId: { sourceWalletId: wallet.id, referenceId } }
      });

      if (!hold) throw new DomainException(HttpStatus.NOT_FOUND, "HOLD_NOT_FOUND", "Hold was not found");
      if (hold.status === HoldStatus.CAPTURED) throw conflict("HOLD_ALREADY_CAPTURED", "Captured holds cannot be released");
      if (hold.status === HoldStatus.RELEASED || hold.status === HoldStatus.EXPIRED) {
        return { hold, replayed: true };
      }

      const status = hold.expiresAt.getTime() <= Date.now() ? HoldStatus.EXPIRED : HoldStatus.RELEASED;

      // Idempotent state transition: updateMany chỉ thành công khi status đang là PENDING
      const updated = await tx.walletHold.updateMany({
        where: { id: hold.id, status: HoldStatus.PENDING },
        data: { status }
      });

      if (updated.count === 1) {
        const currentHeld = wallet.heldBalance;
        if (currentHeld.lt(hold.amount)) {
          throw new DomainException(
            HttpStatus.BAD_REQUEST,
            'NEGATIVE_HELD_BALANCE',
            `heldBalance (${currentHeld.toString()}) would become negative if hold amount (${hold.amount.toString()}) is deducted`
          );
        }
        await tx.wallet.update({
          where: { id: wallet.id },
          data: { heldBalance: { decrement: hold.amount } }
        });

        // Hoàn lại hạn mức đúng row usageDay
        const usageDay = hold.usageDay || getVnDay(hold.createdAt);
        if (wallet.userId && wallet.ownerType === OwnerType.USER) {
          await this.limitService.refundUsage(tx, wallet.userId, hold.amount, usageDay);
        }
      }

      const updatedHold = await tx.walletHold.findUnique({ where: { id: hold.id } });
      return { hold: updatedHold!, replayed: updated.count === 0 };
    });
  }

  async releaseExpiredHolds(
    optionsOrLimit?: number | ReleaseExpiredHoldsOptions
  ): Promise<ReleaseExpiredHoldsResult & { valueOf(): number }> {
    const startTime = Date.now();
    let batchSize = 100;
    let instanceId = process.env.INSTANCE_ID || process.env.HOSTNAME || randomUUID();
    let now = new Date();
    let walletId: number | undefined;

    if (typeof optionsOrLimit === 'number') {
      batchSize = optionsOrLimit;
    } else if (optionsOrLimit && typeof optionsOrLimit === 'object') {
      if (optionsOrLimit.batchSize !== undefined) batchSize = optionsOrLimit.batchSize;
      if (optionsOrLimit.instanceId !== undefined) instanceId = optionsOrLimit.instanceId;
      if (optionsOrLimit.now !== undefined) now = optionsOrLimit.now;
      if (optionsOrLimit.walletId !== undefined) walletId = optionsOrLimit.walletId;
    } else {
      const envBatch = process.env.WALLET_HOLD_EXPIRY_BATCH_SIZE;
      if (envBatch) {
        const parsed = parseInt(envBatch, 10);
        if (!isNaN(parsed) && parsed > 0) batchSize = parsed;
      }
    }

    const where: Prisma.WalletHoldWhereInput = {
      status: HoldStatus.PENDING,
      expiresAt: { lte: now }
    };
    if (walletId !== undefined) {
      where.sourceWalletId = walletId;
    }

    // 1. Quét danh sách ứng viên (candidate batch) không khóa theo thứ tự expiresAt ASC, id ASC
    const candidates = await prisma.walletHold.findMany({
      where,
      select: {
        id: true,
        sourceWalletId: true
      },
      orderBy: [
        { expiresAt: 'asc' },
        { id: 'asc' }
      ],
      take: batchSize
    });

    const scanned = candidates.length;
    let released = 0;
    let skipped = 0;
    let errors = 0;

    for (const candidate of candidates) {
      try {
        await prisma.$transaction(async (tx) => {
          // Khóa Ví trước để nhất quán thứ tự Ví -> Hold
          const walletRows = await tx.$queryRaw<Array<{
            id: number;
            heldBalance: Prisma.Decimal;
            userId: string | null;
            ownerType: OwnerType;
          }>>`
            SELECT id, "heldBalance", "userId", "ownerType"
            FROM "Wallet"
            WHERE id = ${candidate.sourceWalletId}
            FOR UPDATE
          `;

          if (!walletRows || walletRows.length === 0) {
            skipped++;
            return;
          }
          const wallet = walletRows[0];

          // Khóa Hold với SKIP LOCKED
          const holdRows = await tx.$queryRaw<Array<{
            id: string;
            amount: Prisma.Decimal;
            usageDay: string | null;
            createdAt: Date;
            status: HoldStatus;
            expiresAt: Date;
          }>>`
            SELECT id, amount, "usageDay", "createdAt", status, "expiresAt"
            FROM "WalletHold"
            WHERE id = ${candidate.id}::uuid
              AND status = ${HoldStatus.PENDING}::"HoldStatus"
              AND "expiresAt" <= ${now}
            FOR UPDATE SKIP LOCKED
          `;

          if (!holdRows || holdRows.length === 0) {
            // Đang bị instance khác khóa hoặc trạng thái đã đổi / chưa hết hạn
            skipped++;
            return;
          }

          const hold = holdRows[0];
          const holdAmount = new Prisma.Decimal(hold.amount);
          const currentHeld = new Prisma.Decimal(wallet.heldBalance);

          // Kiểm tra không để heldBalance âm - nếu sắp âm thì rollback transaction đó, không clamp im lặng
          if (currentHeld.lt(holdAmount)) {
            throw new DomainException(
              HttpStatus.BAD_REQUEST,
              'NEGATIVE_HELD_BALANCE',
              `heldBalance (${currentHeld.toString()}) would become negative if hold amount (${holdAmount.toString()}) is deducted`
            );
          }

          const usageDay = hold.usageDay || getVnDay(hold.createdAt);

          // Kiểm tra không để spentDay âm (nếu là USER wallet)
          if (wallet.userId && wallet.ownerType === OwnerType.USER) {
            const usageRows = await tx.$queryRaw<Array<{ spentDay: Prisma.Decimal }>>`
              SELECT "spentDay"
              FROM "UserDailyUsage"
              WHERE "userId" = ${wallet.userId} AND "day" = ${usageDay}
              FOR UPDATE
            `;
            if (usageRows && usageRows.length > 0) {
              const currentSpent = new Prisma.Decimal(usageRows[0].spentDay);
              if (currentSpent.lt(holdAmount)) {
                throw new DomainException(
                  HttpStatus.BAD_REQUEST,
                  'NEGATIVE_SPENT_DAY',
                  `spentDay (${currentSpent.toString()}) would become negative if hold amount (${holdAmount.toString()}) is refunded`
                );
              }
            }
          }

          // Cập nhật WalletHold PENDING -> EXPIRED có điều kiện
          const updated = await tx.walletHold.updateMany({
            where: { id: hold.id, status: HoldStatus.PENDING, expiresAt: { lt: new Date() } },
            data: { status: HoldStatus.EXPIRED }
          });

          if (updated.count !== 1) {
            skipped++;
            return;
          }

          // Trừ đúng amount của hold đó trên heldBalance
          await tx.wallet.update({
            where: { id: wallet.id },
            data: { heldBalance: { decrement: holdAmount } }
          });

          // Hoàn hạn mức đúng row usageDay (trừ trực tiếp không clamp GREATEST, kiểm tra không để âm)
          if (wallet.userId && wallet.ownerType === OwnerType.USER) {
            await this.limitService.refundUsage(tx, wallet.userId, holdAmount, usageDay);
          }

          released++;
        });
      } catch (e: any) {
        errors++;
        console.error(JSON.stringify({
          event: 'HOLD_RELEASE_ERROR',
          instanceId,
          holdId: candidate.id,
          walletId: candidate.sourceWalletId,
          code: e?.code || 'UNKNOWN_ERROR',
          message: e?.message || String(e)
        }));
      }
    }

    const durationMs = Date.now() - startTime;
    const summary = {
      instanceId,
      scanned,
      released,
      skipped,
      errors,
      durationMs,
      valueOf() { return this.released; }
    };

    console.log(JSON.stringify({
      instanceId,
      scanned,
      released,
      skipped,
      errors,
      durationMs
    }));

    return summary;
  }

  async refundCapture(
    userId: string,
    input: {
      referenceId: string;
      originalReferenceId: string;
      amount: string;
    },
    ownerType: OwnerType = OwnerType.USER,
  ) {
    const reqAmount = money(input.amount);

    const result = await prisma.$transaction(async (tx) => {
      // 1. Tìm ví nguồn (ví nhận lại tiền hoàn)
      const source = await tx.wallet.findUnique({
        where: { userId_ownerType: { userId, ownerType } },
      });
      if (!source) {
        throw new DomainException(HttpStatus.NOT_FOUND, 'WALLET_NOT_FOUND', 'Wallet not found');
      }

      // Kiểm tra xem referenceId này đã được sử dụng ở hold nào khác chưa
      const holdWithRef = await tx.walletHold.findFirst({
        where: { refundReferenceId: input.referenceId },
      });

      // 2. Tìm bút toán Hold/Capture gốc theo sourceWalletId và originalReferenceId
      const candidate = await tx.walletHold.findUnique({
        where: {
          sourceWalletId_referenceId: {
            sourceWalletId: source.id,
            referenceId: input.originalReferenceId,
          },
        },
      });

      if (!candidate || (candidate.status !== HoldStatus.CAPTURED && candidate.status !== HoldStatus.REFUNDED)) {
        throw new DomainException(HttpStatus.NOT_FOUND, 'CAPTURE_NOT_FOUND', 'Original capture not found');
      }

      if (holdWithRef && holdWithRef.id !== candidate.id) {
        throw conflict('REFERENCE_ID_REUSED', 'referenceId was used with a different operation');
      }

      // 3. Xác định ví đối ứng (ví bị trừ tiền hoàn):
      //    P2P: ví đích ban đầu (destinationWalletId)
      //    Non-P2P: ví hệ thống SETTLEMENT
      let destWalletId: number;
      if (candidate.destinationWalletId) {
        destWalletId = candidate.destinationWalletId;
      } else {
        const system = await tx.wallet.findUniqueOrThrow({
          where: { systemCode: SystemWalletCode.SETTLEMENT },
        });
        destWalletId = system.id;
      }

      // 4. Khóa cả hai ví theo thứ tự nhất quán để tránh deadlock
      const ids = [source.id, destWalletId];
      const wallets = await this.ledgerService.lockAndFetchWalletsTx(tx, ids);
      const lockedSource = wallets[source.id];
      const lockedFrom = wallets[destWalletId];

      // 5. Re-fetch hold sau khi có lock để chống race condition
      const hold = await tx.walletHold.findUnique({
        where: {
          sourceWalletId_referenceId: {
            sourceWalletId: source.id,
            referenceId: input.originalReferenceId,
          },
        },
      });

      if (!hold || (hold.status !== HoldStatus.CAPTURED && hold.status !== HoldStatus.REFUNDED)) {
        throw new DomainException(HttpStatus.NOT_FOUND, 'CAPTURE_NOT_FOUND', 'Original capture not found');
      }

      // Lũy đẳng và Chống hoàn đôi
      if (hold.status === HoldStatus.REFUNDED) {
        if (hold.refundReferenceId === input.referenceId) {
          if (!hold.amount.equals(reqAmount)) {
            throw conflict('REFERENCE_ID_REUSED', 'referenceId was used with a different operation');
          }
          return {
            transactionId: hold.refundTransactionId || '',
            referenceId: input.referenceId,
            status: 'COMPLETED',
            amount: decimalToString(hold.amount),
            originalReferenceId: input.originalReferenceId,
            createdAt: new Date(),
            replayed: true,
          };
        } else {
          throw conflict('ALREADY_REFUNDED', 'Capture has already been refunded');
        }
      }

      // 6. Kiểm tra số tiền hoàn (chỉ hỗ trợ hoàn toàn phần)
      if (!hold.amount.equals(reqAmount)) {
        throw new DomainException(422, 'AMOUNT_MISMATCH', 'Refund amount does not match original capture amount', {
          capturedAmount: hold.amount.toString(),
          refundAmount: reqAmount.toString(),
        });
      }

      // 7. Kiểm tra số dư ví bị trừ (INSUFFICIENT_FUNDS)
      const available = lockedFrom.balance.sub(lockedFrom.heldBalance);
      if (lockedFrom.ownerType !== OwnerType.SYSTEM && available.lt(reqAmount)) {
        throw new DomainException(422, 'INSUFFICIENT_FUNDS', 'Insufficient available balance for refund', {
          available: decimalToString(available),
          required: decimalToString(reqAmount),
          missing: decimalToString(reqAmount.sub(available)),
        });
      }

      // 8. Thực hiện bút toán đảo chiều (Debit lockedFrom, Credit lockedSource)
      const movement = await this.ledgerService.moveMoneyTxInternal(tx, {
        fromWallet: lockedFrom,
        toWallet: lockedSource,
        amount: reqAmount,
        referenceId: input.referenceId,
        transferType: TransferType.REFUND,
        note: `Refund for ${input.originalReferenceId}`,
      });

      // 9. Cập nhật trạng thái WalletHold thành REFUNDED
      await tx.walletHold.update({
        where: { id: hold.id },
        data: {
          status: HoldStatus.REFUNDED,
          refundReferenceId: input.referenceId,
          refundTransactionId: movement.transactionId,
        },
      });

      return {
        transactionId: movement.transactionId,
        referenceId: input.referenceId,
        status: 'COMPLETED',
        amount: decimalToString(reqAmount),
        originalReferenceId: input.originalReferenceId,
        createdAt: new Date(),
        replayed: movement.replayed,
      };
    }, { maxWait: 15000, timeout: 25000 });

    void drainOutbox().catch(error => {
      console.error('[Wallet Outbox] Post-commit drain failed', error instanceof Error ? error.message : 'unknown error');
    });

    return result;
  }
