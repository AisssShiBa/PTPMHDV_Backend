      await assert.rejects(open(${JSON.stringify(ticket)}),e=>e.message==='INVALID_GATEWAY_TOKEN');
      b=await open(${JSON.stringify(fresh)});console.log('ok');
    }finally{a?.close();b?.close()}})().catch(()=>process.exit(1));`), 'ok')
}

