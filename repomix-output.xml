<file path="services/wallet-service/prisma/schema.prisma">
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OwnerType {
  USER
  MERCHANT
  SYSTEM
}

enum WalletStatus {
  ACTIVE
  LOCKED
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum TransferType {
  TOPUP
  PAYMENT
  REFUND
  P2P_TRANSFER
  ADJUSTMENT
}

enum HoldStatus {
  PENDING
  CAPTURED
  RELEASED
  EXPIRED
  REFUNDED
}

enum SystemWalletCode {
  SETTLEMENT
  FEE
  CLEARING_TOPUP
  MAIN
}

model Wallet {
  id            Int               @id @default(autoincrement())
  userId        String?           @db.VarChar(50)
  ownerType     OwnerType
  systemCode    SystemWalletCode? @unique
  balance       Decimal           @default(0) @db.Decimal(20, 2)
  heldBalance   Decimal           @default(0) @db.Decimal(20, 2)
  currency      String            @default("VND") @db.VarChar(3)
  status        WalletStatus      @default(ACTIVE)
  kycTier       Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  ledgerEntries      LedgerEntry[]
  holdsAsSource      WalletHold[] @relation("HoldSource")
  holdsAsDestination WalletHold[] @relation("HoldDestination")

  @@unique([userId, ownerType])
  @@index([ownerType])
  @@index([ownerType, status])
}

model WalletInbox {
  eventId String @id
  payloadHash String
  processedAt DateTime @default(now())
}

model WalletOutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  topic       String    @db.VarChar(100)
  payload     Json
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
  attempts    Int       @default(0)

  @@index([publishedAt, createdAt])
}

model LedgerEntry {
  id            BigInt          @id @default(autoincrement())
  transactionId String          @db.Uuid
  walletId      Int
  direction     LedgerDirection
  amount        Decimal         @db.Decimal(20, 2)
  balanceAfter  Decimal         @db.Decimal(20, 2)
  referenceId   String          @db.VarChar(255)
  transferType  TransferType
  note          String?         @db.VarChar(500)
  createdAt     DateTime        @default(now())
  wallet        Wallet          @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@unique([walletId, referenceId])
  @@index([transactionId])
  @@index([walletId, createdAt])
  @@index([walletId, createdAt(sort: Desc), id(sort: Desc)])
}

model WalletHold {
  id            String     @id @default(uuid()) @db.Uuid
  sourceWalletId      Int
  destinationWalletId Int?
  amount              Decimal    @db.Decimal(20, 2)
  referenceId         String     @db.VarChar(255)
  status              HoldStatus @default(PENDING)
  transactionId       String?    @db.Uuid
  refundReferenceId   String?    @unique @db.VarChar(255)
  refundTransactionId String?    @db.Uuid
  usageDay            String?    @db.VarChar(10)
  expiresAt           DateTime
  createdAt           DateTime   @default(now())
  sourceWallet        Wallet     @relation("HoldSource", fields: [sourceWalletId], references: [id], onDelete: Restrict)
  destinationWallet   Wallet?    @relation("HoldDestination", fields: [destinationWalletId], references: [id], onDelete: SetNull)

  @@unique([sourceWalletId, referenceId])
  @@index([status, expiresAt])
  @@index([destinationWalletId])
}

model LimitPolicy {
  kycTier   Int      @id
  perTxn    Decimal  @db.Decimal(20, 2)
  perDay    Decimal  @db.Decimal(20, 2)
  perMonth  Decimal  @db.Decimal(20, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserDailyUsage {
  id        BigInt   @id @default(autoincrement())
  userId    String   @db.VarChar(50)
  day       String   @db.VarChar(10)
  monthKey  String   @db.VarChar(7)
  spentDay  Decimal  @default(0) @db.Decimal(20, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, day])
  @@index([userId, monthKey])
}

enum AnomalyType {
  NEGATIVE_BALANCE
  BALANCE_DRIFT_QUICK
  BALANCE_DRIFT_FULL
  TRANSACTION_UNBALANCED
}

model ReconciliationReport {
  id                    Int      @id @default(autoincrement())
  runAt                 DateTime @default(now())
  totalWallets          Int
  anomaliesFound        Int
  systemBalanceExpected Decimal  @db.Decimal(20, 2)
  systemBalanceActual   Decimal  @db.Decimal(20, 2)
  isBalanced            Boolean

  anomalies ReconciliationAnomaly[]

  @@index([runAt])
}

model ReconciliationAnomaly {
  id            BigInt      @id @default(autoincrement())
  reportId      Int
  type          AnomalyType
  walletId      Int?
  transactionId String?     @db.Uuid
  detail        Json

  report ReconciliationReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([type])
  @@index([walletId])
}
</file>

<file path="services/wallet-service/src/routes/wallet.routes.ts">
import { Router } from 'express';
import { requireGatewayOrInternalKey } from '../middlewares/gatewayOrInternalAuth';
import { attachRequestId } from '../middlewares/requestId';
import { requireOwnerOrAdmin } from '../middlewares/requireOwnerOrAdmin';
import { requireInternalOrAdmin } from '../middlewares/requireInternalOrAdmin';
import { validate } from '../middlewares/validate';
import * as walletController from '../controllers/wallet.controller';
import * as schemas from '../validations/wallet.validation';

const router = Router();

// 1. Xác thực: Gateway Token (ES256) hoặc Internal Service Key (timingSafeEqual)
//    KHÔNG còn fallback nào tin x-gateway-verified header do client tự gán.
router.use(requireGatewayOrInternalKey);

// 2. Gán request ID để truy vết log
router.use(attachRequestId);

// 3. Kiểm tra quyền sở hữu ví: user chỉ được tác động lên ví của chính mình,
//    trừ khi là ADMIN (req.auth.role) hoặc internal service call (req.isInternalCall).
//
// TODO(kycTier): Enforce hạn mức chuyển tiền dựa trên req.auth.kycTier khi có spec nghiệp vụ:
//   - kycTier 0 (Chưa KYC): Hạn mức = ?
//   - kycTier 1 (Cơ bản):   Hạn mức = ?
//   - kycTier 2 (Nâng cao):  Hạn mức = không giới hạn (hoặc giới hạn cao)
//   Xem req.auth.kycTier trong controller sau khi requireGateway đã inject.
router.use(requireOwnerOrAdmin);

router.post('/', validate(schemas.createWalletSchema), walletController.create);
router.get('/transactions/lookup', requireInternalOrAdmin, walletController.lookupTransaction);

// K15: Endpoint /me và /me/ledger phải được đăng ký TRƯỚC mọi route /:userId/* để tránh bị nuốt thành params.userId
router.get('/me/ledger', walletController.getMeLedger);
router.get('/me', walletController.getMe);

router.get('/:userId/balance', validate(schemas.ownerIdParamSchema.merge(schemas.ownerTypeQuerySchema)), walletController.getBalance);
router.post('/:userId/hold', requireInternalOrAdmin, validate(schemas.holdSchema), walletController.hold);
router.post('/:userId/hold/extend', requireInternalOrAdmin, validate(schemas.extendSchema), walletController.extend);
router.post('/:userId/capture', requireInternalOrAdmin, validate(schemas.referenceSchema), walletController.capture);
router.post('/:userId/release', requireInternalOrAdmin, validate(schemas.referenceSchema), walletController.release);
router.post('/:userId/refund', requireInternalOrAdmin, validate(schemas.refundSchema), walletController.refund);
router.post('/:userId/transfer', requireInternalOrAdmin, validate(schemas.transferSchema), walletController.transfer);

// credit và debit chỉ dành cho internal service call hoặc ADMIN (không phải USER thông thường)
router.post('/:userId/credit', requireInternalOrAdmin, validate(schemas.creditDebitSchema), walletController.credit);
router.post('/:userId/debit',  requireInternalOrAdmin, validate(schemas.creditDebitSchema), walletController.debit);

router.get('/:userId/history', validate(schemas.historyQuerySchema), walletController.history);

export default router;
</file>

<file path="services/wallet-service/src/services/ledger.service.ts">
import { LedgerDirection, OwnerType, Prisma, PrismaClient, SystemWalletCode, TransferType, Wallet } from "@prisma/client";
import { randomUUID } from "crypto";
import { DomainException } from "../utils/domain.exception";
import { TransferDto, CreditDto, DebitDto } from "../dtos/wallet.dto";
import { assertWalletActive, conflict, decimalToString, insufficientBalance, money } from "../utils/wallet.helpers";

import { LimitService } from "./limit.service";
import { drainOutbox } from "../jobs/outbox.scheduler";
import { isPeerWalletPayment } from "../jobs/wallet-event-routing";

const HttpStatus = { NOT_FOUND: 404, BAD_REQUEST: 400, INTERNAL_SERVER_ERROR: 500 };
const prisma = new PrismaClient();

export class LedgerService {
  constructor(private readonly limitService: LimitService = new LimitService()) {}

  getSystemWalletCode(transferType: TransferType): SystemWalletCode {
    switch (transferType) {
      case TransferType.TOPUP:
        return SystemWalletCode.CLEARING_TOPUP;
      case TransferType.PAYMENT:
      case TransferType.REFUND:
      case TransferType.ADJUSTMENT:
      default:
        return SystemWalletCode.SETTLEMENT;
    }
  }

  async getWalletIds(
    tx: Prisma.TransactionClient, 
    specs: { userId?: string; ownerType: OwnerType; systemCode?: SystemWalletCode }[]
  ): Promise<number[]> {
    const ids: number[] = [];
    for (const spec of specs) {
      if (spec.systemCode) {
        const w = await tx.wallet.findUnique({ where: { systemCode: spec.systemCode }, select: { id: true } });
        if (!w) throw new DomainException(HttpStatus.INTERNAL_SERVER_ERROR, "SYSTEM_WALLET_NOT_FOUND", `System wallet ${spec.systemCode} missing`);
        ids.push(w.id);
      } else if (spec.userId) {
        const w = await tx.wallet.findFirst({ where: { userId: spec.userId, ownerType: spec.ownerType }, select: { id: true } });
        if (!w) throw new DomainException(HttpStatus.NOT_FOUND, "WALLET_NOT_FOUND", "Wallet was not found");
        ids.push(w.id);
      } else if (spec.ownerType === OwnerType.SYSTEM) {
        // Fallback default system wallet: SETTLEMENT
        const w = await tx.wallet.findUnique({ where: { systemCode: SystemWalletCode.SETTLEMENT }, select: { id: true } });
        if (!w) throw new DomainException(HttpStatus.INTERNAL_SERVER_ERROR, "SYSTEM_WALLET_NOT_FOUND", "System wallet SETTLEMENT missing");
        ids.push(w.id);
      }
    }
    return ids;
  }

  async lockAndFetchWalletsTx(tx: Prisma.TransactionClient, ids: number[]): Promise<Record<number, Wallet>> {
    const sortedIds = [...new Set(ids)].sort((a, b) => a - b);
    if (sortedIds.length > 0) {
      await tx.$queryRaw`SELECT id FROM "Wallet" WHERE id IN (${Prisma.join(sortedIds)}) ORDER BY id FOR UPDATE`;
    }
    const wallets = await tx.wallet.findMany({ where: { id: { in: sortedIds } } });
    const map: Record<number, Wallet> = {};
    for (const w of wallets) map[w.id] = w;
    return map;
  }

  async transfer(dto: TransferDto) {
    if (dto.fromUserId === dto.toUserId) {
      throw new DomainException(HttpStatus.BAD_REQUEST, "SAME_WALLET_TRANSFER", "Wallets must differ");
    }
    const amount = money(dto.amount);

    const result = await prisma.$transaction(async (tx) => {
      const ids = await this.getWalletIds(tx, [
        { userId: dto.fromUserId, ownerType: OwnerType.USER },
        { userId: dto.toUserId, ownerType: OwnerType.USER }
      ]);
      const wallets = await this.lockAndFetchWalletsTx(tx, ids);
      const from = wallets[ids[0]];
      const to = wallets[ids[1]];

      const replay = await tx.ledgerEntry.findUnique({
        where: { walletId_referenceId: { walletId: from.id, referenceId: dto.referenceId } }
      });

      if (!replay && from.ownerType === OwnerType.USER && from.userId) {
        await this.limitService.checkAndReserve(tx, from.userId, amount, from.kycTier ?? 0);
      }

      return await this.moveMoneyTxInternal(tx, {
        fromWallet: from,
        toWallet: to,
        amount,
        referenceId: dto.referenceId,
        transferType: TransferType.P2P_TRANSFER,
      });
    }, { maxWait: 15000, timeout: 25000 });
    void drainOutbox().catch(error => {
      console.error("[Wallet Outbox] Post-commit drain failed", error instanceof Error ? error.message : "unknown error");
    });
    return result;
  }

  async credit(userId: string, dto: CreditDto, ownerType: OwnerType = OwnerType.USER) {
    const transferType = dto.transferType ?? TransferType.TOPUP;
    const systemCode = dto.systemCode ?? this.getSystemWalletCode(transferType);
    const amount = money(dto.amount);

    const result = await prisma.$transaction(async (tx) => {
      const ids = await this.getWalletIds(tx, [
        { userId, ownerType },
        { ownerType: OwnerType.SYSTEM, systemCode }
      ]);
      const wallets = await this.lockAndFetchWalletsTx(tx, ids);
      const destination = wallets[ids[0]];
      const systemWallet = wallets[ids[1]];

      return await this.moveMoneyTxInternal(tx, {
        fromWallet: systemWallet,
        toWallet: destination,
        amount,
        referenceId: dto.referenceId,
        transferType,
      });
    });
    void drainOutbox().catch(error => {
      console.error("[Wallet Outbox] Post-commit drain failed", error instanceof Error ? error.message : "unknown error");
    });
    return result;
  }

  async debit(userId: string, dto: DebitDto, ownerType: OwnerType = OwnerType.USER) {
    const transferType = dto.transferType ?? TransferType.PAYMENT;
    const systemCode = dto.systemCode ?? this.getSystemWalletCode(transferType);
    const amount = money(dto.amount);

    const result = await prisma.$transaction(async (tx) => {
      const ids = await this.getWalletIds(tx, [
        { userId, ownerType },
        { ownerType: OwnerType.SYSTEM, systemCode }
      ]);
      const wallets = await this.lockAndFetchWalletsTx(tx, ids);
      const source = wallets[ids[0]];
      const systemWallet = wallets[ids[1]];

      return await this.moveMoneyTxInternal(tx, {
        fromWallet: source,
        toWallet: systemWallet,
        amount,
        referenceId: dto.referenceId,
        transferType,
      });
    });
    void drainOutbox().catch(error => {
      console.error("[Wallet Outbox] Post-commit drain failed", error instanceof Error ? error.message : "unknown error");
    });
    return result;
  }

  async getSystemWalletTx(tx: Prisma.TransactionClient, systemCode: SystemWalletCode = SystemWalletCode.SETTLEMENT): Promise<Wallet> {
    const ids = await this.getWalletIds(tx, [{ ownerType: OwnerType.SYSTEM, systemCode }]);
    const wallets = await this.lockAndFetchWalletsTx(tx, ids);
    return wallets[ids[0]];
  }

  async findWalletTx(tx: Prisma.TransactionClient, userId: string, ownerType: OwnerType): Promise<Wallet> {
    const ids = await this.getWalletIds(tx, [{ userId, ownerType }]);
    const wallets = await this.lockAndFetchWalletsTx(tx, ids);
    return wallets[ids[0]];
  }

  async moveMoneyTxInternal(tx: Prisma.TransactionClient, input: {
    fromWallet: Wallet;
    toWallet: Wallet;
    amount: Prisma.Decimal;
    referenceId: string;
    transferType: TransferType;
    consumeHeldFrom?: boolean;
    bypassLockedFrom?: boolean;
    note?: string;
  }) {
    const { fromWallet, toWallet, amount } = input;

    const replay = await tx.ledgerEntry.findUnique({
      where: { walletId_referenceId: { walletId: fromWallet.id, referenceId: input.referenceId } }
    });

    if (replay) {
      if (
        replay.direction !== LedgerDirection.DEBIT ||
        replay.transferType !== input.transferType ||
        !replay.amount.equals(amount)
      ) {
        throw conflict("REFERENCE_ID_REUSED", "referenceId was used with a different operation");
      }

      const toWalletDb = await tx.wallet.findUnique({ where: { id: toWallet.id } });
      const fromWalletDb = await tx.wallet.findUnique({ where: { id: fromWallet.id } });

      return {
        sourceWallet: fromWalletDb!,
        destinationWallet: toWalletDb!,
        transactionId: replay.transactionId,
        replayed: true,
      };
    }

    assertWalletActive(fromWallet, input.bypassLockedFrom);
    assertWalletActive(toWallet, false);

    if (fromWallet.currency !== toWallet.currency) throw conflict("CURRENCY_MISMATCH", "Wallet currencies must match");

    if (input.consumeHeldFrom) {
      if (fromWallet.heldBalance.lt(amount)) throw conflict("HOLD_BALANCE_INCONSISTENT", "Hold amount exceeds held balance");
      await tx.wallet.update({
        where: { id: fromWallet.id },
        data: { heldBalance: { decrement: amount } }
      });
    } else if (fromWallet.ownerType !== OwnerType.SYSTEM && fromWallet.balance.sub(fromWallet.heldBalance).lt(amount)) {
      throw insufficientBalance();
    }

    const updatedSource = await tx.wallet.update({
      where: { id: fromWallet.id },
      data: { balance: { decrement: amount } }
    });

    const updatedDest = await tx.wallet.update({
      where: { id: toWallet.id },
      data: { balance: { increment: amount } }
    });

    const transactionId = randomUUID();

    await tx.ledgerEntry.create({
      data: {
        transactionId,
        walletId: fromWallet.id,
        direction: LedgerDirection.DEBIT,
        amount,
        balanceAfter: updatedSource.balance,
        referenceId: input.referenceId,
        transferType: input.transferType,
        note: input.note,
      }
    });

    await tx.ledgerEntry.create({
      data: {
        transactionId,
        walletId: toWallet.id,
        direction: LedgerDirection.CREDIT,
        amount,
        balanceAfter: updatedDest.balance,
        referenceId: input.referenceId,
        transferType: input.transferType,
        note: input.note,
      }
    });

    if (fromWallet.ownerType === OwnerType.USER && fromWallet.userId) {
      await tx.walletOutboxEvent.create({
        data: {
          topic: 'wallet.balance_deducted',
          payload: {
            userId: fromWallet.userId,
            amount: decimalToString(amount),
            balanceAfter: decimalToString(updatedSource.balance),
            transferType: input.transferType,
            isPeerTransfer: isPeerWalletPayment(input.transferType, fromWallet.ownerType, toWallet.ownerType),
            referenceId: input.referenceId,
            transactionId,
            note: input.note || '',
          }
        }
      });
    }

    if (toWallet.ownerType === OwnerType.USER && toWallet.userId) {
      await tx.walletOutboxEvent.create({
        data: {
          topic: 'wallet.balance_added',
          payload: {
            userId: toWallet.userId,
            amount: decimalToString(amount),
            balanceAfter: decimalToString(updatedDest.balance),
            transferType: input.transferType,
            isPeerTransfer: isPeerWalletPayment(input.transferType, fromWallet.ownerType, toWallet.ownerType),
            referenceId: input.referenceId,
            transactionId,
            note: input.note || '',
          }
        }
      });
    }

    return {
      sourceWallet: updatedSource,
      destinationWallet: updatedDest,
      transactionId,
      replayed: false,
    };
  }

  async lookupByReferenceId(referenceId: string) {
    const entry = await prisma.ledgerEntry.findFirst({
      where: { referenceId },
      orderBy: { createdAt: 'desc' },
    });
    if (!entry) {
      return { exists: false };
    }
    return {
      exists: true,
      transactionId: entry.transactionId,
      referenceId: entry.referenceId,
      status: 'COMPLETED',
      amount: decimalToString(entry.amount),
      createdAt: entry.createdAt.toISOString(),
    };
  }
}
