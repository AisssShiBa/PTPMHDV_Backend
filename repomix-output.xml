      cwd, env: serviceEnv(name), stdio: 'pipe', windowsHide: true, encoding: 'utf8'
    })
    if (result.status !== 0) {
      console.error(result.error?.message, result.stdout, result.stderr)
      process.exit(result.status || 1)
    }
