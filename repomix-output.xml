      })

      return res.json({
        success: true,
        data: result,
        message: 'Lấy nhật ký kiểm toán thành công'
      })
    } catch (err: any) {
      return res.status(500).json({
        success: false,
        error: {
          code: 'AUDIT_LOG_FETCH_FAILED',
          message: err.message || 'Không thể truy vấn nhật ký kiểm toán'
        }
      })
    }
  }
}
