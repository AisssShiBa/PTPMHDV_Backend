<file path="services/notification-service/scripts/measure-latency.ts">
import 'dotenv/config'
import assert from 'node:assert/strict'
import { randomUUID } from 'node:crypto'
import { performance } from 'node:perf_hooks'
import { io as createSocketClient, type Socket } from 'socket.io-client'
import { createPublisher } from 'finvault-events'
import { createTestGatewayToken } from 'finvault-internal-auth'
import { env } from '../src/config/env'
import { prisma } from '../src/config/prisma'

const socketUrl = process.env.NOTIFICATION_SOCKET_URL ?? `http://localhost:${env.port}`
const userId = process.env.NOTIFICATION_TEST_USER_ID ?? randomUUID()

async function getSocketTicket(): Promise<string> {
  const gatewayToken = process.env.NOTIFICATION_GATEWAY_TOKEN ??
    (env.isProduction
      ? (() => { throw new Error('NOTIFICATION_GATEWAY_TOKEN is required in production') })()
      : createTestGatewayToken(userId))
  const response = await fetch(new URL('/api/notifications/socket-ticket', socketUrl), {
    headers: { 'x-gateway-token': gatewayToken }
  })
  if (!response.ok) throw new Error(`Socket ticket request failed with HTTP ${response.status}`)
  const body: unknown = await response.json()
  if (typeof body !== 'object' || body === null || !('data' in body) ||
      typeof body.data !== 'object' || body.data === null ||
      !('ticket' in body.data) || typeof body.data.ticket !== 'string') {
    throw new Error('Socket ticket response is malformed')
  }
  return body.data.ticket
}

function connectSocket(ticket: string): Promise<Socket> {
  const socket = createSocketClient(socketUrl, {
    auth: { ticket },
    autoConnect: false,
    forceNew: true,
    reconnection: false,
    timeout: 3000,
    transports: ['websocket']
  })
  return new Promise((resolve, reject) => {
    socket.once('connect', () => resolve(socket))
    socket.once('connect_error', error => {
      socket.close()
      reject(error)
    })
    socket.connect()
  })
}

function waitForEvent(socket: Socket, eventId: string): Promise<number> {
  return new Promise((resolve, reject) => {
    const timeout = setTimeout(() => {
      socket.off('notification:new', listener)
      reject(new Error(`Timed out waiting for notification event ${eventId}`))
    }, 10_000)
    const listener = (notification: { eventId?: string }) => {
      if (notification.eventId !== eventId) return
      clearTimeout(timeout)
      socket.off('notification:new', listener)
      resolve(performance.now())
    }
    socket.on('notification:new', listener)
  })
}

async function main(): Promise<void> {
  if (!env.rabbitmqUrl) throw new Error('RABBITMQ_URL is required')
  const publisher = createPublisher({ url: env.rabbitmqUrl })
  let socket: Socket | undefined
  const eventIds: string[] = []
  const samples: number[] = []
  const rows: { iteration: number; eventId: string; latencyMs: string; result: string }[] = []

  try {
    socket = await connectSocket(await getSocketTicket())
    for (let index = 1; index <= 10; index += 1) {
      const eventId = randomUUID()
      eventIds.push(eventId)
      const received = waitForEvent(socket, eventId)
      await publisher.publish({
        eventId,
        eventType: 'payment.succeeded',
        eventVersion: 1,
        occurredAt: new Date().toISOString(),
        data: {
          paymentId: randomUUID(),
          senderId: randomUUID(),
          receiverId: userId,
          amount: '50000'
        }
      })
      const publishResolvedAt = performance.now()
      const receivedAt = await received
      const latencyMs = Math.max(0, receivedAt - publishResolvedAt)
      samples.push(latencyMs)
      rows.push({
        iteration: index,
        eventId,
        latencyMs: latencyMs.toFixed(1),
        result: latencyMs <= 3000 ? 'PASS' : 'FAIL'
      })
    }

    const withinThreshold = samples.filter(sample => sample <= 3000).length
    console.log('R1 acceptance path: publisher confirm -> RabbitMQ -> notification consumer -> Socket.IO')
    console.table(rows)
    console.log(`R1 result: ${withinThreshold}/10 samples <= 3000 ms`)
    console.log(`R1 conclusion: ${withinThreshold >= 9 ? 'PASS' : 'FAIL'} (at least 9/10 <= 3000 ms)`)
    console.log('Limitation: this test publishes a synthetic event directly; it does not measure payment HTTP confirmation or database Outbox scheduling.')
    assert.ok(withinThreshold >= 9, `Expected at least 9/10 samples <= 3000 ms; got ${withinThreshold}/10`)
  } finally {
    socket?.close()
    await publisher.close()
    if (eventIds.length > 0) {
      await prisma.notification.deleteMany({ where: { eventId: { in: eventIds } } })
      await prisma.notificationInbox.deleteMany({ where: { eventId: { in: eventIds } } })
    }
    await prisma.$disconnect()
  }
}

void main().catch((error: unknown) => {
  console.error('R1 measurement failed:', error)
  process.exitCode = 1
})
</file>

<file path="services/notification-service/src/controllers/deviceController.ts">
import type { DevicePlatform } from '@prisma/client'
import { Request, Response } from 'express'
import { notificationIO } from '../socket'
import {
  DEVICE_ID_PATTERN,
  DeviceLimitReachedError,
  PUSH_TOKEN_MAX_LENGTH,
  listDevices,
  registerDevice,
  revokeDevice,
  toDeviceView
} from '../services/deviceService'

const PLATFORMS: readonly DevicePlatform[] = ['IOS', 'ANDROID', 'WEB']
const UUID_PATTERN = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i

const fail = (req: Request, res: Response, status: number, code: string, message: string) =>
  res.status(status).json({
    success: false,
    error: { code, message },
    requestId: req.get('x-request-id')
  })

const parseBody = (value: unknown): { deviceId: string; platform: DevicePlatform; pushToken?: string } | undefined => {
  if (typeof value !== 'object' || value === null || Array.isArray(value)) return undefined
  const body = value as Record<string, unknown>
  const { deviceId, platform, pushToken } = body
  if (typeof deviceId !== 'string' || deviceId.length < 1 || deviceId.length > 128 ||
      !DEVICE_ID_PATTERN.test(deviceId)) return undefined
  if (typeof platform !== 'string' || !PLATFORMS.includes(platform as DevicePlatform)) return undefined
  if (pushToken !== undefined && pushToken !== null &&
      (typeof pushToken !== 'string' || pushToken.length > PUSH_TOKEN_MAX_LENGTH)) return undefined
  return {
    deviceId,
    platform: platform as DevicePlatform,
    ...(pushToken === undefined || pushToken === null
      ? {}
      : { pushToken })
  }
}

export const createDevice = async (req: Request, res: Response) => {
  const userId = req.auth?.userId
  if (!userId) return fail(req, res, 401, 'INVALID_GATEWAY_TOKEN', 'Gateway Token không hợp lệ hoặc đã hết hạn.')

  const input = parseBody(req.body)
  if (!input) {
    return fail(req, res, 400, 'VALIDATION_ERROR',
      'deviceId, platform hợp lệ là bắt buộc; pushToken tối đa 512 ký tự.')
  }

  try {
    const { device, created } = await registerDevice(userId, input)
    return res.status(created ? 201 : 200).json({
      success: true,
      data: toDeviceView(device)
    })
  } catch (error) {
    if (error instanceof DeviceLimitReachedError) {
      return fail(req, res, 409, 'DEVICE_LIMIT_REACHED', error.message)
    }
    throw error
  }
}

export const getDevices = async (req: Request, res: Response) => {
  const userId = req.auth?.userId
  if (!userId) return fail(req, res, 401, 'INVALID_GATEWAY_TOKEN', 'Gateway Token không hợp lệ hoặc đã hết hạn.')

  const devices = await listDevices(userId)
  return res.status(200).json({
    success: true,
    data: { devices: devices.map(toDeviceView) }
  })
}

export const deleteDevice = async (req: Request, res: Response) => {
  const userId = req.auth?.userId
  if (!userId) return fail(req, res, 401, 'INVALID_GATEWAY_TOKEN', 'Gateway Token không hợp lệ hoặc đã hết hạn.')

  const id = String(req.params.id ?? '')
  if (!UUID_PATTERN.test(id)) {
    return fail(req, res, 400, 'VALIDATION_ERROR', 'id thiết bị phải là UUID hợp lệ.')
  }

  const device = await revokeDevice(userId, id)
  if (!device) {
    // Do not disclose whether the device exists for another user.
    return fail(req, res, 404, 'NOT_FOUND', 'Không tìm thấy thiết bị.')
  }

  try {
    notificationIO?.in(`device:${device.userId}:${device.deviceId}`).disconnectSockets(true)
  } catch (error) {
    // A socket failure must not make the revocation response fail.
    console.error('[Socket] Không thể ngắt socket của thiết bị đã thu hồi:', error)
  }

  return res.status(200).json({
    success: true,
    data: toDeviceView(device)
  })
}
</file>

