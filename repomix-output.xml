<file path="services/notification-service/src/socket.ts">
import type { Server } from 'socket.io'
import type { Server as HttpServer } from 'node:http'
import { Server as SocketIOServer } from 'socket.io'
import { verifyGatewayToken } from 'finvault-internal-auth'
import { env } from './config/env'

export let notificationIO: Server | null = null
const usedTickets = new Map<string, number>()
const ticketCleanupInterval = setInterval(() => {
  const now = Date.now()
  for (const [jti, expiresAt] of usedTickets) {
    if (expiresAt <= now) usedTickets.delete(jti)
  }
}, 60_000)
ticketCleanupInterval.unref()

export const setNotificationIO = (io: Server) => {
  notificationIO = io
}

export const createSocketServer = (
  httpServer: HttpServer,
  options: { maxAgeMs?: number } = {}
) => {
  const io = new SocketIOServer(httpServer, {
    cors: {
      origin: env.clientUrl,
      credentials: true
    }
  })
  const maxAgeMs = options.maxAgeMs ?? env.socketMaxAgeMs

  io.use((socket, next) => {
    const token = socket.handshake.auth?.token
    if (typeof token !== 'string' || token.length === 0) {
      return next(new Error('INVALID_GATEWAY_TOKEN'))
    }

    try {
      const auth = verifyGatewayToken(token)
      if (!auth.jti || usedTickets.has(auth.jti)) {
        return next(new Error('INVALID_GATEWAY_TOKEN'))
      }

      // Ticket chỉ chứng minh danh tính user này trong tối đa 60 giây; không ghi giá trị ticket vào log.
      // Map trong bộ nhớ chỉ chống dùng lại trên một instance; nhiều instance cần Redis.
      usedTickets.set(auth.jti, Date.now() + 60_000)
      socket.data.userId = auth.userId
      return next()
    } catch {
      return next(new Error('INVALID_GATEWAY_TOKEN'))
    }
  })

  io.on('connection', (socket) => {
    socket.join(`user:${socket.data.userId}`)
    const disconnectTimer = setTimeout(() => socket.disconnect(true), maxAgeMs)
    socket.once('disconnect', () => clearTimeout(disconnectTimer))
  })

  setNotificationIO(io)
  return io
}
</file>

<file path="services/notification-service/tests/notificationInbox.test.ts">
import assert from 'node:assert/strict'
import { randomUUID } from 'node:crypto'
import { test } from 'node:test'
import { prisma } from '../src/config/prisma'
import { decideRetry, parseEvent } from '../src/services/rabbitmqConsumer'
import {
  ingestNotification,
  isNotificationType,
  NotificationIngestError
} from '../src/services/notificationService'

const notificationPayload = {
  userId: `notification-inbox-user-${randomUUID()}`,
  type: 'PAYMENT_EXPIRED' as const,
  message: 'Payment expired'
}

test('consumer uses body.eventId before AMQP messageId', () => {
  const event = parseEvent({
    content: Buffer.from(JSON.stringify({
      eventId: 'body-event-id',
      data: notificationPayload
    })),
    properties: { messageId: 'amqp-message-id' }
  })

  assert.equal(event.eventId, 'body-event-id')
  assert.equal(event.type, 'PAYMENT_EXPIRED')
  assert.equal(isNotificationType('KYC_TIER_CHANGED'), true)
})

test('consumer parses a flat event and falls back to AMQP messageId', () => {
  const event = parseEvent({
    content: Buffer.from(JSON.stringify(notificationPayload)),
    properties: { messageId: 'flat-message-id' }
  })

  assert.equal(event.eventId, 'flat-message-id')
  assert.equal(event.userId, notificationPayload.userId)
  assert.equal(event.type, notificationPayload.type)
  assert.equal(event.message, notificationPayload.message)
})

test('consumer parses an envelope event using its eventType and data', () => {
  const event = parseEvent({
    content: Buffer.from(JSON.stringify({
      eventId: 'envelope-event-id',
      eventType: 'PAYMENT_EXPIRED',
      eventVersion: 1,
      occurredAt: new Date().toISOString(),
      data: notificationPayload
    })),
    properties: { messageId: 'amqp-message-id' }
  })

  assert.equal(event.eventId, 'envelope-event-id')
  assert.equal(event.type, 'PAYMENT_EXPIRED')
  assert.equal(event.userId, notificationPayload.userId)
})

test('consumer falls back to AMQP messageId when body.eventId is missing', () => {
  const event = parseEvent({
    content: Buffer.from(JSON.stringify({ payload: notificationPayload })),
    properties: { messageId: 'amqp-message-id' }
  })

  assert.equal(event.eventId, 'amqp-message-id')
})

test('consumer rejects an event without a user ID', () => {
  assert.throws(
    () => parseEvent({
      content: Buffer.from(JSON.stringify({
        type: 'PAYMENT_EXPIRED',
        message: 'Payment expired'
      })),
      properties: {}
    }),
    { name: 'InvalidNotificationEventError' }
  )
})

test('temporary failures retry three times before the fourth delivery goes to DLQ', () => {
  assert.deepEqual(decideRetry(0), { action: 'retry', retryCount: 1 })
  assert.deepEqual(decideRetry(1), { action: 'retry', retryCount: 2 })
  assert.deepEqual(decideRetry(2), { action: 'retry', retryCount: 3 })
  assert.deepEqual(decideRetry(3), { action: 'dead-letter' })
})

test('notification inbox deduplicates identical event deliveries', async () => {
  const eventId = `notification-event-${randomUUID()}`
  let created = false
  try {
    const first = await ingestNotification({
      ...notificationPayload,
      eventId,
      source: 'payment.events'
    })
    created = true
    const duplicate = await ingestNotification({
      ...notificationPayload,
      eventId,
      source: 'payment.events'
    })

    assert.equal(first.duplicate, false)
    assert.equal(duplicate.duplicate, true)
    assert.equal(await prisma.notification.count({ where: { eventId } }), 1)
  } finally {
    if (created) {
      await prisma.notificationInbox.deleteMany({ where: { eventId } })
      await prisma.notification.deleteMany({ where: { eventId } })
    }
  }
})

test('notification inbox deduplicates twenty concurrent deliveries', async () => {
  const eventId = `notification-event-${randomUUID()}`
  try {
    const results = await Promise.all(
      Array.from({ length: 20 }, () =>
        ingestNotification({
          ...notificationPayload,
          eventId,
          source: 'payment.events'
        })
      )
    )

    assert.equal(results.filter((result) => !result.duplicate).length, 1)
    assert.equal(results.filter((result) => result.duplicate).length, 19)
    assert.equal(await prisma.notification.count({ where: { eventId } }), 1)
    assert.equal(await prisma.notificationInbox.count({ where: { eventId } }), 1)
  } finally {
    await prisma.notificationInbox.deleteMany({ where: { eventId } })
    await prisma.notification.deleteMany({ where: { eventId } })
  }
})

test('notification inbox rejects reuse of an eventId with different content', async () => {
  const eventId = `notification-event-${randomUUID()}`
  let created = false
  try {
    await ingestNotification({ ...notificationPayload, eventId, source: 'payment.events' })
    created = true

    await assert.rejects(
      ingestNotification({
        ...notificationPayload,
        eventId,
        message: 'Different message',
        source: 'payment.events'
      }),
      (error: unknown) => error instanceof NotificationIngestError && error.code === 'EVENT_CONFLICT'
    )
  } finally {
    if (created) {
      await prisma.notificationInbox.deleteMany({ where: { eventId } })
      await prisma.notification.deleteMany({ where: { eventId } })
    }
  }
})
</file>

<file path="services/notification-service/TESTING.md">
# Notification service tests

The test suite uses a real PostgreSQL database through `DATABASE_URL`.
Use a dedicated test database: route and inbox tests create database records.
Those tests clean up the records they create; do not point them at production data.

From the repository root, configure a local test database, apply migrations,
then run the service tests:

```powershell
$env:DATABASE_URL = "postgresql://postgres:password@localhost:5432/notification_service_test"
Set-Location services/notification-service
npx prisma migrate deploy
npm test
```

The database must be running and reachable before applying migrations or testing.
`npm test` runs auth, notification route, socket, and inbox tests.
The current tests do not connect to RabbitMQ; the consumer broker is not required.
For a manual broker smoke test, start RabbitMQ, configure `RABBITMQ_URL`, run
`npx tsx scripts/publish-test-event.ts`, and observe one notification/socket
event for its two publishes. The script uses a fixed event ID; set
`NOTIFICATION_TEST_EVENT_ID` to a new value for an independent run.
Malformed broker messages are dead-lettered to `notification-service.dlq`.
</file>

