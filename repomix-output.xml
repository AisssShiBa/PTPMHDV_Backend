import { randomUUID } from 'node:crypto'
import { EventEmitter } from 'node:events'
import { setTimeout as delay } from 'node:timers/promises'
import amqp, { type ChannelModel, type ConfirmChannel, type ConsumeMessage, type Options } from 'amqplib'
import {
  createConsumer,
  createInMemoryInbox,
  createPublisher,
  type FinvaultEvent
} from '../src'
import { processConsumerMessage } from '../src/consumer'

const url = process.env.RABBITMQ_URL
const queue = `demo.finvault.events.${process.pid}`
const tierChanges: string[] = []
const inbox = createInMemoryInbox()
const normalId = randomUUID()
const failingId = randomUUID()

class FakeConfirmChannel extends EventEmitter {
  published: Array<{ key: string; options: Options.Publish }> = []
  acked = 0
  nacked = 0

  publish(
    _exchange: string,
    key: string,
    _content: Buffer,
    options: Options.Publish,
    callback?: (error: Error | null) => void
  ): boolean {
    this.published.push({ key, options })
    queueMicrotask(() => callback?.(null))
    return true
  }

  ack(): void { this.acked += 1 }
  nack(): void { this.nacked += 1 }
}

function kycEvent(eventId: string): FinvaultEvent {
  return {
    eventId,
    eventType: 'user.kyc_updated',
    eventVersion: 1,
    occurredAt: new Date().toISOString(),
    data: { authUserId: 'auth-user-demo', kycTier: 2, previousTier: 1 }
  }
}

async function runFake(): Promise<void> {
  console.log('MODE: FAKE CHANNEL (no RabbitMQ connection)')
  const channel = new FakeConfirmChannel()
  const options = {
    url: 'amqp://fake',
    queue: 'demo.finvault.events.fake',
    bindings: ['user.kyc_updated'],
    inbox,
    maxRetries: 2,
    retryDelaysMs: [10, 20],
    handlers: {
      'user.kyc_updated': async (event: FinvaultEvent) => {
        if (event.eventId === failingId) throw new Error('intentional demo failure')
        tierChanges.push(event.eventId)
      }
    }
  }
  const deliver = async (message: FinvaultEvent, headers: Record<string, unknown> = {}) => {
    const retryCount = Number(headers['x-retry-count'] ?? 0)
    const routingKey = retryCount > 0 ? options.queue : message.eventType
    await processConsumerMessage(channel as unknown as ConfirmChannel, {
      content: Buffer.from(JSON.stringify(message)),
      fields: { exchange: 'finvault.events', routingKey },
      properties: { messageId: message.eventId, type: message.eventType, headers }
    } as unknown as ConsumeMessage, options)
  }

  console.log('publish user.kyc_updated v1')
  await deliver(kycEvent(normalId))
  await deliver(kycEvent(normalId))
  console.log(`duplicate delivered; mutation count=${tierChanges.length}`)

  const failedEvent = kycEvent(failingId)
  let currentHeaders: Record<string, unknown> = {}
  await deliver(failedEvent)
  while (channel.published.at(-1)?.key === `${options.queue}.retry`) {
    currentHeaders = channel.published.at(-1)!.options.headers as Record<string, unknown>
    console.log(`retry ${String(currentHeaders['x-retry-count'])}`)
    await deliver(failedEvent, currentHeaders)
  }
  const dlq = channel.published.at(-1)
  console.log(`DLQ ${failingId}: ${String(dlq?.options.headers?.['x-dlq-reason'])}`)
}

async function runRabbit(): Promise<void> {
  const publisher = createPublisher({ url: url! })
  const consumer = createConsumer({
    url: url!,
    queue,
    bindings: ['user.kyc_updated'],
    inbox,
    maxRetries: 2,
    retryDelaysMs: [250, 500],
    handlers: {
      'user.kyc_updated': async event => {
        if (event.eventId === failingId) throw new Error('intentional demo failure')
        tierChanges.push(event.eventId)
        firstMutationDone()
        console.log(`mutation applied for ${event.eventId}`)
      }
    }
  })
  let resolveFirstMutation!: () => void
  const firstMutation = new Promise<void>(resolve => { resolveFirstMutation = resolve })
  function firstMutationDone(): void { resolveFirstMutation() }
  let resolveDeadLetter!: () => void
  const deadLetterObserved = new Promise<void>(resolve => { resolveDeadLetter = resolve })
  let observerConnection: ChannelModel | undefined
  let observerChannel: ConfirmChannel | undefined

  try {
    await consumer.start()
    observerConnection = await amqp.connect(url!)
    observerChannel = await observerConnection.createConfirmChannel()
    await observerChannel.consume(`${queue}.dlq`, message => {
      if (!message) return
      console.log(`DLQ received ${message.properties.messageId}: ${String(message.properties.headers?.['x-dlq-reason'])}`)
      observerChannel?.ack(message)
      resolveDeadLetter()
    })
    await publisher.publish(kycEvent(normalId))
    await Promise.race([firstMutation, delay(5000).then(() => { throw new Error('Timed out waiting for first KYC mutation') })])
    await publisher.publish(kycEvent(normalId))
    console.log('same eventId published again; inbox suppresses the second mutation')
    await publisher.publish({ ...kycEvent(failingId), data: { authUserId: 'auth-user-demo', kycTier: 1, previousTier: 0 } })
    await Promise.race([deadLetterObserved, delay(5000).then(() => { throw new Error('Timed out waiting for DLQ delivery') })])
    console.log(`mutation count=${tierChanges.length}`)
  } finally {
    await publisher.close()
    await consumer.stop()
    await observerChannel?.close().catch(() => {})
    await observerConnection?.close().catch(() => {})
  }
}

async function main(): Promise<void> {
  if (url) await runRabbit()
  else await runFake()
}

void main().catch(error => {
  console.error(error)
  process.exitCode = 1
})
</file>

<file path="packages/finvault-events/src/broker.ts">
import type { ConfirmChannel, Options } from 'amqplib'
import { randomUUID } from 'node:crypto'

export interface EventLogger {
  info?(message: string, context: { eventId?: string; eventType?: string }): void
  error?(message: string, context: { eventId?: string; eventType?: string }): void
}

export class BrokerPublishError extends Error {
  constructor(message: string, public readonly code: string) {
    super(message)
    this.name = 'BrokerPublishError'
  }
}

interface PendingConfirmation {
  messageId: string
  finish: (error?: Error | null) => void
  markReturned: () => void
}

interface ConfirmationState {
  pending: Set<PendingConfirmation>
}

const confirmationStates = new WeakMap<ConfirmChannel, ConfirmationState>()

function getConfirmationState(channel: ConfirmChannel): ConfirmationState {
  const existing = confirmationStates.get(channel)
  if (existing) return existing

  const state: ConfirmationState = { pending: new Set() }
  confirmationStates.set(channel, state)
  channel.on('return', message => {
    const messageId = message.properties.messageId
    for (const pending of state.pending) {
      if (pending.messageId === messageId) pending.markReturned()
    }
  })
  channel.on('close', () => {
    for (const pending of [...state.pending]) {
      pending.finish(new BrokerPublishError('Publisher channel closed before confirmation', 'CHANNEL_CLOSED'))
    }
  })
  return state
}

export function publishConfirmed(
  channel: ConfirmChannel,
  exchange: string,
  routingKey: string,
  content: Buffer,
  options: Options.Publish,
  timeoutMs: number
): Promise<void> {
  const messageId = options.messageId ?? randomUUID()
  const state = getConfirmationState(channel)
  return new Promise<void>((resolve, reject) => {
    let settled = false
    let returned = false
    const finish = (error?: Error | null) => {
      if (settled) return
      settled = true
      clearTimeout(timer)
      state.pending.delete(pending)
      if (error) reject(error)
      else if (returned) reject(new BrokerPublishError('Broker returned an unroutable event', 'UNROUTABLE_EVENT'))
      else resolve()
    }
    const pending: PendingConfirmation = {
      messageId,
      finish,
      markReturned: () => { returned = true }
    }
    const timer = setTimeout(() => finish(new BrokerPublishError('Timed out waiting for broker confirmation', 'PUBLISH_TIMEOUT')), timeoutMs)

    state.pending.add(pending)
    try {
      channel.publish(exchange, routingKey, content, { ...options, messageId, mandatory: true }, error => finish(error))
    } catch (error) {
      finish(error instanceof Error ? error : new BrokerPublishError('Publish failed', 'PUBLISH_FAILED'))
    }
  })
}
</file>

<file path="packages/finvault-events/src/consumer.ts">
import amqp, { type Channel, type ChannelModel, type ConfirmChannel, type ConsumeMessage, type Options } from 'amqplib'
import { randomUUID } from 'node:crypto'
import { setTimeout as delay } from 'node:timers/promises'
import { BrokerPublishError, type EventLogger, publishConfirmed } from './broker'
import { type EventHandler, type InboxAdapter } from './inbox'
import { eventPayloadHash, EventValidationError, parseFinvaultEvent, type FinvaultEvent } from './schemas'

export class NonRetryableError extends Error {
  public readonly code: string

  constructor(message: string, code = 'NON_RETRYABLE') {
    super(message)
    if (!/^[A-Z][A-Z0-9_]{0,63}$/.test(code)) {
      throw new TypeError('NonRetryableError code must be a short uppercase identifier')
    }
    this.code = code
    this.name = 'NonRetryableError'
  }
}

export interface ConsumerOptions {
  url: string
  queue: string
  bindings: string[]
  exchange?: string
  prefetch?: number
  maxRetries?: number
  retryDelaysMs?: number[]
  ignoredEventTypes?: string[]
  confirmTimeoutMs?: number
  reconnectDelayMs?: number
  allowLegacyKycUpdated?: boolean
  inbox: InboxAdapter
  handlers: Record<string, EventHandler>
  logger?: EventLogger
}

export interface EventConsumer {
  start(): Promise<void>
  stop(): Promise<void>
}

export async function assertConsumerTopology(
  channel: Channel,
  options: Pick<ConsumerOptions, 'queue' | 'bindings' | 'exchange' | 'retryDelaysMs'>
): Promise<void> {
  const exchange = options.exchange ?? 'finvault.events'
  const retryDelaysMs = options.retryDelaysMs ?? [1000, 5000, 30000]
  await channel.assertExchange(exchange, 'topic', { durable: true })
  await channel.assertQueue(options.queue, { durable: true })
  for (const binding of options.bindings) {
    await channel.bindQueue(options.queue, exchange, binding)
  }
  for (const delayMs of new Set(retryDelaysMs)) {
    await channel.assertQueue(`${options.queue}.retry.${delayMs}`, {
      durable: true,
      arguments: {
        'x-message-ttl': delayMs,
        'x-dead-letter-exchange': '',
        'x-dead-letter-routing-key': options.queue
      }
    })
  }
  await channel.assertQueue(`${options.queue}.dlq`, { durable: true })
}

function retryCount(message: ConsumeMessage): number {
  const value = message.properties.headers?.['x-retry-count']
  if (typeof value === 'number' && Number.isSafeInteger(value) && value >= 0) return value
  if (typeof value === 'string' && /^\d+$/.test(value) && Number.isSafeInteger(Number(value))) return Number(value)
  return 0
}

function eventTypeHint(message: ConsumeMessage): string {
  return message.properties.type ?? message.fields.routingKey
}

function safeHeaderString(value: unknown): string {
  return typeof value === 'string' ? value.slice(0, 200) : ''
}

function forwardedHeaders(headers: Record<string, unknown> | undefined): Record<string, unknown> {
  const allowed = new Set([
    'x-event-version',
    'x-retry-count',
    'x-original-routing-key',
    'x-death'
  ])
  return Object.fromEntries(Object.entries(headers ?? {}).filter(([key]) => allowed.has(key)))
}

function logError(logger: EventLogger | undefined, message: string, context: { eventId?: string; eventType?: string }): void {
  if (logger?.error) logger.error(message, context)
  else console.error('[finvault-events]', message, context)
}

function logInfo(logger: EventLogger | undefined, message: string, context: { eventId: string; eventType: string }): void {
  if (logger?.info) logger.info(message, context)
  else console.info('[finvault-events]', message, context)
}

async function publishToQueue(
  channel: ConfirmChannel,
  queue: string,
  message: ConsumeMessage,
  headers: Record<string, unknown>,
  timeoutMs: number
): Promise<void> {
  await publishConfirmed(channel, '', queue, message.content, {
    persistent: true,
    contentType: message.properties.contentType ?? 'application/json',
    type: message.properties.type,
    messageId: message.properties.messageId ?? randomUUID(),
    correlationId: message.properties.correlationId,
    headers: { ...forwardedHeaders(message.properties.headers), ...headers }
  } satisfies Options.Publish, timeoutMs)
}

async function deadLetter(
  channel: ConfirmChannel,
  options: ConsumerOptions,
  message: ConsumeMessage,
  reason: string,
  count: number,
  timeoutMs: number
): Promise<void> {
  await publishToQueue(channel, `${options.queue}.dlq`, message, {
    'x-dlq-reason': reason,
    'x-original-routing-key': safeHeaderString(message.properties.headers?.['x-original-routing-key']) ||
      message.fields.routingKey,
    'x-retry-count': count,
    'x-failed-at': new Date().toISOString()
  }, timeoutMs)
  channel.ack(message)
}

export async function processConsumerMessage(
  channel: ConfirmChannel,
  message: ConsumeMessage,
  options: ConsumerOptions
): Promise<void> {
  const maxRetries = options.maxRetries ?? 3
  const retryDelaysMs = options.retryDelaysMs ?? [1000, 5000, 30000]
  const confirmTimeoutMs = options.confirmTimeoutMs ?? 10000
  const count = retryCount(message)
  let event: FinvaultEvent
  try {
    const value: unknown = JSON.parse(message.content.toString('utf8'))
    event = parseFinvaultEvent(value, { allowLegacyKycUpdated: options.allowLegacyKycUpdated })
    const originalRoutingKey = safeHeaderString(message.properties.headers?.['x-original-routing-key']) ||
      message.fields.routingKey
    if (event.eventType !== originalRoutingKey || (count === 0 && event.eventType !== message.fields.routingKey)) {
      throw new EventValidationError('Routing key must match eventType', 'INVALID_ENVELOPE')
    }
  } catch (error) {
    const reason = error instanceof EventValidationError ? error.reason : 'INVALID_JSON'
    await deadLetter(channel, options, message, reason, count, confirmTimeoutMs)
    return
  }

  const handler = options.handlers[event.eventType]
  if (options.ignoredEventTypes?.includes(event.eventType)) {
    logInfo(options.logger, 'Ignoring configured FinVault event', {
      eventId: event.eventId,
      eventType: event.eventType
    })
    channel.ack(message)
    return
  }
  if (!handler) {
    await deadLetter(channel, options, message, 'NO_HANDLER', count, confirmTimeoutMs)
    return
  }

  try {
    const result = await options.inbox.runOnce(
      { eventId: event.eventId, eventType: event.eventType, payloadHash: eventPayloadHash(event) },
      tx => handler(event, { tx })
    )
    if (result.status === 'duplicate') {
      channel.ack(message)
      return
    }
    if (result.status === 'conflict') {
      await deadLetter(channel, options, message, 'EVENT_CONFLICT', count, confirmTimeoutMs)
      return
    }
    channel.ack(message)
  } catch (error) {
    const reason = error instanceof NonRetryableError ? error.code : undefined
    if (reason) {
      await deadLetter(channel, options, message, reason, count, confirmTimeoutMs)
      return
    }
    if (count >= maxRetries || retryDelaysMs.length === 0) {
      await deadLetter(channel, options, message, 'MAX_RETRIES_EXCEEDED', count, confirmTimeoutMs)
      return
    }
    const delayMs = retryDelaysMs[Math.min(count, retryDelaysMs.length - 1)]
    try {
      await publishToQueue(channel, `${options.queue}.retry.${delayMs}`, message, {
        'x-retry-count': count + 1,
        'x-original-routing-key': safeHeaderString(message.properties.headers?.['x-original-routing-key']) ||
          message.fields.routingKey
      }, confirmTimeoutMs)
      channel.ack(message)
    } catch (publishError) {
      logError(options.logger, publishError instanceof BrokerPublishError ? publishError.code : 'RETRY_PUBLISH_FAILED', {
        eventId: event.eventId,
        eventType: event.eventType
      })
      channel.nack(message, false, true)
    }
  }
}

function validateConsumerOptions(options: ConsumerOptions): void {
  if (!options.url || !options.queue || options.bindings.length === 0) {
    throw new TypeError('Consumer requires a broker URL, queue name, and at least one binding')
  }
  if (options.prefetch !== undefined && (!Number.isInteger(options.prefetch) || options.prefetch < 1)) {
    throw new TypeError('Consumer prefetch must be a positive integer')
  }
  if (options.maxRetries !== undefined && (!Number.isInteger(options.maxRetries) || options.maxRetries < 0)) {
    throw new TypeError('Consumer maxRetries must be a non-negative integer')
  }
  if (options.retryDelaysMs?.some(value => !Number.isInteger(value) || value < 1)) {
    throw new TypeError('Retry delays must be positive integer milliseconds')
  }
  if (options.ignoredEventTypes !== undefined) {
    if (!Array.isArray(options.ignoredEventTypes) ||
        options.ignoredEventTypes.some(eventType =>
          typeof eventType !== 'string' || eventType.trim().length === 0)) {
      throw new TypeError('ignoredEventTypes must contain only non-empty strings')
    }
    if (options.ignoredEventTypes.some(eventType => Object.prototype.hasOwnProperty.call(options.handlers, eventType))) {
      throw new TypeError('An event type cannot have both a handler and be ignored')
    }
  }
  if (options.reconnectDelayMs !== undefined &&
      (!Number.isInteger(options.reconnectDelayMs) || options.reconnectDelayMs < 1)) {
    throw new TypeError('Consumer reconnect delay must be a positive integer')
  }
}

export function createConsumer(options: ConsumerOptions): EventConsumer {
  validateConsumerOptions(options)
  const reconnectDelayMs = options.reconnectDelayMs ?? 2000
  let running = false
  let activeConnection: ChannelModel | undefined
  let activeChannel: ConfirmChannel | undefined
  let consumerTag: string | undefined
  let signalDisconnect: (() => void) | undefined
  let disconnected: Promise<void> | undefined
  let supervisor: Promise<void> | undefined
  let reconnectController: AbortController | undefined
  const inFlight = new Set<Promise<void>>()

  const settleInFlight = async () => {
    while (inFlight.size > 0) await Promise.allSettled([...inFlight])
  }

  async function connectOnce(): Promise<void> {
    const connection = await amqp.connect(options.url)
    connection.on('error', () => undefined)
    let channel: ConfirmChannel | undefined
    try {
      const active = await connection.createConfirmChannel()
      channel = active
      active.on('error', () => undefined)
      await assertConsumerTopology(active, options)
      await active.prefetch(options.prefetch ?? 10)
      activeConnection = connection
      activeChannel = active

      disconnected = new Promise<void>(resolve => { signalDisconnect = resolve })
      const onClose = () => signalDisconnect?.()
      connection.once('close', onClose)
      active.once('close', onClose)
      connection.once('error', onClose)
      active.once('error', onClose)
      const consumeResult = await active.consume(options.queue, message => {
        if (!message || !running) return
        const work = processConsumerMessage(active, message, options).catch(error => {
          logError(options.logger, 'Unexpected consumer failure', {
            eventId: message.properties.messageId,
            eventType: eventTypeHint(message)
          })
          try { active.nack(message, false, true) } catch { /* the broker will requeue on channel loss */ }
        }).finally(() => inFlight.delete(work))
        inFlight.add(work)
      }, { noAck: false })
      consumerTag = consumeResult.consumerTag
    } catch (error) {
      if (activeChannel === channel) activeChannel = undefined
      if (activeConnection === connection) activeConnection = undefined
      consumerTag = undefined
      signalDisconnect = undefined
      disconnected = undefined
      await channel?.close().catch(() => {})
      await connection.close().catch(() => {})
      throw error
    }
  }

  async function closeCurrent(): Promise<void> {
    const channel = activeChannel
    const connection = activeConnection
    if (channel && consumerTag) await channel.cancel(consumerTag).catch(() => {})
    await settleInFlight()
    if (activeChannel === channel) activeChannel = undefined
    if (activeConnection === connection) activeConnection = undefined
    consumerTag = undefined
    signalDisconnect = undefined
    disconnected = undefined
    await channel?.close().catch(() => {})
    await connection?.close().catch(() => {})
  }

  async function reconnectLoop(): Promise<void> {
    let reconnectAttempt = 0
    while (running) {
      if (disconnected) await disconnected
      await closeCurrent()
      if (!running) return
      const waitMs = Math.min(30000, reconnectDelayMs * 2 ** reconnectAttempt)
      await delay(waitMs, undefined, { signal: reconnectController?.signal }).catch(() => {})
      if (!running) return
      try {
        await connectOnce()
        reconnectAttempt = 0
      } catch (error) {
        reconnectAttempt += 1
        logError(options.logger, 'Consumer connection failed; reconnecting', {})
      }
    }
  }

  return {
    async start() {
      if (running) return
      running = true
      reconnectController = new AbortController()
      try {
        await connectOnce()
        supervisor = reconnectLoop()
      } catch (error) {
        running = false
        reconnectController.abort()
        await activeChannel?.close().catch(() => {})
        await activeConnection?.close().catch(() => {})
        activeChannel = undefined
        activeConnection = undefined
        throw error
      }
    },
    async stop() {
      if (!running) return
      running = false
      reconnectController?.abort()
      const channel = activeChannel
      const connection = activeConnection
      if (channel && consumerTag) await channel.cancel(consumerTag).catch(() => {})
      await settleInFlight()
      signalDisconnect?.()
      await supervisor
      await channel?.close().catch(() => {})
      await connection?.close().catch(() => {})
      activeChannel = undefined
      activeConnection = undefined
    }
  }
}
</file>

<file path="packages/finvault-events/src/inbox.ts">
import type { FinvaultEvent } from './schemas'

export type InboxResult<T> =
  | { status: 'processed'; result: T }
  | { status: 'duplicate' }
  | { status: 'conflict' }

export interface InboxAdapter {
  runOnce<T>(
    args: { eventId: string; eventType: string; payloadHash: string },
    fn: (tx: unknown) => Promise<T>
  ): Promise<InboxResult<T>>
}

export function createInMemoryInbox(): InboxAdapter {
  const records = new Map<string, string>()
  let lock: Promise<void> = Promise.resolve()

  return {
    async runOnce<T>(
      args: { eventId: string; eventType: string; payloadHash: string },
      fn: (tx: unknown) => Promise<T>
    ): Promise<InboxResult<T>> {
      let release!: () => void
      const previous = lock
      lock = new Promise<void>(resolve => { release = resolve })
      await previous
      try {
        const previousHash = records.get(args.eventId)
        if (previousHash !== undefined) {
          return previousHash === args.payloadHash ? { status: 'duplicate' } : { status: 'conflict' }
        }
        const result = await fn(undefined)
        records.set(args.eventId, args.payloadHash)
        return { status: 'processed', result }
      } finally {
        release()
      }
    }
  }
}

export type EventHandler<T = unknown, R = unknown> = (
  event: FinvaultEvent<T>,
  context: { tx: unknown }
) => Promise<R>
