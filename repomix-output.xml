<file path="services/payment-service/prisma/schema.prisma">
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentType {
  CARD_TOPUP
  BUS_TICKET
  MOVIE_TICKET
  TRAIN_TICKET
  WALLET_TRANSFER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  CANCELLED
  EXPIRED
}

enum OutboxEventStatus {
  PENDING
  SENT
  FAILED
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model Payment {
  id                   String             @id @default(uuid()) @db.Uuid
  userId               String             @db.VarChar(50)
  amount               Decimal            @db.Decimal(20, 2)
  type                 PaymentType
  referenceId          String             @db.VarChar(255)
  callbackTopic        String             @db.VarChar(100)
  idempotencyKey       String             @db.VarChar(255)
  requestHash          String             @db.VarChar(255)
  idempotencyStatus    IdempotencyStatus  @default(PROCESSING)
  idempotencyExpiresAt DateTime           @db.Timestamp()
  status         PaymentStatus    @default(PENDING)
  failureReason  String?          @db.Text
  holdId         String?          @db.VarChar(255)
  holdExpiresAt  DateTime?        @db.Timestamp()
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  histories      PaymentHistory[]

  @@index([userId, createdAt])
  @@index([status])
  @@unique([userId, idempotencyKey])
  @@index([idempotencyExpiresAt])
}

model PaymentHistory {
  id         String         @id @default(uuid()) @db.Uuid
  paymentId  String         @db.Uuid
  fromStatus PaymentStatus?
  toStatus   PaymentStatus
  note       String?        @db.Text
  changedAt  DateTime       @default(now())
  payment    Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

model OutboxEvent {
  id          String            @id @default(uuid()) @db.Uuid
  aggregateId String            @db.VarChar(255)
  eventType   String            @db.VarChar(100)
  topic       String            @db.VarChar(100)
  payload     Json
  status      OutboxEventStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  sentAt      DateTime?         @db.Timestamp()
  retryCount  Int               @default(0)
  nextRetryAt DateTime?         @db.Timestamp()

  @@index([status, createdAt])
  @@index([nextRetryAt])
}

enum TopupStatus {
  PENDING
  PROCESSING
  APPROVED
  REJECTED
  EXPIRED
  FAILED
}

model TopupRequest {
  id                  String       @id @default(uuid()) @db.Uuid
  userId              String       @db.VarChar(50)
  amount              Decimal      @db.Decimal(20, 2)
  code                String       @unique @db.VarChar(50)
  status              TopupStatus  @default(PENDING)
  expiresAt           DateTime     @db.Timestamp()
  approvedBy          String?      @db.VarChar(50)
  approvedAt          DateTime?    @db.Timestamp()
  rejectReason        String?      @db.Text
  walletTransactionId String?      @db.Uuid
  vnpTransactionNo    String?      @db.VarChar(50)
