// D:\PTPMHDV\Backend\gateway\src\utils\gatewayToken.ts
import crypto from 'crypto'
import fs from 'fs'
import jwt from 'jsonwebtoken'

/* ==========================================================================
   1. ĐỊNH NGHĨA KIỂU DỮ LIỆU (INTERFACE)
   Chỉ giữ ĐÚNG 1 interface mô tả các thông tin được gói trong Token.
   ========================================================================== */
export interface GatewayPayload {
    iss: string       // Đơn vị phát hành: 'finvault-gateway'
    aud: string       // Nơi nhận: 'finvault-internal-services'
    sub: string       // ID người dùng (userId)
    role: string      // Vai trò: 'USER', 'ADMIN', ...
    kycTier: number   // Cấp độ định danh ví: 0, 1, 2
    jti: string       // Mã định danh token ngẫu nhiên (chống phát lại)
    iat?: number      // Thời điểm sinh token (jwt tự thêm)
    exp?: number      // Thời điểm hết hạn (jwt tự thêm)
}

/* ==========================================================================
   2. KHÓA MẬT MÃ CỐ ĐỊNH (DEV STUB CHO NGÀY 1)
   Cặp khóa ES256 (NIST P-256) dùng để test nhanh nội bộ mà không cần cài đặt.
   ========================================================================== */
export const DEV_STUB_PUBLIC_KEY = `-----BEGIN PUBLIC KEY-----
MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEniLUK7gZ7ZSYyWBnm3SiPUedQHwt
aeFpVr9DWDOaA02OcsSGq1K+pmzspers77x41nFYSqe/bQgOL9XONKkRwQ==
-----END PUBLIC KEY-----`

/* ==========================================================================
   3. HÀM HỖ TRỢ ĐỌC KHÓA (HELPER FUNCTIONS)
   Quy tắc: Ưu tiên đọc File Secret -> Biến môi trường -> Dùng khóa Dev Stub
   ========================================================================== */
export const getGatewayPrivateKey = (): string => {
    const keyPath = process.env.GATEWAY_PRIVATE_KEY_FILE
    if (keyPath) {
        return fs.readFileSync(keyPath, 'utf-8').trim()
    }

    if (process.env.GATEWAY_PRIVATE_KEY) {
        return process.env.GATEWAY_PRIVATE_KEY.trim()
    }

    throw new Error('GATEWAY_PRIVATE_KEY is required')
}

export const getGatewayPublicKey = (): string => {
    const keyPath = process.env.GATEWAY_PUBLIC_KEY_FILE
    if (keyPath) {
        return fs.readFileSync(keyPath, 'utf-8').trim()
    }

    if (process.env.GATEWAY_PUBLIC_KEY) {
        return process.env.GATEWAY_PUBLIC_KEY.trim()
    }

    throw new Error('GATEWAY_PUBLIC_KEY is required')
}

/* ==========================================================================
   4. HÀM KÝ TOKEN (CHÍNH)
   Nhận trực tiếp 3 tham số, không cần bọc thêm interface trung gian rườm rà.
   ========================================================================== */
export const signGatewayToken = (userId: string, role: string, kycTier: number = 0): string => {
    if (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(userId) ||
        !['USER', 'ADMIN', 'MERCHANT'].includes(role) || !Number.isInteger(kycTier) || kycTier < 0 || kycTier > 2) {
        throw new Error('Invalid access identity')
    }
    const payload: GatewayPayload = {
        iss: 'finvault-gateway',
        aud: 'finvault-internal-services',
        sub: userId,
        role,
        kycTier,
        jti: crypto.randomUUID(),
    }

    return jwt.sign(payload, getGatewayPrivateKey(), {
        algorithm: 'ES256',
        expiresIn: '60s',
    })
}

// Called before serving traffic, so an invalid/mismatched deployment fails visibly.
export const validateGatewayKeys = (): void => {
    const privateKey = crypto.createPrivateKey(getGatewayPrivateKey())
    const publicKey = crypto.createPublicKey(getGatewayPublicKey())
    if (privateKey.asymmetricKeyType !== 'ec' || privateKey.asymmetricKeyDetails?.namedCurve !== 'prime256v1')
        throw new Error('Gateway signing requires an ES256 key')
    const derived = crypto.createPublicKey(privateKey).export({ type: 'spki', format: 'pem' }).toString().trim()
    if (derived !== publicKey.export({ type: 'spki', format: 'pem' }).toString().trim())
        throw new Error('Gateway public/private keys do not match')
    if (process.env.NODE_ENV === 'production' && derived === DEV_STUB_PUBLIC_KEY)
        throw new Error('Development Gateway key is not permitted in production')
}

/* ==========================================================================
   5. HÀM KIỂM CHỨNG TOKEN (VERIFY)
   Kiểm tra chữ ký số, hạn dùng 60s và trả về payload đã giải mã.
   ========================================================================== */
export const verifyGatewayToken = (token: string): GatewayPayload => {
    return jwt.verify(token, getGatewayPublicKey(), {
        algorithms: ['ES256'],
        issuer: 'finvault-gateway',
        audience: 'finvault-internal-services',
    }) as GatewayPayload
}
</file>

<file path="packages/finvault-events/src/publisher.ts">
import amqp, { type ChannelModel, type ConfirmChannel, type Options } from 'amqplib'
import { setTimeout as delay } from 'node:timers/promises'
import type { EventLogger } from './broker'
import { BrokerPublishError, publishConfirmed } from './broker'
import { parseFinvaultEvent, type FinvaultEvent } from './schemas'

export interface PublisherOptions {
  url: string
  exchange?: string
  confirmTimeoutMs?: number
  logger?: EventLogger
}

export interface EventPublisher {
  publish(event: FinvaultEvent): Promise<void>
  close(): Promise<void>
}

export function createPublisher(options: PublisherOptions): EventPublisher {
  const exchange = options.exchange ?? 'finvault.events'
  const timeoutMs = options.confirmTimeoutMs ?? 10000
  if (!options.url || !Number.isInteger(timeoutMs) || timeoutMs < 1) {
    throw new TypeError('Publisher requires a broker URL and positive confirmation timeout')
  }
  let connection: ChannelModel | undefined
  let channel: ConfirmChannel | undefined
  let connecting: Promise<ConfirmChannel> | undefined
  let closed = false
  const pending = new Set<(error: Error) => void>()

  const discardConnection = (error: Error, sourceConnection: ChannelModel, sourceChannel?: ConfirmChannel) => {
    if (sourceChannel) {
      if (connection !== sourceConnection || channel !== sourceChannel) return
    } else if (connection !== sourceConnection) {
      return
    }
    for (const reject of pending) reject(error)
    pending.clear()
    channel = undefined
    connection = undefined
    connecting = undefined
  }

  async function getChannel(): Promise<ConfirmChannel> {
    if (closed) throw new Error('Publisher is closed')
    if (channel) return channel
    if (connecting) return connecting
    connecting = (async () => {
      let lastError: unknown
      for (const waitMs of [0, 250, 1000]) {
        if (waitMs > 0) await delay(waitMs)
        let nextConnection: ChannelModel | undefined
        let nextChannel: ConfirmChannel | undefined
        try {
          if (closed) throw new Error('Publisher is closed')
          const establishedConnection = await amqp.connect(options.url)
          nextConnection = establishedConnection
          establishedConnection.on('error', () => undefined)
          establishedConnection.once('close', () => discardConnection(
            new BrokerPublishError('Broker connection closed', 'CONNECTION_CLOSED'),
            establishedConnection
          ))
          const establishedChannel = await establishedConnection.createConfirmChannel()
          nextChannel = establishedChannel
          establishedChannel.on('error', () => undefined)
          establishedChannel.once('close', () => discardConnection(
            new BrokerPublishError('Publisher channel closed', 'CHANNEL_CLOSED'),
            establishedConnection,
            establishedChannel
          ))
          await establishedChannel.assertExchange(exchange, 'topic', { durable: true })
          if (closed) throw new Error('Publisher is closed')
          connection = establishedConnection
          channel = establishedChannel
          return establishedChannel
        } catch (error) {
          lastError = error
          if (connection === nextConnection) connection = undefined
          if (channel === nextChannel) channel = undefined
          await nextChannel?.close().catch(() => {})
          await nextConnection?.close().catch(() => {})
        }
      }
      throw lastError
    })().finally(() => {
      connecting = undefined
    })
    return connecting
  }

  return {
    async publish(value) {
      const event = parseFinvaultEvent(value)
      const body = Buffer.from(JSON.stringify(event))
      const activeChannel = await getChannel()
      if (activeChannel !== channel || !connection) {
        throw new BrokerPublishError('Broker connection changed before publish', 'CONNECTION_CLOSED')
      }
      options.logger?.info?.('Publishing FinVault event', { eventId: event.eventId, eventType: event.eventType })
      let rejectPending!: (error: Error) => void
      const disconnected = new Promise<never>((_, reject) => { rejectPending = reject })
      pending.add(rejectPending)
      try {
        await Promise.race([
          publishConfirmed(activeChannel, exchange, event.eventType, body, {
            persistent: true,
            contentType: 'application/json',
            type: event.eventType,
            messageId: event.eventId,
            headers: { 'x-event-version': event.eventVersion }
          } satisfies Options.Publish, timeoutMs),
          disconnected
        ])
      } catch (error) {
        options.logger?.error?.('FinVault event publish failed', { eventId: event.eventId, eventType: event.eventType })
        throw error
      } finally {
        pending.delete(rejectPending)
      }
    },
    async close() {
      closed = true
      const error = new BrokerPublishError('Publisher closed', 'PUBLISHER_CLOSED')
      for (const reject of pending) reject(error)
      pending.clear()
      const activeChannel = channel
      const activeConnection = connection
      channel = undefined
      connection = undefined
      await activeChannel?.close().catch(() => {})
      await activeConnection?.close().catch(() => {})
    }
  }
}
</file>

<file path="packages/finvault-events/README.md">
# finvault-events

Shared FinVault event envelope, schemas, confirmed RabbitMQ publisher, retrying consumer, and inbox contract.

## Install and build

Use a local file dependency from a service, e.g. `"finvault-events": "file:../../packages/finvault-events"`. The Docker build context must be the repository root and include both `packages/finvault-events` and the service directory. The package follows the repository CommonJS/ES2022 `dist` convention.

```sh
npm ci
npm run build
npm test
```

Unit tests use `node:test` through `tsx --test`. RabbitMQ integration tests are separate and only run when `RABBITMQ_URL` is set:

```sh
docker compose -f packages/finvault-events/docker-compose.test.yml up -d --wait
RABBITMQ_URL=amqp://finvault_test:finvault_test@localhost:5673 RABBITMQ_TEST_CONTAINER=finvault-events-rabbitmq-test npm run test:integration
docker compose -f packages/finvault-events/docker-compose.test.yml down
```

On PowerShell, set the two environment variables before running `npm.cmd run test:integration`.

## Publishing

```ts
import { createPublisher, type FinvaultEvent } from 'finvault-events'

const publisher = createPublisher({ url: process.env.RABBITMQ_URL! })
const event: FinvaultEvent<{ authUserId: string; kycTier: number; previousTier: number }> = {
  eventId: crypto.randomUUID(),
  eventType: 'user.kyc_updated',
  eventVersion: 1,
  occurredAt: new Date().toISOString(),
  data: { authUserId: 'auth-user-id', kycTier: 2, previousTier: 1 }
}
await publisher.publish(event)
await publisher.close()
```

Publishing validates envelope and payload, then waits for a publisher confirm. The message is persistent, has `messageId = eventId`, `type = eventType`, `contentType = application/json`, and `x-event-version`; the routing key is exactly `eventType`. Unroutable messages, broker nacks, timeouts, and channel/connection loss reject. A confirm means the broker accepted the message, **not** that a consumer processed it. A durable Outbox should only mark an event sent once `publish()` resolves and should drain after the business transaction commits.

For Prisma-backed outboxes, `createEventFromOutbox` validates and builds the
standard envelope from a persisted row. The row ID becomes `eventId` and
`createdAt` becomes the UTC `occurredAt`; map service-specific columns into
`data` before calling it:

```ts
const event = createEventFromOutbox(
  { id: row.id, createdAt: row.createdAt },
  'payment.succeeded',
  {
    paymentId: row.aggregateId,
    senderId: payload.userId,
    receiverId: payload.destinationUserId,
    amount: String(payload.amount)
  }
)
await publisher.publish(event)
```

Outbox IDs must be UUIDs because `eventId` is a UUID in the envelope contract.
The helper validates the event type, version and mapped payload before returning.

## Consuming, inbox and transactions

```ts
import { createConsumer, createInMemoryInbox } from 'finvault-events'

const consumer = createConsumer({
  url: process.env.RABBITMQ_URL!,
  queue: 'notification.finvault.events',
  bindings: ['user.#', 'payment.#'],
  prefetch: 10,
  maxRetries: 3,
  retryDelaysMs: [1000, 5000, 30000],
  inbox: serviceInboxAdapter,
  handlers: {
    'user.kyc_updated': async (event, { tx }) => {
      // Apply service-specific database changes using tx.
    }
  }
})
await consumer.start()
// On shutdown:
await consumer.stop()
```

The service owns its database-specific `InboxAdapter`; its `runOnce` must insert the inbox key and run the handler in the **same database transaction**. The in-memory adapter is for examples/tests only. A Prisma adapter can follow `ingestNotification` in notification-service and use parameterized SQL:

```ts
const inboxAdapter = {
  runOnce: (args, fn) => prisma.$transaction(async tx => {
    const inserted = await tx.$executeRaw`
      INSERT INTO "EventInbox" ("eventId", "eventType", "payloadHash")
      VALUES (${args.eventId}, ${args.eventType}, ${args.payloadHash})
      ON CONFLICT ("eventId") DO NOTHING
    `
    if (inserted === 0) {
      const rows = await tx.$queryRaw<Array<{ payloadHash: string }>>`
        SELECT "payloadHash" FROM "EventInbox" WHERE "eventId" = ${args.eventId}
      `
      if (!rows[0]) throw new Error('Inbox row missing after conflict')
      return rows[0].payloadHash === args.payloadHash
        ? { status: 'duplicate' as const }
        : { status: 'conflict' as const }
    }
    return { status: 'processed' as const, result: await fn(tx) }
  })
}
```

The service must provision the inbox table and unique `eventId` constraint; N11 requires no migration. Payload hashes are SHA-256 of canonical JSON for `{eventType, eventVersion, data}` (sorted object keys, excluding `occurredAt`). Duplicate IDs are acked without another handler call. A changed payload under an existing ID is dead-lettered as `EVENT_CONFLICT`.

## Event catalog and versioning

The envelope is strict; payload schemas validate their known fields and preserve additive fields so newer producers can add a field without breaking older consumers. Additive fields keep the version; changing/removing fields requires a new version. Consumers should support old and new versions during the one-week migration window. Unknown types/versions are dead-lettered immediately.

| Event type | Version 1 data |
| --- | --- |
| `user.registered` | `{ authUserId, email, phone? }` |
| `user.kyc_updated` | `{ authUserId, kycTier, previousTier }` |
| `merchant.status_updated` | `{ merchantId, status }` |
| `payment.succeeded` | `{ paymentId, senderId, receiverId, amount }` |
| `payment.failed` | `{ paymentId, senderId, reason }` |
| `payment.expired` | `{ paymentId, senderId }` |
| `wallet.limit_exceeded` | `{ userId, limitType, kycTier }` |

`amount` is a non-negative decimal integer string (never a JS `number`); `addAmounts` and `compareAmounts` use `BigInt`.

KYC v1 requires `previousTier`. Old outbox records without that value are accepted only when `allowLegacyKycUpdated: true`; handlers receive `{ authUserId, kycTier, previousTier: undefined, legacy: true }`. No value is guessed. Existing records do not currently distinguish old from new payloads by event version, so the producer must establish an explicit versioning strategy. **Hữu must update H7 to publish `{authUserId, kycTier, previousTier}`.** Do not silently treat a legacy record as a complete v1 payload.

## Topology and retry/DLQ

Every publisher and consumer idempotently asserts the shared `finvault.events` topic exchange as durable, using exactly those parameters. Each consumer owns and asserts its own durable main queue, one retry queue per distinct delay (`<queue>.retry.<delayMs>`), and `<queue>.dlq`; it binds the main queue to its configured patterns. Each retry queue has a queue-level TTL and dead-letters to the main queue, so a long-delay retry cannot block a shorter retry. `broker-init` remains merchant-service-owned and is not the owner of other services' queues. In development environments previously run with N11, the obsolete `<queue>.retry` queue can be manually deleted if it is empty; the library does not assert or reuse it.

Handler failures are republished to the retry queue corresponding to the selected backoff delay with `x-retry-count`; TTL is configured on the queue, not each message. The configured delay list bounds retry attempts. The original delivery is acked only after a retry or DLQ publish is confirmed. Exhausted/permanent failures go to `<queue>.dlq` with `x-dlq-reason`, `x-original-routing-key`, `x-retry-count`, and `x-failed-at`; stack traces and payload data are not copied to headers. `NonRetryableError` skips retries. The consumer reconnects after broker connection loss and `stop()` cancels consumption and waits for work to settle.

Consumers that bind broad routing patterns may list valid event types they intentionally do not handle, for example notification can use `ignoredEventTypes: ['user.registered']`. Such events are logged at info using only their ID and type, then acked without calling a handler or inbox. An event type not registered in this package is still dead-lettered as `UNKNOWN_EVENT_TYPE`, even if listed as ignored; parse/registry validation happens first. An unregistered or unsupported event type/version must be added to the registry before a consumer can intentionally ignore it.

## Handoff

- **Hữu (H7):** publish the complete KYC v1 data above with `user.kyc_updated` as routing key, through `createPublisher` or equivalent confirmed publishing. Legacy Outbox rows lack `previousTier`; use the explicit legacy mode, and do not guess. No `broker-init` change is needed.
- **Đạt (Đ12):** use `createConsumer` and a Wallet Prisma inbox adapter; the Wallet consumer owns `wallet.finvault.events`. Auth currently builds from `services/auth-service`, so its Docker build context must move to the repository root before importing this package; Đạt owns that change.
- **Khoa:** publish a complete envelope and mark Outbox entries sent only after `publish()` resolves; drain after commit. Wallet's existing `{userId,type,message}` Outbox is not this envelope and needs a migration path before routing to `finvault.events`. Keep the legacy delivery active until N8 handles duplicate-notification risk.
- **Nguyên (next day):** N8 should adopt this consumer for notification mapping and multi-recipient transactional inbox handling.

## Example and current limits

Run `npx tsx examples/demo.ts`. With `RABBITMQ_URL` it uses a real broker; without it the output explicitly identifies a fake-channel demonstration. The package provides reusable envelope construction and single-flight drain helpers, but services still own their database-specific transactional Outbox and Inbox implementations. Publisher confirms do not guarantee consumer processing, and in-memory inbox storage is never suitable for production.
</file>

<file path="packages/finvault-internal-auth/src/index.ts">
import fs from 'node:fs'
import { createPublicKey } from 'node:crypto'
import jwt, { SignOptions } from 'jsonwebtoken'
import type { Request, Response, NextFunction } from 'express'
export { loadSecretEnvironment } from './secrets'

export interface GatewayAuthContext {
  userId: string
  role: string
  kycTier: number
  jti: string
}
declare global {
  namespace Express { interface Request { auth?: GatewayAuthContext } }
}

// Public development fixture. Production must supply its own verification key.
export const DEV_STUB_PUBLIC_KEY = `-----BEGIN PUBLIC KEY-----
MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEniLUK7gZ7ZSYyWBnm3SiPUedQHwt
aeFpVr9DWDOaA02OcsSGq1K+pmzspers77x41nFYSqe/bQgOL9XONKkRwQ==
-----END PUBLIC KEY-----`

export function getGatewayPublicKey(): string {
  const path = process.env.GATEWAY_PUBLIC_KEY_FILE
  const configured = path ? fs.readFileSync(path, 'utf8').trim() : process.env.GATEWAY_PUBLIC_KEY?.trim()
  if (!configured && process.env.NODE_ENV === 'production') throw new Error('GATEWAY_PUBLIC_KEY is required in production')
  const pem = configured || DEV_STUB_PUBLIC_KEY
  const key = createPublicKey(pem)
  if (key.asymmetricKeyType !== 'ec' || key.asymmetricKeyDetails?.namedCurve !== 'prime256v1')
    throw new Error('Gateway verification requires an ES256 public key')
  if (process.env.NODE_ENV === 'production' && key.export({ type: 'spki', format: 'pem' }).toString().trim() === DEV_STUB_PUBLIC_KEY)
    throw new Error('Development Gateway key is not permitted in production')
  return pem
}

export function verifyGatewayToken(token: string): GatewayAuthContext {
  const claims = jwt.verify(token, getGatewayPublicKey(), {
    algorithms: ['ES256'], issuer: 'finvault-gateway', audience: 'finvault-internal-services', maxAge: '60s'
  })
  const now = Math.floor(Date.now() / 1000)
  if (typeof claims === 'string' || typeof claims.sub !== 'string' ||
      !/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(claims.sub) ||
      !['USER', 'ADMIN', 'MERCHANT'].includes(claims.role) ||
      !Number.isInteger(claims.kycTier) || claims.kycTier < 0 || claims.kycTier > 2 ||
      typeof claims.jti !== 'string' || !claims.jti.trim() || claims.jti.length > 200 ||
      !Number.isInteger(claims.iat) || !Number.isInteger(claims.exp) ||
      claims.iat! > now || claims.exp! <= claims.iat! || claims.exp! - claims.iat! > 60)
    throw new Error('Invalid Gateway claims')
  return { userId: claims.sub, role: claims.role, kycTier: claims.kycTier, jti: claims.jti }
}

function fail(req: Request, res: Response, status: number, code: string, message: string) {
  return res.status(status).json({ success: false, error: { code, message },
    requestId: (req as Request & { requestId?: string }).requestId || res.getHeader('x-request-id') })
}
export function requireGateway(req: Request, res: Response, next: NextFunction): void | Response {
  req.auth = undefined
  const token = req.headers['x-gateway-token']
  if (!token || typeof token !== 'string') return fail(req, res, 401, 'INVALID_GATEWAY_TOKEN', 'Gateway token required')
  try { req.auth = verifyGatewayToken(token) }
  catch { return fail(req, res, 401, 'INVALID_GATEWAY_TOKEN', 'Invalid or expired Gateway token') }
  return next()
}
export function requireRole(role: string) {
  return (req: Request, res: Response, next: NextFunction): void | Response => {
    if (!req.auth) return fail(req, res, 401, 'UNAUTHORIZED', 'Authentication required')
    if (req.auth.role !== role) return fail(req, res, 403, 'FORBIDDEN', 'Insufficient role')
    return next()
  }
}
// Preserve the documented helper API; never sign test tokens in production.
export function createTestGatewayToken(userId: string, role = 'USER', kycTier = 0,
  expiresIn: SignOptions['expiresIn'] = '60s'): string {
  if (process.env.NODE_ENV === 'production') throw new Error('Test tokens are disabled in production')
  return require('./testing').createTestGatewayToken(userId, role, kycTier, expiresIn)
}
