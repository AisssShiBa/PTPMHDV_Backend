<file path="tests/deployment/init-secrets.test.cjs">
const { test } = require('node:test')
const assert = require('node:assert/strict')
const fs = require('node:fs')
const path = require('node:path')
const os = require('node:os')
const crypto = require('node:crypto')
const { parseEnv } = require('node:util')
const { initialize } = require('../../scripts/init-secrets')

function fixture(t) {
  const parent = path.resolve(os.tmpdir())
  const root = fs.mkdtempSync(path.join(parent, 'finvault-init-'))
  t.after(() => {
    assert.equal(path.dirname(root), parent)
    assert.ok(path.basename(root).startsWith('finvault-init-'))
    fs.rmSync(root, { recursive: true, force: true })
  })
  fs.copyFileSync(path.resolve(__dirname, '../../.env.example'), path.join(root, '.env.example'))
  fs.copyFileSync(path.resolve(__dirname, '../../init-db.sql'), path.join(root, 'init-db.sql'))
  return root
}
test('fresh environment has matching production keys and consistent credentials; reruns preserve them', t => {
  const root = fixture(t)
  initialize(root)
  const envPath = path.join(root, '.env')
  const first = fs.readFileSync(envPath, 'utf8')
  const config = parseEnv(first)
  const key = fs.readFileSync(path.join(root, 'secrets/gateway_private.pem'))
  const publicKey = fs.readFileSync(path.join(root, 'secrets/gateway_public.pem'), 'utf8')
  assert.equal(crypto.createPublicKey(key).export({ type: 'spki', format: 'pem' }), publicKey)
  assert.equal(crypto.createPrivateKey(key).asymmetricKeyDetails.namedCurve, 'prime256v1')
  const txnKey = fs.readFileSync(path.join(root, 'secrets/auth_txn_private.pem'))
  const txnPublic = fs.readFileSync(path.join(root, 'secrets/auth_txn_public.pem'), 'utf8')
  assert.equal(crypto.createPublicKey(txnKey).export({ type: 'spki', format: 'pem' }), txnPublic)
  assert.notEqual(txnPublic, publicKey, 'Auth-Txn must not reuse Gateway signing keys')
  for (const [name, file] of [['POSTGRES_PASSWORD', 'postgres_password.txt'], ['RABBITMQ_PASS', 'rabbitmq_pass.txt'],
    ['ACCESS_TOKEN_SECRET', 'access_token_secret.txt'], ['INTERNAL_KEY', 'internal_key.txt']]) {
    assert.equal(config[name], fs.readFileSync(path.join(root, 'secrets', file), 'utf8').trim())
    assert.equal(config[name].length, 64)
  }
  assert.equal(config.S3_SECRET_ACCESS_KEY.length, 64)
  const sql = fs.readFileSync(path.join(root, 'secrets/init-db.sql'), 'utf8')
  assert.ok(sql.includes(config.POSTGRES_PASSWORD))
  assert.equal(sql.includes('{{DB_ROLE_PASSWORD}}'), false)
  initialize(root)
  assert.equal(fs.readFileSync(envPath, 'utf8'), first)
  assert.deepEqual(fs.readFileSync(path.join(root, 'secrets/gateway_private.pem')), key)
  assert.deepEqual(fs.readFileSync(path.join(root, 'secrets/auth_txn_private.pem')), txnKey)
})
test('existing credentials are kept and database URLs encode special characters', t => {
  const root = fixture(t)
  fs.writeFileSync(path.join(root, '.env'), "POSTGRES_PASSWORD='existing:p@ss/word'\nRABBITMQ_PASS=existing-broker\n")
  initialize(root)
  const config = parseEnv(fs.readFileSync(path.join(root, '.env'), 'utf8'))
  assert.equal(config.POSTGRES_PASSWORD, 'existing:p@ss/word')
  assert.equal(config.POSTGRES_PASSWORD_URLENCODED, encodeURIComponent(config.POSTGRES_PASSWORD))
  assert.equal(config.RABBITMQ_PASS, 'existing-broker')
})
test('conflicting credentials and mismatched keys are rejected without replacing existing values', t => {
  const root = fixture(t)
  initialize(root)
  const secretPath = path.join(root, 'secrets/postgres_password.txt')
  const original = fs.readFileSync(secretPath)
  fs.writeFileSync(secretPath, 'different-password')
  assert.throws(() => initialize(root), /differs between/)
  assert.equal(fs.readFileSync(secretPath, 'utf8'), 'different-password')
  fs.writeFileSync(secretPath, original)
  const publicPath = path.join(root, 'secrets/gateway_public.pem')
  const other = crypto.generateKeyPairSync('ec', { namedCurve: 'prime256v1' }).publicKey.export({ type: 'spki', format: 'pem' })
  fs.writeFileSync(publicPath, other)
  assert.throws(() => initialize(root), /do not match/)
  assert.equal(fs.readFileSync(publicPath, 'utf8'), other)
})
</file>

<file path="tests/deployment/secret-policy.test.cjs">
const { test } = require('node:test')
const assert = require('node:assert/strict')
const { readFileSync, mkdtempSync, writeFileSync, readdirSync, unlinkSync, rmdirSync } = require('node:fs')
const { resolve, join, dirname, basename } = require('node:path')
const { tmpdir } = require('node:os')
const { randomBytes } = require('node:crypto')
const { spawnSync } = require('node:child_process')
const root = resolve(__dirname, '../..')

test('runtime sources and main Compose have no legacy default credentials', () => {
  const files = []
  function walk(directory) {
    for (const entry of readdirSync(directory, { withFileTypes: true })) {
      const path = join(directory, entry.name)
      if (entry.isDirectory()) walk(path)
      else if (/\.(ts|js|mjs|cjs)$/.test(path)) files.push(path)
    }
  }
  walk(join(root, 'gateway/src'))
  for (const service of readdirSync(join(root, 'services'))) walk(join(root, 'services', service, 'src'))
  for (const file of files) assert.equal(
    /default_internal_secret_key_123456|postgres:\/\/postgres:postgres|-----BEGIN (?:EC |RSA )?PRIVATE KEY-----|process\.env\.(?:INTERNAL_KEY|ACCESS_TOKEN_SECRET)\s*(?:\|\||\?\?)\s*['"][^'"]+['"]/.test(readFileSync(file, 'utf8')), false, file)
  assert.doesNotMatch(readFileSync(join(root, 'docker-compose.yml'), 'utf8'), /POSTGRES_PASSWORD:-|POSTGRES_PASSWORD_URLENCODED:-/)
})

test('Payment WalletClient sends the file secret and fails before fetching without a key', t => {
  const cwd = join(root, 'services/payment-service')
  const directory = mkdtempSync(join(tmpdir(), 'finvault-payment-secret-'))
  const file = join(directory, 'key')
  t.after(() => {
    assert.equal(dirname(directory), resolve(tmpdir()))
    assert.ok(basename(directory).startsWith('finvault-payment-secret-'))
    unlinkSync(file)
    rmdirSync(directory)
  })
  const secret = randomBytes(32).toString('hex')
  writeFileSync(file, secret, { mode: 0o600 })
  const env = { ...process.env, DOTENV_CONFIG_PATH: join(directory, 'absent.env'), INTERNAL_KEY_FILE: file, INTERNAL_KEY: 'ignored-direct-value' }
  const script = "const assert=require('node:assert/strict');const fs=require('node:fs');const {WalletClient}=require('./src/clients/wallet.client');let calls=0;global.fetch=async(u,o)=>{calls++;assert.equal(o.headers['x-internal-key'],fs.readFileSync(process.env.INTERNAL_KEY_FILE,'utf8'));return {ok:true,json:async()=>({data:{}})}};new WalletClient().createHold('fixture','1','ref','date').then(()=>assert.equal(calls,1)).catch(()=>process.exit(1))"
  const run = extra => spawnSync(process.execPath, ['--import', 'tsx', '-e', script], { cwd, env: extra, encoding: 'utf8', windowsHide: true })
  assert.equal(run(env).status, 0, 'WalletClient must use the configured secret file')
  delete env.INTERNAL_KEY_FILE
  delete env.INTERNAL_KEY
  const missing = run(env)
  assert.notEqual(missing.status, 0)
  assert.match(missing.stderr, /Missing required environment variable: INTERNAL_KEY/)
  env.INTERNAL_KEY_FILE = join(directory, 'absent-key')
  env.INTERNAL_KEY = secret
  const unreadable = run(env)
  assert.notEqual(unreadable.status, 0)
  assert.match(unreadable.stderr, /Cannot read required secret/)
})
</file>

