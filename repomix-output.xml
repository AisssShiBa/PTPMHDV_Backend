<file path="services/wallet-service/prisma/schema.prisma">
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OwnerType {
  USER
  MERCHANT
  SYSTEM
}

enum WalletStatus {
  ACTIVE
  LOCKED
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum TransferType {
  TOPUP
  PAYMENT
  REFUND
  P2P_TRANSFER
  ADJUSTMENT
}

enum HoldStatus {
  PENDING
  CAPTURED
  RELEASED
  EXPIRED
}

model Wallet {
  id            Int           @id @default(autoincrement())
  userId        String?       @unique @db.VarChar(50)
  ownerType     OwnerType
  balance       Decimal       @default(0) @db.Decimal(20, 2)
  heldBalance   Decimal       @default(0) @db.Decimal(20, 2)
  currency      String        @default("VND") @db.VarChar(3)
  status        WalletStatus  @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  ledgerEntries      LedgerEntry[]
  holdsAsSource      WalletHold[] @relation("HoldSource")
  holdsAsDestination WalletHold[] @relation("HoldDestination")

  @@index([ownerType, status])
}

model WalletOutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  topic       String    @db.VarChar(100)
  payload     Json
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
  attempts    Int       @default(0)

  @@index([publishedAt, createdAt])
}

model LedgerEntry {
  id            BigInt          @id @default(autoincrement())
  transactionId String          @db.Uuid
  walletId      Int
  direction     LedgerDirection
  amount        Decimal         @db.Decimal(20, 2)
  balanceAfter  Decimal         @db.Decimal(20, 2)
  referenceId   String          @db.VarChar(255)
  transferType  TransferType
  note          String?         @db.VarChar(500)
  createdAt     DateTime        @default(now())
  wallet        Wallet          @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@unique([walletId, referenceId])
  @@index([transactionId])
  @@index([walletId, createdAt])
}

model WalletHold {
  id            String     @id @default(uuid()) @db.Uuid
  sourceWalletId      Int
  destinationWalletId Int?
  amount              Decimal    @db.Decimal(20, 2)
  referenceId         String     @db.VarChar(255)
  status              HoldStatus @default(PENDING)
  transactionId       String?    @db.Uuid
  expiresAt           DateTime
  createdAt           DateTime   @default(now())
  sourceWallet        Wallet     @relation("HoldSource", fields: [sourceWalletId], references: [id], onDelete: Restrict)
  destinationWallet   Wallet?    @relation("HoldDestination", fields: [destinationWalletId], references: [id], onDelete: SetNull)

  @@unique([sourceWalletId, referenceId])
  @@index([status, expiresAt])
  @@index([destinationWalletId])
}

enum AnomalyType {
  NEGATIVE_BALANCE
  BALANCE_DRIFT_QUICK
  BALANCE_DRIFT_FULL
  TRANSACTION_UNBALANCED
}

model ReconciliationReport {
  id                    Int      @id @default(autoincrement())
  runAt                 DateTime @default(now())
  totalWallets          Int
  anomaliesFound        Int
  systemBalanceExpected Decimal  @db.Decimal(20, 2)
  systemBalanceActual   Decimal  @db.Decimal(20, 2)
  isBalanced            Boolean

  anomalies ReconciliationAnomaly[]

  @@index([runAt])
}

model ReconciliationAnomaly {
  id            BigInt      @id @default(autoincrement())
  reportId      Int
  type          AnomalyType
  walletId      Int?
  transactionId String?     @db.Uuid
  detail        Json

  report ReconciliationReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([type])
  @@index([walletId])
}
</file>

