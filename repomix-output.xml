<file path="docker-compose.yml">
x-http-health: &http-health
  test: ["CMD", "node", "-e", "fetch('http://127.0.0.1:'+process.env.PORT+'/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
  interval: 10s
  timeout: 5s
  start_period: 60s
  retries: 12

services:
  postgres:
    image: postgres:16-alpine
    restart: unless-stopped
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-postgres}
      POSTGRES_PASSWORD_FILE: /run/secrets/postgres_password
    secrets:
      - postgres_password
    expose:
      - "5432"
    ports:
      - "127.0.0.1:${POSTGRES_HOST_PORT:-5432}:5432"
    networks:
      - internal_net
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./secrets/init-db.sql:/docker-entrypoint-initdb.d/init-db.sql:ro
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -h 127.0.0.1 -U $$POSTGRES_USER -d postgres"]
      interval: 5s
      timeout: 5s
      retries: 30

  rabbitmq:
    image: rabbitmq:3-management
    restart: unless-stopped
    expose:
      - "5672"
      - "15672"
    networks:
      - internal_net
    environment:
      - RABBITMQ_DEFAULT_USER=${RABBITMQ_USER}
      - RABBITMQ_DEFAULT_PASS=${RABBITMQ_PASS}
    secrets:
      - rabbitmq_pass
    volumes:
      - rabbitmq_data:/var/lib/rabbitmq
    healthcheck:
      test: ["CMD-SHELL", "rabbitmq-diagnostics -q check_running && rabbitmq-diagnostics -q check_port_connectivity"]
      interval: 10s
      timeout: 5s
      retries: 10

  user-migrate:
    build: &user-build
      context: .
      dockerfile: services/user-service/Dockerfile
    image: finvault-user-service:local
    environment: &user-env
      NODE_ENV: production
      PORT: 3002
      DATABASE_URL: postgresql://${POSTGRES_USER:-postgres}:${POSTGRES_PASSWORD_URLENCODED:?run node scripts/init-secrets.js}@postgres:5432/user_service
      INTERNAL_KEY_FILE: /run/secrets/internal_key
      GATEWAY_PUBLIC_KEY_FILE: /run/secrets/gateway_public_key
      RABBITMQ_URL: ${RABBITMQ_URL:?run node scripts/init-secrets.js}
      EVENT_EXCHANGE: finvault.events
      S3_ENDPOINT: http://minio:9000
      S3_PUBLIC_ENDPOINT: ${S3_PUBLIC_ENDPOINT:-http://localhost:19002}
      S3_REGION: us-east-1
      S3_BUCKET: ${S3_BUCKET:-finvault-kyc}
      S3_ACCESS_KEY_ID: ${S3_ACCESS_KEY_ID:?run node scripts/init-secrets.js}
      S3_SECRET_ACCESS_KEY: ${S3_SECRET_ACCESS_KEY:?run node scripts/init-secrets.js}
      S3_FORCE_PATH_STYLE: 'true'
      KYC_URL_TTL_SECONDS: ${KYC_URL_TTL_SECONDS:-300}
      KYC_CLEANUP_GRACE_MS: ${KYC_CLEANUP_GRACE_MS:-86400000}
      STORAGE_CLEANUP_ENABLED: ${STORAGE_CLEANUP_ENABLED:-true}
    command: ["npx", "prisma", "migrate", "deploy"]
    networks: [internal_net]
    depends_on:
      postgres:
        condition: service_healthy

  user-service:
    build: *user-build
    image: finvault-user-service:local
    restart: unless-stopped
    init: true
    healthcheck: *http-health
    expose:
      - "3002"
    networks:
      - internal_net
    environment: *user-env
    secrets: [gateway_public_key, internal_key]
    depends_on:
      user-migrate:
        condition: service_completed_successfully
      storage-init:
        condition: service_completed_successfully

  user-publisher:
    image: finvault-user-service:local
    restart: unless-stopped
    init: true
    stop_grace_period: 30s
    environment: *user-env
    networks: [internal_net]
    secrets: [gateway_public_key, internal_key]
    command: ["node", "dist/events/publisher-worker.js"]
    depends_on:
      user-migrate:
        condition: service_completed_successfully
      rabbitmq:
        condition: service_healthy

  user-consumer:
    image: finvault-user-service:local
    restart: unless-stopped
    init: true
    stop_grace_period: 30s
    environment: *user-env
    networks: [internal_net]
    secrets: [gateway_public_key, internal_key]
    command: ["node", "dist/events/worker.js"]
    depends_on:
      user-migrate:
        condition: service_completed_successfully
      rabbitmq:
        condition: service_healthy

  merchant-migrate:
    build: &merchant-build
