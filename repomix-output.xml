<file path="services/wallet-service/tests/concurrency.ts">
import { PrismaClient, OwnerType, TransferType, HoldStatus } from '@prisma/client';
import { LedgerService } from '../src/services/ledger.service';
import { WalletHoldService } from '../src/services/wallet-hold.service';
import { randomUUID } from 'crypto';

const prisma = new PrismaClient();
const ledgerService = new LedgerService();
const holdService = new WalletHoldService(ledgerService);

async function runConcurrencyTest(): Promise<boolean> {
  console.log('--- TEST 1: RACE CONDITION (20 REQUEST CHUYỂN TIỀN SONG SONG) ---');
  
  // 1. Setup dữ liệu
  const userIdA = 'test_user_a_' + Date.now();
  const userIdB = 'test_user_b_' + Date.now();
  
  // Tạo ví System nếu chưa có
  let systemWallet = await prisma.wallet.findFirst({ where: { ownerType: OwnerType.SYSTEM } });
  if (!systemWallet) {
    systemWallet = await prisma.wallet.create({
      data: { balance: 1000000000, currency: 'VND', ownerType: OwnerType.SYSTEM }
    });
  }

  // Tạo ví User A (100.000đ)
  const walletA = await prisma.wallet.create({
    data: { userId: userIdA, balance: 100000, currency: 'VND', ownerType: OwnerType.USER, kycTier: 1 }
  });

  // Tạo ví User B (0đ)
  const walletB = await prisma.wallet.create({
    data: { userId: userIdB, balance: 0, currency: 'VND', ownerType: OwnerType.USER, kycTier: 1 }
  });

  console.log(`Đã tạo ví A: ${walletA.balance}đ | Ví B: ${walletB.balance}đ`);
  console.log('Đang bắn 20 request đồng thời (mỗi request chuyển 60.000đ từ A sang B)...');

  // 2. Bắn 20 request song song
  const promises = [];
  for (let i = 0; i < 20; i++) {
    const p = ledgerService.transfer({
      fromUserId: userIdA,
      toUserId: userIdB,
      amount: '60000',
      referenceId: randomUUID(),
      transferType: TransferType.P2P_TRANSFER
    }).then(() => 'SUCCESS').catch((err) => `FAILED: ${err.message}`);
    promises.push(p);
  }

  const results = await Promise.all(promises);
  
  const successes = results.filter(r => r === 'SUCCESS').length;
  const failures = results.filter(r => r !== 'SUCCESS').length;

  console.log(`Kết quả: ${successes} THÀNH CÔNG, ${failures} THẤT BẠI.`);
  
  const finalWalletA = await prisma.wallet.findUnique({ where: { id: walletA.id } });
  console.log(`Số dư cuối cùng ví A: ${finalWalletA?.balance}đ`);

  if (successes === 1 && Number(finalWalletA?.balance) === 40000) {
    console.log('✅ PASS TEST 1: Database đã Block thành công Race Condition!');
    return true;
  } else {
    console.log('❌ FAIL TEST 1: Hệ thống bị lọt lỗi Race Condition!');
    return false;
  }
}

async function runDeadlockTest(): Promise<boolean> {
  console.log('\n--- TEST 2: DEADLOCK (CHUYỂN TIỀN CHÉO CÙNG MỘT LÚC) ---');
  
  const userIdC = 'test_user_c_' + Date.now();
  const userIdD = 'test_user_d_' + Date.now();

  const walletC = await prisma.wallet.create({
    data: { userId: userIdC, balance: 500000, currency: 'VND', ownerType: OwnerType.USER, kycTier: 1 }
  });
  const walletD = await prisma.wallet.create({
    data: { userId: userIdD, balance: 500000, currency: 'VND', ownerType: OwnerType.USER, kycTier: 1 }
  });

  console.log(`Ví C: 500k | Ví D: 500k`);
  console.log('Mô phỏng: C chuyển cho D và D chuyển cho C CÙNG MỘT LÚC...');

  const promise1 = ledgerService.transfer({
    fromUserId: userIdC,
    toUserId: userIdD,
    amount: '100000',
    referenceId: randomUUID(),
    transferType: TransferType.P2P_TRANSFER
  }).then(() => 'C->D OK').catch(e => `C->D LỖI: ${e.message}`);

  const promise2 = ledgerService.transfer({
    fromUserId: userIdD,
    toUserId: userIdC,
    amount: '200000',
    referenceId: randomUUID(),
    transferType: TransferType.P2P_TRANSFER
  }).then(() => 'D->C OK').catch(e => `D->C LỖI: ${e.message}`);

  const [res1, res2] = await Promise.all([promise1, promise2]);
  console.log(`Kết quả chéo: [1] ${res1} | [2] ${res2}`);

  if (res1 === 'C->D OK' && res2 === 'D->C OK') {
    console.log('✅ PASS TEST 2: Không bị Deadlock. Cơ chế sắp xếp ID khóa (lockAndFetchWalletsTx) hoạt động hoàn hảo!');
    return true;
  } else {
    console.log('❌ FAIL TEST 2: Bị văng lỗi Deadlock (hoặc lỗi khác)!');
    return false;
  }
}

async function runParallelHoldTest(): Promise<boolean> {
  console.log('\n--- TEST 3: 2 REQUEST HOLD SONG SONG TRÊN CÙNG MỘT VÍ ---');
  
  const userIdE = 'test_user_hold_' + Date.now();

  // Tạo ví User E với số dư 100.000đ, heldBalance ban đầu = 0đ
  const walletE = await prisma.wallet.create({
    data: {
      userId: userIdE,
      balance: 100000,
      heldBalance: 0,
      currency: 'VND',
      ownerType: OwnerType.USER,
      kycTier: 1
    }
  });

  console.log(`Đã tạo ví E: Số dư = ${walletE.balance}đ, Số dư tạm giữ (heldBalance) = ${walletE.heldBalance}đ`);
  console.log('Bắn đồng thời 2 request hold (mỗi request giữ 60.000đ)...');

  const expiresAt = new Date(Date.now() + 10 * 60 * 1000).toISOString();
  const ref1 = randomUUID();
  const ref2 = randomUUID();

  interface HoldResult {
    success: boolean;
    req: string;
    error?: string;
  }

  const promise1 = holdService.createHold(userIdE, '60000', ref1, expiresAt)
    .then((): HoldResult => ({ success: true, req: 'HOLD_1' }))
    .catch((err): HoldResult => ({ success: false, req: 'HOLD_1', error: err.message }));

  const promise2 = holdService.createHold(userIdE, '60000', ref2, expiresAt)
    .then((): HoldResult => ({ success: true, req: 'HOLD_2' }))
    .catch((err): HoldResult => ({ success: false, req: 'HOLD_2', error: err.message }));

  const [res1, res2] = await Promise.all([promise1, promise2]);

  const successes = [res1, res2].filter(r => r.success).length;
  const failures = [res1, res2].filter(r => !r.success).length;

  console.log(`Kết quả hold: ${successes} THÀNH CÔNG, ${failures} THẤT BẠI.`);
  console.log(`Chi tiết: Req 1: ${res1.success ? 'OK' : res1.error} | Req 2: ${res2.success ? 'OK' : res2.error}`);

  const finalWalletE = await prisma.wallet.findUnique({ where: { id: walletE.id } });
  const finalBalance = Number(finalWalletE?.balance);
  const finalHeldBalance = Number(finalWalletE?.heldBalance);
  const availableBalance = finalBalance - finalHeldBalance;

  console.log(`Số dư ví E sau hold: balance = ${finalBalance}đ, heldBalance = ${finalHeldBalance}đ, khả dụng = ${availableBalance}đ`);

  const createdHolds = await prisma.walletHold.findMany({
    where: { sourceWalletId: walletE.id, status: HoldStatus.PENDING }
  });
  console.log(`Số bản ghi WalletHold ở trạng thái PENDING: ${createdHolds.length}`);

  // Kỳ vọng: Đúng 1 request thành công, 1 request thất bại do không đủ số dư khả dụng (40.000 < 60.000),
  // heldBalance tăng đúng 60.000đ và chỉ có đúng 1 bản ghi WalletHold PENDING được tạo.
  const isValidResult = successes === 1 &&
    failures === 1 &&
    finalHeldBalance === 60000 &&
    finalBalance === 100000 &&
    availableBalance === 40000 &&
    createdHolds.length === 1;

  if (isValidResult) {
    console.log('✅ PASS TEST 3: Database đã chặn thành công Race Condition khi hold song song trên cùng ví!');
    return true;
  } else {
    console.log('❌ FAIL TEST 3: Hold song song bị lỗi race condition hoặc số dư không chính xác!');
    return false;
  }
}

async function runAll() {
  let allPassed = false;
  try {
    const pass1 = await runConcurrencyTest();
    const pass2 = await runDeadlockTest();
    const pass3 = await runParallelHoldTest();
    allPassed = pass1 && pass2 && pass3;
  } catch (err) {
    console.error('Lỗi ngoại lệ khi chạy test concurrency:', err);
    allPassed = false;
  } finally {
    await prisma.$disconnect();
  }

  if (allPassed) {
    console.log('\n=============================================');
    console.log('🎉 TẤT CẢ TEST ĐỒNG THỜI (CONCURRENCY) ĐÃ PASS!');
    console.log('=============================================\n');
    process.exit(0);
  } else {
    console.error('\n=============================================');
    console.error('❌ MỘT HOẶC NHIỀU TEST CONCURRENCY BỊ THẤT BẠI!');
    console.error('=============================================\n');
    process.exit(1);
  }
}

runAll();
</file>

<file path="services/wallet-service/README.md">
# Wallet service

Express service for wallet balances, holds and a double-entry ledger. It owns no
`User` table and has no database foreign key to another service.

## Run with Docker

From the repository root, build the service image:

```powershell
docker build -f services/wallet-service/Dockerfile -t wallet-service .
```

The image applies Prisma migrations on startup and exposes port `3004`. Set
`DATABASE_URL` and `INTERNAL_KEY` for the deployment; `PORT` can override the
server port. Wallet routes are mounted at `/api/wallets`; admin routes are
mounted at `/api/wallets/admin`. The current wallet creation path does not call
the user-service to verify that the supplied user is active.

## API

The Express app mounts wallet routes at `/api/wallets` and admin routes at
`/api/wallets/admin`. Wallet routes first accept either a valid
`x-gateway-token` (verified by `finvault-internal-auth`) or an `x-internal-key`
matching `INTERNAL_KEY`. Gateway users are restricted to their own `userId`
unless their role is `ADMIN`. The hold, capture, release, transfer, credit, and
debit routes additionally require an internal call or `ADMIN`; balance and
history allow the owner, `ADMIN`, or an internal call. Admin routes require a
Gateway token with the `ADMIN` role and do not accept the internal-key path.

**M23 access target:** end users should have only `GET balance` and `GET
history`; money-changing operations must be internal or `ADMIN`. Those money
routes already enforce that policy. `POST /api/wallets` currently allows an
authenticated owner or `ADMIN` (or an internal call) to create a wallet; making
creation internal/`ADMIN`-only remains **đang chờ K9**. This README records the
target without changing wallet routes.

| Route | Purpose |
| --- | --- |
| Route | Purpose | Access |
| --- | --- | --- |
| `POST /api/wallets` | Create a USER or MERCHANT wallet idempotently by `userId` | Current: owner, `ADMIN`, or internal; target: `ADMIN`/internal (đang chờ K9) |
| `GET /api/wallets/:userId/balance` | Read balance, held balance and available balance | Owner, `ADMIN`, or internal |
| `POST /api/wallets/:userId/hold` | Reserve funds; body includes `amount`, `referenceId`, `expiresAt`, and `destinationUserId` | Internal or `ADMIN` |
| `POST /api/wallets/:userId/capture` | Convert a hold to a PAYMENT ledger transfer | Internal or `ADMIN` |
| `POST /api/wallets/:userId/release` | Release a pending hold | Internal or `ADMIN` |
| `POST /api/wallets/:userId/transfer` | P2P transfer using `toUserId`, `amount`, and `referenceId` | Internal or `ADMIN` |
| `POST /api/wallets/:userId/credit` | Credit from the clearing wallet | Internal or `ADMIN` |
| `POST /api/wallets/:userId/debit` | Debit to the clearing wallet | Internal or `ADMIN` |
| `GET /api/wallets/:userId/history` | Ledger history | Owner, `ADMIN`, or internal |
| `POST /api/wallets/admin/:userId/lock`, `/unlock` | Lock/unlock new money operations | Gateway `ADMIN` |
| `POST /api/wallets/admin/:userId/adjust` | Credit/debit adjustment | Gateway `ADMIN` |
| `GET /api/wallets/admin` | List/search wallets | Gateway `ADMIN` |
| `GET /api/wallets/admin/reconciliation` | Report ledger/balance mismatches | Gateway `ADMIN` |

Set `?ownerType=MERCHANT` on single-wallet operations when addressing a merchant
wallet.  All money amounts are decimal strings with no more than two places.

## Accounting and delivery guarantees

- PostgreSQL checks prevent negative balances and prevent held balance exceeding
  total balance.
- `moveMoney` is the only balance mutation path. It obtains `FOR UPDATE` locks
  in ascending wallet-ID order, writes two opposite ledger entries with one UUID,
  and runs at serializable isolation.
- A `referenceId` is the idempotency key for every money side effect. Replays
  return the original result; a different request using the same reference fails.
- Ledger rows are append-only: a database trigger rejects `UPDATE` and `DELETE`.
- Expired holds are released by the scheduled worker. Capture/release of an
  already-resolved hold is safe and never double-adjusts held balance.
- Notification events are written to `WalletOutboxEvent` in the same transaction
  as balance mutations. The relay drains after commit and every second as a
  fallback, publishing legacy notification messages through `wallet.events`
  (with HTTP   fallback). Wallet `PAYMENT` messages are suppressed because the payment flow
  emits the canonical `payment.succeeded` event; TOPUP and REFUND messages are
  still delivered from the wallet outbox.

The SYSTEM clearing wallet is created lazily. As specified by the accounting
model, a settlement process must provision clearing liquidity before a TOPUP or
refund can move money out of it; this service will not let that wallet go
negative.

## Migration note

The conversion migration removes the accidental auth-era `User`, `Session`,
`WalletTransaction`, and `WalletIdempotency` tables from the wallet database.
Back up a pre-existing development database before applying it: legacy one-sided
transactions cannot be truthfully converted into the new mandatory paired ledger.
</file>

