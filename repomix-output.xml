<file path="services/utilities-service/src/services/billService.ts">
import { HttpError } from '../utils/errors'

export type BillLookup = {
  provider: string
  customerCode: string
  customerName: string
  amount: string
  period: string
}

const formatVnd = (value: bigint): string =>
  value.toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.')

// Sandbox bill lookup. The amount is derived from the last two digits of the
// customer code, which keeps tests and demos reproducible without randomness.
export function lookupBill(provider: string, customerCode: string): BillLookup {
  if (!/^[A-Za-z0-9._-]{2,64}$/.test(customerCode)) {
    throw new HttpError(400, 'INVALID_CUSTOMER_CODE', 'Mã khách hàng không hợp lệ.')
  }
  if (!/^[A-Za-z0-9._-]{2,32}$/.test(provider)) {
    throw new HttpError(400, 'INVALID_PROVIDER', 'Mã nhà cung cấp không hợp lệ.')
  }

  const tail = customerCode.slice(-2)
  if (!/^\d{2}$/.test(tail)) {
    throw new HttpError(400, 'INVALID_CUSTOMER_CODE', 'Mã khách hàng phải kết thúc bằng 2 chữ số.')
  }
  if (tail === '11') {
    throw new HttpError(422, 'BILL_NOT_FOUND', 'Nhà cung cấp không tìm thấy hóa đơn.')
  }
  if (tail === '22') {
    throw new HttpError(504, 'PROVIDER_TIMEOUT', 'Nhà cung cấp không phản hồi.')
  }

  const amount = BigInt(Number(tail) * 1000 + 10000)
  return {
    provider,
    customerCode,
    customerName: `Khách hàng ${customerCode.slice(-4)}`,
    amount: amount.toString(),
    period: '2026-10'
  }
}

export const formatBillAmount = (value: string | bigint): string => formatVnd(BigInt(value))
</file>

<file path="services/utilities-service/src/services/fulfillmentService.ts">
import { UtilityOrder } from '@prisma/client'
import { prisma } from '../config/prisma'
import type { PaymentClient, ProviderClient, ProviderOutcome } from '../types/utility'
import { PaymentClientError } from './paymentClient'
import { transitionOrder } from './orderService'

export const MAX_REFUND_ATTEMPTS = 5

export async function executeRefund(
  order: Pick<UtilityOrder, 'id' | 'paymentId'>,
  paymentClient: PaymentClient
): Promise<void> {
  if (!order.paymentId) return
  try {
    const status = await paymentClient.requestRefund(order.paymentId)
    if (status === 'REFUNDED') {
      await transitionOrder(order.id, ['REFUND_REQUESTED'], 'REFUNDED', 'REFUND_CONFIRMED')
    }
    // REFUNDING and UNKNOWN stay REFUND_REQUESTED: never guess a money outcome.
  } catch (error) {
    if (error instanceof PaymentClientError && error.definite) {
      const code = error.upstreamCode ?? 'REFUND_REJECTED'
      await transitionOrder(
        order.id,
        ['REFUND_REQUESTED'],
        'REFUND_FAILED',
        `REFUND_REJECTED:${code}`,
        { failureReason: code }
      )
    }
    // 5xx/timeout: keep REFUND_REQUESTED for a bounded retry.
  }
}

export async function startRefund(
  orderId: string,
  reason: string,
  paymentClient: PaymentClient
): Promise<void> {
  const order = await prisma.$transaction(async tx => {
    const current = await tx.utilityOrder.findUnique({ where: { id: orderId } })
    if (!current) return null
    if (current.status !== 'PAID' && current.status !== 'PROVIDER_PENDING') return null
    const updated = await tx.utilityOrder.update({
      where: { id: current.id },
      data: {
        status: 'REFUND_REQUESTED',
        failureReason: reason,
        refundAttempts: { increment: 1 }
      }
    })
    await tx.utilityOrderHistory.create({
      data: {
        orderId: current.id,
        fromStatus: current.status,
        toStatus: 'REFUND_REQUESTED',
        note: reason
      }
    })
    return updated
  })
  if (order) await executeRefund(order, paymentClient)
}

export async function retryRefund(orderId: string, paymentClient: PaymentClient): Promise<void> {
  const order = await prisma.$transaction(async tx => {
    const current = await tx.utilityOrder.findUnique({ where: { id: orderId } })
    if (!current || current.status !== 'REFUND_REQUESTED') return null
    if (current.refundAttempts >= MAX_REFUND_ATTEMPTS) return null
    return tx.utilityOrder.update({
      where: { id: current.id },
      data: { refundAttempts: { increment: 1 } }
    })
  })
  if (order) await executeRefund(order, paymentClient)
}

export async function settleProviderOutcome(
  order: UtilityOrder,
  outcome: ProviderOutcome,
  paymentClient: PaymentClient
): Promise<void> {
  if (outcome.status === 'SUCCESS') {
    await transitionOrder(
      order.id,
      ['PROVIDER_PENDING'],
      'SUCCESS',
      'PROVIDER_SUCCEEDED',
      { providerRef: outcome.providerRef }
    )
    return
  }
  if (outcome.status === 'FAILED') {
    await startRefund(order.id, `PROVIDER_FAILED:${outcome.reason}`, paymentClient)
  }
  // TIMEOUT: keep PROVIDER_PENDING. Money may have moved, so refunding here
  // would be wrong (D10).
}

export async function fulfillPaidOrder(
  orderId: string,
  providerClient: ProviderClient,
  paymentClient: PaymentClient
): Promise<void> {
  const claimed = await transitionOrder(orderId, ['PAID'], 'PROVIDER_PENDING', 'PROVIDER_REQUESTED')
  if (!claimed) return

  const order = await prisma.utilityOrder.findUnique({ where: { id: orderId } })
  if (!order) return

  let outcome: ProviderOutcome
  try {
    outcome =
      order.type === 'TELCO_TOPUP'
        ? await providerClient.topup({
            orderId: order.id,
            phone: order.target,
            amount: order.amount.toFixed(0)
          })
        : await providerClient.payBill({
            orderId: order.id,
            providerCode: order.providerCode ?? 'UNKNOWN',
            customerCode: order.target,
            amount: order.amount.toFixed(0)
          })
  } catch {
    outcome = { status: 'TIMEOUT' }
  }
  await settleProviderOutcome(order, outcome, paymentClient)
}
</file>

<file path="services/utilities-service/src/services/mockProviderEngine.ts">
import type { ProviderOutcome } from '../types/utility'

type MockRecord = {
  outcome: ProviderOutcome
  queried: boolean
  delivered: boolean
}

// Deterministic sandbox provider. Every order is decided from the last two
// digits of the phone/customer code: 11 = rejected, 22 = timeout on the first
// attempt, everything else = success. Results are stored per orderId so a
// duplicate callback never creates a second top-up.
export class MockProviderEngine {
  private readonly records = new Map<string, MockRecord>()

  private static scenario(key: string): 'REJECT' | 'TIMEOUT' | 'SUCCESS' {
    const tail = key.slice(-2)
    if (tail === '11') return 'REJECT'
    if (tail === '22') return 'TIMEOUT'
    return 'SUCCESS'
  }

  private static initialOutcome(orderId: string, key: string): ProviderOutcome {
    const scenario = MockProviderEngine.scenario(key)
    if (scenario === 'REJECT') return { status: 'FAILED', reason: 'PROVIDER_REJECTED' }
    if (scenario === 'TIMEOUT') return { status: 'TIMEOUT' }
    return { status: 'SUCCESS', providerRef: `MOCK-${orderId}` }
  }

  execute(input: { orderId: string; key: string }): ProviderOutcome {
    const existing = this.records.get(input.orderId)
    if (existing) return existing.outcome
    const record: MockRecord = {
      outcome: MockProviderEngine.initialOutcome(input.orderId, input.key),
      queried: false,
      delivered: true
    }
    this.records.set(input.orderId, record)
    return record.outcome
  }

  query(orderId: string): ProviderOutcome {
    const record = this.records.get(orderId)
    if (!record) return { status: 'TIMEOUT' }
    if (record.outcome.status === 'TIMEOUT' && !record.queried) {
      // The provider accepted the money but the response was lost. The first
      // status query reveals the truth; later queries stay stable.
      record.queried = true
      record.outcome = { status: 'SUCCESS', providerRef: `MOCK-${orderId}` }
    }
    return record.outcome
  }

  // Test-visible counters. They are intentionally not exposed over HTTP.
  deliveredCount(): number {
    let count = 0
    for (const record of this.records.values()) if (record.delivered) count += 1
    return count
  }

  record(orderId: string): MockRecord | undefined {
    return this.records.get(orderId)
  }
}
</file>

<file path="services/utilities-service/src/services/orderService.ts">
import { createHash } from 'node:crypto'
import { Prisma, UtilityOrder, UtilityOrderStatus, UtilityType } from '@prisma/client'
import { prisma } from '../config/prisma'
import { HttpError, isUniqueConstraintError } from '../utils/errors'
import { discountFor } from '../utils/money'
import type { PaymentClient } from '../types/utility'
import { PaymentClientError } from './paymentClient'

const tails = new Map<string, Promise<void>>()

// Serialises creation/replay per (user, idempotency key) inside one process.
// Multi-instance safety still comes from the database unique constraint and
// payment-service's own idempotency key.
async function withKeyLock<T>(key: string, operation: () => Promise<T>): Promise<T> {
  const previous = tails.get(key) ?? Promise.resolve()
  let release!: () => void
  const gate = new Promise<void>(resolve => {
    release = resolve
  })
  const tail = previous.then(() => gate)
  tails.set(key, tail)
  await previous
  try {
    return await operation()
  } finally {
    release()
    if (tails.get(key) === tail) tails.delete(key)
  }
}

export const payloadHashFor = (input: {
  type: UtilityType
  target: string
  amount: string
}): string =>
  createHash('sha256')
    .update(JSON.stringify({ type: input.type, target: input.target, amount: input.amount }))
    .digest('hex')

const history = (
  tx: Prisma.TransactionClient,
  orderId: string,
  fromStatus: UtilityOrderStatus | null,
  toStatus: UtilityOrderStatus,
  note: string
) => tx.utilityOrderHistory.create({ data: { orderId, fromStatus, toStatus, note } })

export async function transitionOrder(
  orderId: string,
  from: UtilityOrderStatus[],
  to: UtilityOrderStatus,
  note: string,
  extra: Prisma.UtilityOrderUpdateManyMutationInput = {}
): Promise<boolean> {
  return prisma.$transaction(async tx => {
    const result = await tx.utilityOrder.updateMany({
      where: { id: orderId, status: { in: from } },
      data: { status: to, ...extra }
    })
    if (result.count === 0) return false
    await history(tx, orderId, from.length === 1 ? from[0] : null, to, note)
    return true
  })
}

export type CreateOrderInput = {
  userId: string
  idempotencyKey: string
  type: UtilityType
  amount: string
  target: string
  providerCode?: string | null
  gatewayToken: string
  requestId?: string
}

export type CreateOrderResult = {
  order: UtilityOrder
  replayed: boolean
}

const paymentTypeFor = (type: UtilityType): 'PHONE_TOPUP' | 'BILL_PAYMENT' =>
  type === 'TELCO_TOPUP' ? 'PHONE_TOPUP' : 'BILL_PAYMENT'

export async function createUtilityOrder(
  input: CreateOrderInput,
  paymentClient: PaymentClient
): Promise<CreateOrderResult> {
  const payloadHash = payloadHashFor(input)
  const lockKey = `${input.userId}:${input.idempotencyKey}`

  return withKeyLock(lockKey, async () => {
    const existing = await prisma.utilityOrder.findUnique({
      where: { userId_idempotencyKey: { userId: input.userId, idempotencyKey: input.idempotencyKey } }
    })

    let order: UtilityOrder
    let replayed: boolean

    if (existing) {
      if (existing.payloadHash !== payloadHash) {
        throw new HttpError(
          422,
          'IDEMPOTENCY_KEY_REUSED_WITH_DIFFERENT_PAYLOAD',
          'Idempotency-Key đã được dùng cho một yêu cầu khác.'
        )
      }
      order = existing
      replayed = true
    } else {
      try {
        order = await prisma.$transaction(async tx => {
          const created = await tx.utilityOrder.create({
            data: {
              userId: input.userId,
              type: input.type,
              status: 'PENDING_PAYMENT',
              amount: new Prisma.Decimal(input.amount),
              discountAmount: new Prisma.Decimal(discountFor(input.amount).toString()),
              target: input.target,
              providerCode: input.providerCode ?? null,
              idempotencyKey: input.idempotencyKey,
              payloadHash
            }
          })
          await history(tx, created.id, null, 'PENDING_PAYMENT', 'ORDER_CREATED')
          return created
        })
        replayed = false
      } catch (error) {
        if (!isUniqueConstraintError(error)) throw error
        const raced = await prisma.utilityOrder.findUnique({
          where: {
            userId_idempotencyKey: { userId: input.userId, idempotencyKey: input.idempotencyKey }
          }
        })
        if (!raced || raced.payloadHash !== payloadHash) {
          throw new HttpError(
            422,
            'IDEMPOTENCY_KEY_REUSED_WITH_DIFFERENT_PAYLOAD',
            'Idempotency-Key đã được dùng cho một yêu cầu khác.'
          )
        }
        order = raced
        replayed = true
      }
    }

    if (order.paymentId !== null || order.status !== 'PENDING_PAYMENT') {
      return { order, replayed }
    }

    // D8: no database transaction is held while calling payment-service.
    try {
      const payment = await paymentClient.checkout(
        {
          amount: input.amount,
          type: paymentTypeFor(input.type),
          referenceId: order.id,
          idempotencyKey: `util-${order.id}`
        },
        input.gatewayToken,
        input.requestId
      )
      const updated = await prisma.$transaction(async tx => {
        const changed = await tx.utilityOrder.findUnique({ where: { id: order.id } })
        if (!changed) throw new HttpError(404, 'NOT_FOUND', 'Không tìm thấy đơn.')
        const saved = await tx.utilityOrder.update({
          where: { id: order.id },
          data: { paymentId: payment.paymentId }
        })
        await history(tx, order.id, 'PENDING_PAYMENT', 'PENDING_PAYMENT', 'PAYMENT_CREATED')
        return saved
      })
      return { order: updated, replayed }
    } catch (error) {
      if (error instanceof PaymentClientError && error.definite) {
        const code = error.upstreamCode ?? 'PAYMENT_REJECTED'
        await transitionOrder(
          order.id,
          ['PENDING_PAYMENT'],
          'FAILED',
          `PAYMENT_REJECTED:${code}`,
          { failureReason: code }
        )
        throw new HttpError(error.status ?? 400, code, 'Thanh toán bị từ chối.')
      }
      // Unknown outcome: keep PENDING_PAYMENT. A retry with the same
      // idempotency key resumes this order instead of creating another.
      throw new HttpError(502, 'UPSTREAM_UNAVAILABLE', 'Không kết nối được payment-service.')
    }
  })
}

export async function findOrderForUser(orderId: string, userId: string): Promise<UtilityOrder> {
  const order = await prisma.utilityOrder.findFirst({ where: { id: orderId, userId } })
  if (!order) throw new HttpError(404, 'NOT_FOUND', 'Không tìm thấy đơn.')
  return order
}
</file>

<file path="services/utilities-service/src/services/providerClient.ts">
import { env } from '../config/env'
import type { ProviderClient, ProviderOutcome } from '../types/utility'

const outcomeFromPayload = (status: number, payload: any): ProviderOutcome => {
  if (status === 504) return { status: 'TIMEOUT' }
  if (status >= 200 && status < 300) {
    const value = payload?.data?.status
    if (value === 'SUCCESS' && typeof payload.data.providerRef === 'string') {
      return { status: 'SUCCESS', providerRef: payload.data.providerRef }
    }
    if (value === 'TIMEOUT') return { status: 'TIMEOUT' }
    if (value === 'FAILED') {
      return {
        status: 'FAILED',
        reason: typeof payload.data.reason === 'string' ? payload.data.reason : 'PROVIDER_REJECTED'
      }
    }
    return { status: 'TIMEOUT' }
  }
  if (status >= 400 && status < 500) {
    return {
      status: 'FAILED',
      reason: typeof payload?.error?.code === 'string' ? payload.error.code : 'PROVIDER_REJECTED'
    }
  }
  return { status: 'TIMEOUT' }
}

export class HttpProviderClient implements ProviderClient {
  constructor(
    private readonly baseUrl: string = env.providerBaseUrl,
    private readonly internalKey: string = env.internalKey,
    private readonly timeoutMs: number = env.providerTimeoutMs
  ) {}

  private async request(path: string, init: RequestInit): Promise<ProviderOutcome> {
    try {
      const response = await fetch(`${this.baseUrl}${path}`, {
        ...init,
        headers: {
          'Content-Type': 'application/json',
          'x-internal-key': this.internalKey,
          ...init.headers
        },
        signal: AbortSignal.timeout(this.timeoutMs)
      })
      let payload: any
      try {
        payload = await response.json()
      } catch {
        payload = undefined
      }
      return outcomeFromPayload(response.status, payload)
    } catch {
      // Network errors and client-side aborts share the same business meaning:
      // money may have moved, but the result is unknown.
      return { status: 'TIMEOUT' }
    }
  }

  topup(input: { orderId: string; phone: string; amount: string }): Promise<ProviderOutcome> {
    return this.request('/internal/mock-provider/topup', {
      method: 'POST',
      body: JSON.stringify(input)
    })
  }

  payBill(input: {
    orderId: string
    providerCode: string
    customerCode: string
    amount: string
  }): Promise<ProviderOutcome> {
    return this.request('/internal/mock-provider/topup', {
      method: 'POST',
      body: JSON.stringify({
        orderId: input.orderId,
        phone: input.customerCode,
        amount: input.amount
      })
    })
  }

  getStatus(orderId: string): Promise<ProviderOutcome> {
    return this.request(`/internal/mock-provider/orders/${encodeURIComponent(orderId)}`, {
      method: 'GET'
    })
  }
}
