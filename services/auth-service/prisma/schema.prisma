generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  firstName String
  lastName  String
  email     String   @unique
  password  String
  role      Role     @default(USER)   
  createdAt DateTime @default(now())
  sessions  Session[]
  pin       UserPin?
}

model Session {
  id           String   @id @default(uuid())
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserPin {
  id             String    @id @default(uuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pinHash        String
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
}

model AuthOutboxEvent {
  id          String       @id @default(uuid())
  aggregateId String       // ID của thực thể gốc (userId)
  eventType   String       // Loại sự kiện (ví dụ: 'user.registered')
  payload     Json         // Dữ liệu sự kiện { userId, email, username, firstName, lastName }
  status      OutboxStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  publishedAt DateTime?    // Thời điểm bắn lên RabbitMQ thành công
  attempts    Int          @default(0) // Số lần thử phát lại nếu gặp sự cố

  nextAttemptAt DateTime @default(now())
  lockedUntil DateTime?
  lockToken String?

  @@index([status, createdAt])
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum Role {
  USER
  ADMIN
}
