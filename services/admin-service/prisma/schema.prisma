generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminAuditLog {
  id         String   @id @default(uuid())
  adminId    String                 // userId của admin thực hiện hành động
  action     String                 // ví dụ: "APPROVE_KYC", "REJECT_MERCHANT"
  targetId   String                 // id của user/merchant bị tác động
  detail     String?                // ghi chú thêm nếu có
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([targetId])
}
