  /**
   * Phê duyệt hoặc từ chối hồ sơ KYC
   * Bước 1: Đổi trạng thái trên user-service
   * Bước 2: Ghi vết kiểm toán AdminAuditLog (Kiểm tra nghiêm ngặt, không nuốt lỗi)
   */
  static async reviewKyc(
    userId: string,
    dto: KycReviewDto,
    adminId: string,
    requestId: string
  ) {
    const { status, detail } = dto
    const targetUrl = `${env.userServiceUrl}/api/users/${userId}/kyc-status`

    // BƯỚC 1: Gọi sang user-service để cập nhật trạng thái thực tế
    let updateResult: any = null
    try {
      const res = await fetch(targetUrl, {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json',
          'x-request-id': requestId,             // Truyền Correlation ID
          'x-internal-key': env.internalKey,      // Khóa dịch vụ nội bộ
          'x-user-role': 'ADMIN'
        },
        body: JSON.stringify({ kycStatus: status }),
        signal: AbortSignal.timeout(2000)        // Timeout 2s
      })

      if (!res.ok) {
        const errorBody = await res.text()
        throw new Error(`user-service trả lỗi HTTP ${res.status}: ${errorBody}`)
      }

      const json = await res.json()
      updateResult = json.data
    } catch (err: any) {
      if (env.isProduction) {
        console.error(`[KYC REVIEW FAILED] Không thể cập nhật KYC tại user-service:`, err.message)
        throw new Error(`Thao tác đổi trạng thái KYC thất bại do không kết nối được user-service: ${err.message}`)
      }

      console.warn(
        `[MOCK FALLBACK] user-service (${targetUrl}) không phản hồi. Giả lập kết quả duyệt thành công ở môi trường DEV!`
      )
      updateResult = {
        id: userId,
        kycStatus: status,
        updatedAt: new Date().toISOString()
      }
    }

    // BƯỚC 2: Ghi vào AdminAuditLog
    const actionName = status === 'APPROVED' ? 'APPROVE_KYC' : 'REJECT_KYC'
    const auditResult = await AuditService.logAction({
      adminId,
      action: actionName,
      targetId: userId,
      detail: detail || (status === 'APPROVED' ? 'Duyệt hồ sơ hợp lệ' : 'Từ chối hồ sơ')
    })

    // XỬ LÝ LỖI DUAL-WRITE: Nếu bước 2 thất bại (DB admin_service down)
    if (!auditResult.success) {
      console.error(
        `[CRITICAL AUDIT ALERT] Trạng thái KYC của user ${userId} đã đổi thành ${status}, nhưng KHÔNG THỂ ghi log kiểm toán vào database admin_service!`,
        { adminId, userId, action: actionName, error: auditResult.error }
      )

      return {
        success: true,
        data: updateResult,
        warning: 'AUDIT_LOG_FAILED',
        message: `Đã cập nhật trạng thái KYC thành ${status}, NHƯNG xảy ra lỗi không thể lưu nhật ký kiểm toán vào database. Vui lòng kiểm tra lại dịch vụ cơ sở dữ liệu admin!`
      }
    }

    return {
      success: true,
      data: updateResult,
      auditLog: auditResult.data,
      message: `Cập nhật trạng thái KYC của người dùng thành ${status} và đã lưu vết kiểm toán thành công`
    }
  }
}
