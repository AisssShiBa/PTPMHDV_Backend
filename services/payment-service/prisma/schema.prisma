generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentType {
  CARD_TOPUP
  BUS_TICKET
  MOVIE_TICKET
  TRAIN_TICKET
  WALLET_TRANSFER
  PHONE_TOPUP
  BILL_PAYMENT
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REFUNDED
  REFUNDING
  REFUND_FAILED
  CANCELLED
  EXPIRED
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model Payment {
  id                   String             @id @default(uuid()) @db.Uuid
  userId               String             @db.VarChar(50)
  workflow             String             @default("IDLE")
  amount               Decimal            @db.Decimal(20, 2)
  type                 PaymentType
  referenceId          String             @db.VarChar(255)
  destinationUserId    String?            @db.VarChar(50)
  destinationOwnerType String?            @default("USER") @db.VarChar(20)
  callbackTopic        String             @db.VarChar(100)
  idempotencyKey       String             @db.VarChar(255)
  requestHash          String             @db.VarChar(255)
  idempotencyStatus    IdempotencyStatus  @default(PROCESSING)
  idempotencyExpiresAt DateTime           @db.Timestamp(3)
  status         PaymentStatus    @default(PENDING)
  failureReason        String?            @db.Text
  failureCode          String?            @db.VarChar(50)
  refundAttempts       Int                @default(0)
  nextRefundAttemptAt  DateTime?          @db.Timestamp(3)
  refundRequestedAt    DateTime?          @db.Timestamp(3)
  refundedAt           DateTime?          @db.Timestamp(3)
  needsAttention       Boolean            @default(false)
  holdId               String?            @db.VarChar(255)
  holdExpiresAt  DateTime?        @db.Timestamp()
  workerLeaseUntil     DateTime?          @db.Timestamp(3)
  attempt              Int                @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  histories      PaymentHistory[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([status, nextRefundAttemptAt])
  @@index([workflow, workerLeaseUntil])
  @@unique([userId, idempotencyKey])
  @@index([idempotencyExpiresAt])
}

model PaymentHistory {
  id         String         @id @default(uuid()) @db.Uuid
  paymentId  String         @db.Uuid
  fromStatus PaymentStatus?
  toStatus   PaymentStatus
  note       String?        @db.Text
  changedAt  DateTime       @default(now())
  payment    Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

model OutboxEvent {
  id          String            @id @default(uuid()) @db.Uuid
  aggregateId String            @db.VarChar(255)
  eventType   String            @db.VarChar(100)
  topic       String            @db.VarChar(100)
  payload     Json
  status      OutboxEventStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  sentAt      DateTime?         @db.Timestamp()
  retryCount  Int               @default(0)
  nextRetryAt DateTime?         @db.Timestamp()
  lockedUntil DateTime?         @db.Timestamp(3)
  lockToken   String?           @db.Uuid

  @@index([status, nextRetryAt, lockedUntil])
  @@index([status, createdAt])
  @@index([nextRetryAt])
}

enum TopupStatus {
  PENDING
  PROCESSING
  APPROVED
  REJECTED
  EXPIRED
  FAILED
}

model TopupRequest {
  id                  String       @id @default(uuid()) @db.Uuid
  userId              String       @db.VarChar(50)
  amount              Decimal      @db.Decimal(20, 2)
  code                String       @unique @db.VarChar(50)
  status              TopupStatus  @default(PENDING)
  expiresAt           DateTime     @db.Timestamp()
  approvedBy          String?      @db.VarChar(50)
  approvedAt          DateTime?    @db.Timestamp()
  rejectReason        String?      @db.Text
  walletTransactionId String?      @db.Uuid
  vnpTransactionNo    String?      @db.VarChar(50)
  vnpBankCode         String?      @db.VarChar(20)
  vnpPayDate          String?      @db.VarChar(20)
  vnpResponseCode     String?      @db.VarChar(10)
  paymentUrl          String?      @db.Text
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  auditLogs           TopupAuditLog[]

  @@index([userId])
  @@index([status])
}

model TopupAuditLog {
  id              String       @id @default(uuid()) @db.Uuid
  topupRequestId  String       @db.Uuid
  actorId         String       @db.VarChar(50)
  action          String       @db.VarChar(100)
  fromStatus      TopupStatus?
  toStatus        TopupStatus
  reason          String?      @db.Text
  createdAt       DateTime     @default(now())

  topupRequest    TopupRequest @relation(fields: [topupRequestId], references: [id], onDelete: Cascade)

  @@index([topupRequestId])
}

model UsedTransactionToken {
  jti       String   @id @db.VarChar(100)
  paymentId String   @db.Uuid
  userId    String   @db.VarChar(50)
  usedAt    DateTime @default(now()) @db.Timestamp()

  @@index([usedAt])
  @@index([paymentId])
}

enum CashOutStatus {
  REQUESTED
  HOLDING
  PAYOUT_PENDING
  SUCCEEDED
  FAILED
}

// workflow is the crash-safe step marker, status is the money-visible state.
// workflow: IDLE | HOLDING | PAYOUT | CAPTURING | RELEASING
model CashOut {
  id                  String        @id @default(uuid()) @db.Uuid
  userId              String        @db.VarChar(50)
  amount              Decimal       @db.Decimal(20, 2)
  destination         String?       @db.VarChar(255)
  idempotencyKey      String        @db.VarChar(255)
  requestHash         String        @db.VarChar(64)
  status              CashOutStatus @default(REQUESTED)
  workflow            String        @default("IDLE") @db.VarChar(20)
  tokenJti            String?       @unique @db.VarChar(100)
  holdRef             String        @unique @db.VarChar(255)
  providerRef         String?       @unique @db.VarChar(255)
  walletTransactionId String?       @db.Uuid
  failureReason       String?       @db.Text
  nextRetryAt         DateTime?     @db.Timestamp(3)
  retryCount          Int           @default(0)
  leaseToken          String?       @db.Uuid
  leaseUntil          DateTime?     @db.Timestamp(3)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  logs                CashOutStatusLog[]

  @@unique([userId, idempotencyKey])
  @@index([status, nextRetryAt])
  @@index([userId, createdAt])
}

model CashOutStatusLog {
  id         String         @id @default(uuid()) @db.Uuid
  cashOutId  String         @db.Uuid
  fromStatus CashOutStatus?
  toStatus   CashOutStatus
  note       String?        @db.Text
  changedAt  DateTime       @default(now())
  cashOut    CashOut        @relation(fields: [cashOutId], references: [id], onDelete: Cascade)

  @@index([cashOutId])
}

enum MockPayoutResult {
  PENDING
  SUCCESS
  FAILED
}

// Durable stand-in for the Payout Bank. Keyed by providerRef so a retried
// payout can never move money twice and a timeout can be resolved by query.
model MockPayout {
  providerRef     String           @id @db.VarChar(255)
  amount          Decimal          @db.Decimal(20, 2)
  result          MockPayoutResult @default(PENDING)
  timeoutResponse Boolean          @default(false)
  bankTransactionId String?        @db.VarChar(100)
  failureCode     String?          @db.VarChar(50)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([result])
}
