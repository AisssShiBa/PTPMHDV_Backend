PORT=3008
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/utilities_service
# Required; may be supplied through INTERNAL_KEY_FILE.
INTERNAL_KEY=
# Required with NODE_ENV=production; only the Gateway holds the private key.
# GATEWAY_PUBLIC_KEY_FILE=/run/secrets/gateway_public_key
RABBITMQ_URL=amqp://guest:guest@localhost:5672
PAYMENT_SERVICE_URL=http://localhost:3005
# Sandbox only. Never enable fake top-ups with real money.
MOCK_PROVIDER_ENABLED=false
PROVIDER_BASE_URL=http://localhost:3008
PROVIDER_TIMEOUT_MS=10000
RECOVERY_ENABLED=true
RECOVERY_INTERVAL_MS=30000
RECOVERY_STALE_MS=60000
