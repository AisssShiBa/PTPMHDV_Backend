  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "success",
          "error",
          "requestId"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          },
          "requestId": {
            "type": "string"
          }
        }
      },
      "Profile": {
        "type": "object",
        "required": [
          "id",
          "authUserId",
          "email",
          "fullName",
          "phone",
          "address",
          "kycStatus",
          "kycTier",
          "idNumber",
          "kycMimeType",
          "kycFileSize",
          "version",
          "createdAt",
          "updatedAt",
          "deletedAt",
          "hasKycDocument"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "authUserId": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "fullName": {
            "type": "string",
            "nullable": true
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "address": {
            "type": "string",
            "nullable": true
          },
          "kycStatus": {
            "type": "string",
            "enum": [
              "NONE",
              "PENDING",
              "APPROVED",
              "REJECTED"
            ]
          },
          "kycTier": {
            "type": "integer",
            "enum": [
              0,
              1,
              2
            ],
            "default": 0,
            "description": "Independent of KYC status; not writable through profile/upload APIs."
          },
          "idNumber": {
            "type": "string",
            "nullable": true
          },
          "kycMimeType": {
            "type": "string",
            "nullable": true
          },
          "kycFileSize": {
            "type": "integer",
            "nullable": true
          },
          "version": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "deletedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "hasKycDocument": {
            "type": "boolean"
          }
        }
      },
      "ProfileResponse": {
        "type": "object",
        "required": [
          "success",
          "data",
          "message"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "data": {
            "$ref": "#/components/schemas/Profile"
          },
          "message": {
            "type": "string",
            "example": "Success"
          }
        }
      },
      "Kyc": {
        "type": "object",
        "required": [
          "kycStatus",
          "kycTier",
          "hasKycDocument"
        ],
        "properties": {
          "kycStatus": {
            "type": "string",
            "enum": [
              "NONE",
              "PENDING",
              "APPROVED",
              "REJECTED"
            ]
          },
          "kycTier": {
            "type": "integer",
            "enum": [
              0,
              1,
              2
            ],
            "default": 0,
            "description": "Independent of KYC status; not writable through profile/upload APIs."
          },
          "hasKycDocument": {
            "type": "boolean"
          }
        }
      },
      "KycResponse": {
        "type": "object",
        "required": [
          "success",
          "data",
          "message"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "data": {
            "$ref": "#/components/schemas/Kyc"
          },
          "message": {
            "type": "string",
            "example": "Success"
          }
        }
      }
    }
  }
}
