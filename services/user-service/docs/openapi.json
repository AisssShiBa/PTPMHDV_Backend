    "/users/by-auth/{authUserId}/kyc/document": {
      "get": {
        "operationId": "getKycDocumentUrl",
        "summary": "Get an authorized, short-lived KYC document URL",
        "description": "Owner USER only through Gateway. ADMIN must use /admin/kyc/{userId}/documents so each view is audited. Returns the front image URL with the configured TTL (default 300 seconds).",
        "parameters": [
          {
            "name": "authUserId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "URL expires after KYC_URL_TTL_SECONDS (default 300); Cache-Control: no-store",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "message"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "url",
                        "expiresIn"
                      ],
                      "properties": {
                        "url": {
                          "type": "string",
                          "format": "uri"
                        },
                        "expiresIn": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 3600,
                          "example": 300
                        }
                      }
                    },
                    "message": {
                      "type": "string",
                      "example": "Success"
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "url": "http://localhost:19000/finvault-kyc/kyc/example.jpg?signature=example",
                    "expiresIn": 300
                  },
                  "message": "Success"
                }
              }
            }
          },
          "400": {
