{
  "openapi": "3.0.3",
  "info": {
    "title": "FinVault User API",
    "version": "1.0.0",
    "description": "Client API through Gateway. Frontend sends Bearer access tokens; Gateway signs ES256 x-gateway-token (60s). Services verify finvault-internal-auth claims. Internal authentication headers are never client inputs."
  },
  "servers": [
    {
      "url": "http://localhost:3000/api",
      "description": "Local Gateway"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/users/me": {
      "get": {
        "operationId": "getCurrentUser",
        "summary": "Get the signed-in user's profile",
        "description": "Resolves the signed Auth ID, not a body/query/header owner ID. Missing or deleted profile returns 404.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponse"
                },
                "example": {
                  "success": true,
                  "data": {
                    "id": "20000000-0000-4000-8000-000000000001",
                    "authUserId": "10000000-0000-4000-8000-000000000001",
                    "email": "user@example.com",
                    "fullName": null,
                    "phone": null,
                    "address": null,
                    "kycStatus": "NONE",
                    "kycTier": 0,
                    "idNumber": null,
                    "kycMimeType": null,
                    "kycFileSize": null,
                    "version": 0,
                    "createdAt": "2026-10-07T08:00:00.000Z",
                    "updatedAt": "2026-10-07T08:00:00.000Z",
                    "deletedAt": null,
                    "hasKycDocument": false
                  },
                  "message": "Success"
                }
              }
            }
          },
          "400": {
            "description": "Validation failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "VALIDATION_ERROR",
                    "message": "Request could not be completed"
                  },
                  "requestId": "demo-request"
                }
              }
            }
          },
          "401": {
            "description": "Missing/invalid access token at Gateway, or missing/invalid Gateway Token at service (INVALID_GATEWAY_TOKEN).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "UNAUTHORIZED",
                    "message": "Request could not be completed"
                  },
                  "requestId": "demo-request"
                }
              }
            }
          },
          "403": {
            "description": "Authenticated caller lacks owner/admin permission.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "FORBIDDEN",
                    "message": "Request could not be completed"
                  },
                  "requestId": "demo-request"
                }
              }
            }
          },
          "404": {
            "description": "Profile not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "NOT_FOUND",
                    "message": "Request could not be completed"
                  },
                  "requestId": "demo-request"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server/database error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "INTERNAL_SERVER_ERROR",
                    "message": "Request could not be completed"
                  },
                  "requestId": "demo-request"
                }
              }
            }
          }
        }
      }
    },
