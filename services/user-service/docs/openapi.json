      "post": {
        "operationId": "submitCurrentUserKyc",
        "summary": "Submit both KYC images",
        "description": "Requires front, back and idNumber. Each JPEG/PNG is limited to 5 MiB and normalized to a private JPEG. Both references and PENDING status commit together. APPROVED profiles must be rejected before resubmission. All upload aliases enforce two faces and return 202; legacy document is accepted as an alias for front, with back still required.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "idNumber",
                  "front",
                  "back"
                ],
                "additionalProperties": false,
                "properties": {
                  "idNumber": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50
                  },
                  "front": {
                    "type": "string",
                    "format": "binary",
                    "description": "One JPEG/PNG image, maximum 5 MiB."
                  },
                  "back": {
                    "type": "string",
                    "format": "binary",
                    "description": "One JPEG/PNG image, maximum 5 MiB."
                  }
                }
              },
              "encoding": {
                "front": {
                  "contentType": "image/jpeg, image/png"
                },
                "back": {
                  "contentType": "image/jpeg, image/png"
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Both documents saved; review is PENDING",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponse"
                },
                "example": {
                  "success": true,
                  "data": {
                    "id": "20000000-0000-4000-8000-000000000001",
                    "authUserId": "10000000-0000-4000-8000-000000000001",
                    "email": "user@example.com",
                    "fullName": null,
                    "phone": null,
                    "address": null,
                    "kycStatus": "PENDING",
                    "kycTier": 0,
                    "idNumber": "123456",
                    "kycMimeType": "image/jpeg",
                    "kycFileSize": 1024,
                    "version": 1,
                    "createdAt": "2026-10-07T08:00:00.000Z",
                    "updatedAt": "2026-10-07T08:00:00.000Z",
                    "deletedAt": null,
                    "hasKycDocument": true
                  },
                  "message": "Success"
