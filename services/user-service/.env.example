PORT=3002
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/user_service
INTERNAL_KEY=f6f2f278e1bddbc7d16c19851cc828ce455015504709b35d232383543d6c1e68
CLIENT_URL=http://localhost:5173
# Optional: start the event worker when a broker is available.
# RABBITMQ_URL=amqp://guest:guest@localhost:5672
EVENT_EXCHANGE=finvault.events
EVENT_MAX_RETRIES=5
EVENT_RETRY_MS=2000
# Private S3/MinIO bucket; configure credentials before uploading KYC.
# S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
# S3_BUCKET=finvault-kyc
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Required with NODE_ENV=production; only the Gateway holds the private key.
# GATEWAY_PUBLIC_KEY_FILE=/run/secrets/gateway_public_key

# Host reachable by the browser when storage uses a Docker-internal hostname.
# S3_PUBLIC_ENDPOINT=http://localhost:19002
KYC_CLEANUP_GRACE_MS=86400000
STORAGE_CLEANUP_ENABLED=true
