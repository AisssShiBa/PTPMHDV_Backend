PORT=3003
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/merchant_service
INTERNAL_KEY=
CLIENT_URL=http://localhost:5173
# Optional: start the event worker when a broker is available.
# RABBITMQ_URL=amqp://guest:guest@localhost:5672
EVENT_EXCHANGE=finvault.events
EVENT_MAX_RETRIES=5
EVENT_RETRY_MS=2000
OUTBOX_POLL_MS=1000

# Required with NODE_ENV=production; only the Gateway holds the private key.
# GATEWAY_PUBLIC_KEY_FILE=/run/secrets/gateway_public_key
