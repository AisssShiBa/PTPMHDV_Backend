generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum NotificationType {
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  KYC_APPROVED
  KYC_REJECTED
  MERCHANT_APPROVED
  MERCHANT_REJECTED
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
}
