PORT=3006
# Use a dedicated migrated test database when running npm test; tests write to PostgreSQL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/notification_service
INTERNAL_KEY=
CLIENT_URL=http://localhost:5173
# GATEWAY_PUBLIC_KEY_FILE is optional; finvault-internal-auth defaults to its development stub key.
# SOCKET_MAX_AGE_MS is optional; defaults to 840000 (14 minutes).
